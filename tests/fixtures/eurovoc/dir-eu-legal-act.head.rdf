      <atold:op-code>02</atold:op-code>
      <dc:identifier>02</dc:identifier>
      <at:start.use>1952-07-24</at:start.use>
      <skos:prefLabel xml:lang="bg">Митнически съюз и свободно движение на стоки</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Celní unie a volný pohyb zboží</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Toldunion og frie varebevægelser</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Zollunion und freier Warenverkehr</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Τελωνειακή ένωση και ελεύθερη κυκλοφορία των εμπορευμάτων</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Customs Union and free movement of goods</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Tolliliit ja kaupade vaba liikumine</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Tulliliitto ja tavaroiden vapaa liikkuvuus</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Union douanière et libre circulation des marchandises</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Aontas Custaim agus saorghluaiseacht earraí</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Carinska unija i slobodno kretanje robe</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Vámunió és az áruk szabad mozgása</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Unione doganale e libera circolazione delle merci</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Muitas savienība un brīva preču aprite</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Muitų sąjunga ir laisvas prekių judėjimas</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Unjoni Doganali u l-moviment liberu tal-prodotti</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Douane-unie en vrij verkeer van goederen</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Unia celna i swobodny przepływ towarów</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">União aduaneira e livre circulação das mercadorias</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Uniune vamală şi libera circulaţie a mărfurilor</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Colná únia a voľný pohyb tovaru</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Carinska unija in prosti pretok blaga</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Unión aduanera y libre circulación de mercancías</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Tullunionen och fri rörlighet för varor</skos:prefLabel>
   </skos:Concept>

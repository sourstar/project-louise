      <skos:prefLabel xml:lang="bg">Общи, финансови и институционални въпроси</skos:prefLabel>
      <skos:prefLabel xml:lang="cs">Všeobecné, institucionální a finanční záležitosti</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Generelle, finansielle og institutionelle spørgsmål</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Allgemeine, institutionelle und finanzielle Fragen</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Γενικά, δημοσιονομικά και θεσμικά θέματα</skos:prefLabel>
      <skos:prefLabel xml:lang="en">General, financial and institutional matters</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Üldised ning finants- ja institutsioonilised küsimused</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Yleiset sekä varainhoitoa ja toimielimiä koskevat asiat</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">Questions générales, financières et institutionnelles</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Gnóthaí ginearálta, airgeadais agus institiúideacha</skos:prefLabel>
      <skos:prefLabel xml:lang="hr">Opća financijska i institucionalna pitanja</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Általános, pénzügyi és intézményi ügyek</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Questioni generali, istituzionali e finanziarie</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Vispārīgi, finanšu un institucionāli jautājumi</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Bendrieji, finansų ir instituciniai klausimai</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Kwistjonijiet ġenerali, finanzjarji u istituzzjonali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Algemene, institutionele en financiële vraagstukken</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Sprawy ogólne, finansowe i instytucjonalne</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Questões gerais, institucionais e financeiras</skos:prefLabel>
      <skos:prefLabel xml:lang="ro">Probleme generale, financiare şi instituţionale</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Všeobecné, finančné a inštitucionálne záležitosti</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Splošne, finančne in institucionalne zadeve</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Asuntos generales, financieros e institucionales</skos:prefLabel>
      <skos:prefLabel xml:lang="sv">Allmänna, finansiella och institutionella frågor</skos:prefLabel>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/dir-eu-legal-act/02"

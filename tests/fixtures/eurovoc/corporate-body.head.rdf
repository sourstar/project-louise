      <skos:altLabel xml:lang="lv">CELAC</skos:altLabel>
      <skos:altLabel xml:lang="el">Koinótīta tōn kratṓn tīs Latinikī́s Amerikī́s kai tīs Karaïvikī́s</skos:altLabel>
      <skos:altLabel xml:lang="nl">Celac</skos:altLabel>
      <skos:altLabel xml:lang="sv">Celac</skos:altLabel>
      <skos:altLabel xml:lang="bg">Obŝnost na latinoamerikanskite i karibskite d″ržavi</skos:altLabel>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#NAC">CELAC</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#XML_RECORD">COB0001681</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#LAC">CELAC</skos:notation>
      <skos:definition xml:lang="en">intergovernmental mechanism for dialogue and political agreement, which includes permanently thirty-two countries in Latin America and the Caribbean</skos:definition>
      <skos:prefLabel xml:lang="hr">Zajednica latinoameričkih i karipskih država</skos:prefLabel>
      <skos:prefLabel xml:lang="sk">Spoločenstvo štátov Latinskej Ameriky a Karibiku</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Gemeenschap van Latijns-Amerikaanse en Caribische State</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Comunità degli Stati latinoamericani e caraibici</skos:prefLabel>
      <skos:prefLabel xml:lang="el">Κοινότητα των κρατών της Λατινικής Αμερικής και της Καραϊβικής</skos:prefLabel>
      <skos:prefLabel xml:lang="bg">Общност на латиноамериканските и карибските държави</skos:prefLabel>
      <skos:prefLabel xml:lang="sl">Skupnost latinskoameriških in karibskih držav</skos:prefLabel>
      <skos:prefLabel xml:lang="et">Ladina-Ameerika ja Kariibi Riikide Ühendus</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Community of Latin American and Caribbean States</skos:prefLabel>
      <skos:prefLabel xml:lang="hu">Latin-amerikai és Karibi Államok Közössége</skos:prefLabel>
      <skos:prefLabel xml:lang="es">Comunidad de Estados Latinoamericanos y Caribeños</skos:prefLabel>
      <skos:prefLabel xml:lang="mt">Komunità ta’ Stati tal-Amerika Latina u tal-Karibew</skos:prefLabel>
      <skos:prefLabel xml:lang="pt">Comunidade de Estados Latino-Americanos e Caribenhos</skos:prefLabel>
      <skos:prefLabel xml:lang="ga">Comhphobal Stáit Mhuir Chairib agus Mheiriceá Laidinigh</skos:prefLabel>
      <skos:prefLabel xml:lang="fi">Latinalaisen Amerikan ja Karibian valtioiden yhteisö</skos:prefLabel>
      <skos:prefLabel xml:lang="pl">Wspólnota Państw Ameryki Łacińskiej i Karaibó</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gemeinschaft der Lateinamerikanischen und Karibischen Staaten</skos:prefLabel>
      <skos:prefLabel xml:lang="da">Sammenslutningen af Latinamerikanske og Caribiske Stater</skos:prefLabel>
      <skos:prefLabel xml:lang="lv">Latīņamerikas un Karību jūras reģiona valstu kopiena</skos:prefLabel>

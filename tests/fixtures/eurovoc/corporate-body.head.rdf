      <skos:prefLabel xml:lang="fr">Communauté des États latino-américains et des Caraïbes</skos:prefLabel>
      <skos:prefLabel xml:lang="lt">Lotynų Amerikos ir Karibų valstybių bendrija</skos:prefLabel>

      <pgterms:agent rdf:about="2009/agents/407">
        <pgterms:name>Nesbit, E. (Edith)</pgterms:name>
        <pgterms:birthdate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1858</pgterms:birthdate>

<?xml version="1.0" encoding="UTF-8"?><ANNEX xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://formex.publications.europa.eu/schema/formex-05.21-20110601.xd"><BIB.INSTANCE><DOCUMENT.REF FILE="L_2011304EN.01001801.doc.xml"><COLL>L</COLL><NO.OJ>304</NO.OJ><YEAR>2011</YEAR><LG.OJ>EN</LG.OJ><PAGE.FIRST>18</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><VOLUME.REF>01</VOLUME.REF></DOCUMENT.REF><DATE ISO="20111025">20111025</DATE><LG.DOC>EN</LG.DOC><NO.SEQ>0002.0015</NO.SEQ><PAGE.FIRST>63</PAGE.FIRST><PAGE.SEQ>1</PAGE.SEQ><PAGE.LAST>63</PAGE.LAST><PAGE.TOTAL>1</PAGE.TOTAL></BIB.INSTANCE><TITLE><TI><P>ANNEX XV</P></TI></TITLE><CONTENTS><GR.SEQ LEVEL="1"><TITLE><TI><P><HT TYPE="BOLD">EXPRESSION AND PRESENTATION OF NUTRITION DECLARATION</HT></P></TI></TITLE><P>The units of measurement to be used in the nutrition declaration for energy (kilojoules (kJ) and kilocalories (kcal)) and mass (grams (g), milligrams (mg) or micrograms (μg)) and the order of presentation of the information, as appropriate, shall be the following:</P><TBL COLS="2" NO.SEQ="0001"><CORPUS><ROW TYPE="HEADER"><CELL COL="1" TYPE="HEADER">energy</CELL><CELL COL="2" TYPE="HEADER">kJ/kcal</CELL></ROW><ROW><CELL COL="1">fat</CELL><CELL COL="2">g</CELL></ROW><BLK><ROW><CELL COL="1" COLSPAN="2">of which</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>saturates,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>mono-unsaturates,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>polyunsaturates,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW></BLK><ROW><CELL COL="1">carbohydrate</CELL><CELL COL="2">g</CELL></ROW><BLK><ROW><CELL COL="1" COLSPAN="2">of which</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>sugars,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>polyols,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1"><NP><NO.P>—</NO.P><TXT>starch,</TXT></NP></CELL><CELL COL="2">g</CELL></ROW></BLK><ROW><CELL COL="1">fibre</CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1">protein</CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1">salt</CELL><CELL COL="2">g</CELL></ROW><ROW><CELL COL="1">vitamins and minerals</CELL><CELL COL="2">the units specified in point 1 of Part A of Annex XIII</CELL></ROW></CORPUS></TBL></GR.SEQ></CONTENTS></ANNEX>

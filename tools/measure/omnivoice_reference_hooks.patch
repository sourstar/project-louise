+// LOCAL TEST HOOKS (not upstream), for the gate of the llama.cpp port:
+//   OV_FORCE_TOKENS=<file [K,T]> OV_FORCE_OUT=<dir>: one forward on these codes, the logits dumped, then stop
+//   OV_REPLAY_LOGITS=<dir> OV_REPLAY_OUT=<dir>: each step scores the logits of <dir>/step-NN-logits-{cond,uncond}.bin
+//   instead of this program's own, and dumps the codes after the step
+static bool hook_load(const std::string & path, std::vector<float> & out, size_t n_expect) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) {
+        fprintf(stderr, "[Hook] cannot read %s\n", path.c_str());
+        return false;
+    }
+    int32_t nd = 0;
+    if (fread(&nd, 4, 1, f) != 1 || nd < 1 || nd > 4) {
+        fclose(f);
+        return false;
+    }
+    int32_t shape[4];
+    size_t  n = 1;
+    if (fread(shape, 4, nd, f) != (size_t) nd) {
+        fclose(f);
+        return false;
+    }
+    for (int i = 0; i < nd; i++) {
+        n *= (size_t) shape[i];
+    }
+    out.resize(n);
+    bool ok = fread(out.data(), 4, n, f) == n && n == n_expect;
+    fclose(f);
+    if (!ok) {
+        fprintf(stderr, "[Hook] %s: %zu values, expected %zu\n", path.c_str(), n, n_expect);
+    }
+    return ok;
+}

# The pinned Intel stack (intel-stack-*.conf) installed on top of LocalAI's grpc builder base, which build.sh builds
# from LocalAI's own backend/Dockerfile.base-grpc-builder on the stack's ONEAPI_IMAGE. The debs come from build.sh's
# download directory, already checked against their sha256; installing them by file lets a pinned version replace
# (or downgrade) whatever Intel's apt repository gave install-base-deps.sh.
#
# ONE IGC, the pinned one (2026-11-07, the first a+b build): install-base-deps.sh also installs the kobuk-team PPA's
# libigc2 / libigdfcl2 into /usr/lib/x86_64-linux-gnu, while the pinned intel-igc-core-2 installs into
# /usr/local/lib. Both stayed: LocalAI's package_intel_libs, which searches /usr/lib, packaged the PPA's
# libigc.so.2.41.16, and ocloc, which compiles the AOT device code at BUILD time, loads whichever libigc it finds
# first. So every IGC library outside /usr/local/lib (libigc, libiga64, libigdfcl, whatever package brought it) is
# removed with its package, ldconfig makes /usr/local/lib the one the loader finds, packaging is pointed there
# first (INTEL_DRIVER_LIB_DIRS, which scripts/build/package-gpu-libs.sh honours), and the libigc ocloc really
# loads is written to /intel-stack.ocloc for build.sh's lock. The build stops if another IGC remains or if ocloc
# loads anything but the pinned one.
ARG BUILDER_BASE
FROM ${BUILDER_BASE}
COPY debs/ /tmp/intel-stack-debs/
RUN set -e \
 && apt-get update \
 && apt-get install -y --allow-downgrades --no-install-recommends /tmp/intel-stack-debs/*.deb \
 && stray() { find / -xdev \( -name 'libigc.so*' -o -name 'libiga64.so*' -o -name 'libigdfcl.so*' \) \
        -not -path '/usr/local/lib/*' -not -path '/opt/*' -not -path '/proc/*' 2>/dev/null; } \
 && owners=$(for f in $(stray); do dpkg -S "$f" 2>/dev/null | cut -d: -f1; done | sort -u) \
 && { [ -z "$owners" ] || apt-get remove -y $owners; } \
 && rm -f $(stray) \
 && ldconfig \
 && left=$(stray) && { [ -z "$left" ] || { echo "another IGC remains: $left" >&2; exit 1; }; } \
 && ldconfig -p | grep -E 'libig(c|a64)|libigdfcl' | tee /intel-stack.ldconfig \
 && ! grep -v '/usr/local/lib/' /intel-stack.ldconfig \
 && printf '__kernel void k(__global int *a) { a[get_global_id(0)] += 1; }\n' > /tmp/k.cl \
 && (cd /tmp && LD_DEBUG=libs ocloc compile -file k.cl -device bmg-g31 > /dev/null 2> /tmp/ocloc.debug || true) \
 && igc=$(grep -oE "calling init: [^ ]*libigc\.so[^ ]*" /tmp/ocloc.debug | head -1 | sed 's/calling init: //') \
 && { [ -n "$igc" ] || igc=$(grep -oE "/[^ ]*libigc\.so[^ ]*" /tmp/ocloc.debug | head -1); } \
 && echo "${igc:-unresolved} -> $(readlink -f "${igc:-/nonexistent}" 2>/dev/null)" > /intel-stack.ocloc \
 && cat /intel-stack.ocloc \
 && grep -q '/usr/local/lib/libigc.so' /intel-stack.ocloc \
 && rm -rf /tmp/intel-stack-debs /tmp/ocloc.debug /var/lib/apt/lists/* \
 && dpkg-query -W -f='${Package} ${Version}\n' intel-opencl-icd libze-intel-gpu1 intel-igc-core-2 intel-igc-opencl-2 \
      intel-ocloc libze1 > /intel-stack.versions \
 && cat /intel-stack.versions
ENV INTEL_DRIVER_LIB_DIRS="/usr/local/lib /usr/lib/x86_64-linux-gnu /usr/lib"
# no object from another build: LocalAI's compile step shares one ccache across every sycl_f16 build, and ccache's key
# (the compiler and its flags) does not see the libigc ocloc loads, so an AOT build would reuse device code another
# IGC compiled (2026-11-07: the IGC fix rebuilt in 76 s against 1,058 s, every object a cache hit)
ENV CCACHE_DISABLE=1

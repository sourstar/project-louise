+        assert get_metric(server, "context_loaded") == 0
+    assert get_metric(server, "context_canary_failures_total") == 2
+    assert get_metric(server, "context_creations_total") == 0
+
+    # the next context reproduces it and serves
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    assert get_metric(server, "context_creations_total") == 1
+    assert get_metric(server, "context_canary_failures_total") == 2
+
+
+def test_the_canary_can_be_switched_off():
+    global server
+    server.context_canary = False
+    server.context_canary_fail = 5  # nothing checks, so nothing can fail
+    server.start()
+    assert get_metric(server, "context_canary") == 0
+    wait_for_context(server, False)
+
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    assert get_metric(server, "context_creations_total") == 1
+    assert get_metric(server, "context_canary_failures_total") == 0
+
+
+def test_the_canary_of_an_embedding_model():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.context_canary_fail = 1
+    server.start()
+    assert get_metric(server, "context_canary") == 1
+    wait_for_context(server, False)
+
+    res = server.make_request("POST", "/v1/embeddings", data={
+        "input": "I believe the meaning of life is",
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 503
+    assert res.body["error"]["message"].startswith("context canary failed")
+
+    embeddings = []
+    for _ in range(3):
+        res = server.make_request("POST", "/v1/embeddings", data={
+            "input": "I believe the meaning of life is",
+            "keep_context_ms": 0,
+        })
+        assert res.status_code == 200
+        embeddings.append(res.body["data"][0]["embedding"])
+        wait_for_context(server, False)
+
+    assert embeddings[0] == embeddings[1] == embeddings[2]
+    assert get_metric(server, "context_creations_total") == 3
+    assert get_metric(server, "context_canary_failures_total") == 1
+
+
+def test_without_the_option_there_is_no_canary():
+    global server
+    server = ServerPreset.tinyllama2()
+    server.server_metrics = True
+    server.start()
+    assert get_metric(server, "context_canary") == 0
+    res = completion(server)
+    assert res.status_code == 200

+// the input of the context canary: a few positions through every layer, one small pass
+static const char * const COMMON_CANARY_TEXT       = "The quick brown fox jumps over the lazy dog. 0123456789";
+static const size_t       COMMON_CANARY_MAX_TOKENS = 64;
+
+// run the canary input on the context, the way the warmup run goes, and copy its output
+// returns false if it cannot be computed
+static bool common_context_canary_run(common_init_result & res, const common_params & params, std::vector<float> & out) {
+    llama_model   * model = res.model();
+    llama_context * lctx  = res.context();
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    std::vector<llama_token> tokens = common_tokenize(vocab, COMMON_CANARY_TEXT, true, false);
+    if (tokens.empty()) {
+        tokens.push_back(0);
+    }
+    tokens.resize(std::min({ tokens.size(), COMMON_CANARY_MAX_TOKENS, (size_t) std::max(params.n_batch, 1), (size_t) llama_n_ctx(lctx) }));
+
+    // an embedding is pooled over its outputs: every token is one, as in a request
+    const auto all_outputs = [&](common_batch & batch) {
+        if (params.embedding) {
+            for (int32_t i = 0; i < batch.size(); ++i) {
+                batch.set_output(i, true);
+            }
+        }
+    };
+
+    bool ok = true;
+
+    if (llama_model_has_encoder(model)) {
+        common_batch batch = common_batch_get_one(lctx, tokens);
+        all_outputs(batch);
+        ok = llama_process(lctx, LLAMA_PROCESS_TYPE_ENCODE, batch.get()) == 0;
+        if (llama_model_has_decoder(model)) {
+            llama_token decoder_start_token_id = llama_model_decoder_start_token(model);
+            if (decoder_start_token_id == LLAMA_TOKEN_NULL) {
+                decoder_start_token_id = llama_vocab_bos(vocab);
+            }
+            tokens.assign(1, decoder_start_token_id);
+        }
+    }
+    if (ok && llama_model_has_decoder(model)) {
+        common_batch batch = common_batch_get_one(lctx, tokens);
+        all_outputs(batch);
+        std::vector<float> zeros;
+        common_batch_set_zero_state(batch, model, zeros);
+        ok = llama_process(lctx, LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0;
+    }
+
+    if (ok) {
+        const float * data = nullptr;
+        size_t        n    = 0;
+        if (params.embedding) {
+            const enum llama_pooling_type pooling = llama_pooling_type(lctx);
+            if (pooling == LLAMA_POOLING_TYPE_NONE) {
+                data = llama_get_embeddings_ith(lctx, -1);
+                n    = llama_model_n_embd_out(model);
+            } else {
+                data = llama_get_embeddings_seq(lctx, 0);
+                n    = pooling == LLAMA_POOLING_TYPE_RANK ? llama_model_n_cls_out(model) : llama_model_n_embd_out(model);
+            }
+        } else {
+            data = llama_get_logits_ith(lctx, -1);
+            n    = llama_vocab_n_tokens(vocab);
+        }
+        ok = data != nullptr && n > 0;
+        if (ok) {
+            out.assign(data, data + n);
+        }
+    }
+
+    llama_memory_clear(llama_get_memory(lctx), true);
+    llama_synchronize(lctx);
+    llama_perf_context_reset(lctx);
+
+    return ok;
+}
+
+// same values, bit for bit (a NaN equals the same NaN)
+static bool common_context_canary_same(const std::vector<float> & a, const std::vector<float> & b) {
+    return a.size() == b.size() && std::memcmp(a.data(), b.data(), a.size() * sizeof(float)) == 0;
+}
+
+static void common_context_canary_diff(const std::vector<float> & a, const std::vector<float> & b) {
+    size_t n_diff   = 0;
+    float  max_diff = 0.0f;
+    for (size_t i = 0; i < std::min(a.size(), b.size()); ++i) {
+        if (std::memcmp(&a[i], &b[i], sizeof(float)) != 0) {
+            n_diff++;
+            max_diff = std::max(max_diff, std::fabs(a[i] - b[i]));
+        }
+    }
+    COM_WRN("context canary: %zu of %zu values differ (sizes %zu and %zu), the largest difference is %g\n",
+            n_diff, std::min(a.size(), b.size()), a.size(), b.size(), (double) max_diff);
+}
+
+common_canary_status common_init_result::canary_record(const common_params & params) {
+    GGML_ASSERT(pimpl->model && pimpl->context);
+
+    pimpl->canary.clear();
+
+    std::vector<float> first;
+    std::vector<float> second;
+    if (!common_context_canary_run(*this, params, first) || !common_context_canary_run(*this, params, second)) {
+        return COMMON_CANARY_NONE;
+    }
+    if (!common_context_canary_same(first, second)) {
+        common_context_canary_diff(first, second);
+        return COMMON_CANARY_MISMATCH;
+    }
+
+    pimpl->canary = std::move(second);
+
+    COM_INF("context canary: recorded, %zu values\n", pimpl->canary.size());
+
+    return COMMON_CANARY_OK;
+}
+
+common_canary_status common_init_result::canary_check(const common_params & params) {
+    GGML_ASSERT(pimpl->model && pimpl->context);
+
+    if (pimpl->canary.empty()) {
+        return COMMON_CANARY_OK;
+    }
+
+    std::vector<float> now;
+    if (!common_context_canary_run(*this, params, now)) {
+        COM_WRN("%s", "context canary: its output could not be computed on this context\n");
+        return COMMON_CANARY_MISMATCH;
+    }
+    if (!common_context_canary_same(pimpl->canary, now)) {
+        common_context_canary_diff(pimpl->canary, now);
+        return COMMON_CANARY_MISMATCH;
+    }
+
+    return COMMON_CANARY_OK;
+}
+

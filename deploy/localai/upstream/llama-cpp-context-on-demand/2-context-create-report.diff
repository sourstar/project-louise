diff --git a/tools/server/tests/unit/test_context_on_demand.py b/tools/server/tests/unit/test_context_on_demand.py
index fd33b96..4ff9c5e 100644
--- a/tools/server/tests/unit/test_context_on_demand.py
+++ b/tools/server/tests/unit/test_context_on_demand.py
@@ -332,3 +332,58 @@ def test_rerank_identical_across_contexts():
 
     assert scores[0] == scores[1] == scores[2]
     assert get_metric(server, "context_creations_total") == 3
+
+
+def test_a_result_says_when_the_context_was_created_for_it():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.start()
+    wait_for_context(server, False)
+
+    # the non-OAI route returns its results as they are
+    res = server.make_request("POST", "/embedding", data={
+        "content": "I believe the meaning of life is",
+        "keep_context_ms": 60000,
+    })
+    assert res.status_code == 200
+    assert res.body[0]["context_create_ms"] >= 0
+
+    # the context is there for the next one
+    res = server.make_request("POST", "/embedding", data={
+        "content": "This is a test",
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert "context_create_ms" not in res.body[0]
+    assert get_metric(server, "context_creations_total") == 1
+
+
+def test_one_result_of_a_batch_says_the_context_was_created():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.start()
+    wait_for_context(server, False)
+
+    res = server.make_request("POST", "/embedding", data={
+        "content": ["I believe the meaning of life is", "This is a test", "Hello world"],
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert len(res.body) == 3
+    assert sum("context_create_ms" in r for r in res.body) == 1
+    wait_for_context(server, False)
+
+    # without the option, no result says anything
+    server.stop()
+    server = ServerPreset.bert_bge_small()
+    server.start()
+    res = server.make_request("POST", "/embedding", data={
+        "content": "This is a test",
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert "context_create_ms" not in res.body[0]

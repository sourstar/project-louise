@@ -0,0 +1,84 @@
+package grpc
+
+import (
+	"context"
+	"net"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	gogrpc "google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// parkingServer is a backend process whose Free answers what it is told to.
+type parkingServer struct {
+	pb.UnimplementedBackendServer
+	result *pb.Result
+	err    error
+	frees  int
+}
+
+func (s *parkingServer) Free(context.Context, *pb.HealthMessage) (*pb.Result, error) {
+	s.frees++
+	return s.result, s.err
+}
+
+// tracking is a watchdog that records the requests the client tells it of.
+type tracking struct{ began, ended int }
+
+func (t *tracking) Mark(string)   { t.began++ }
+func (t *tracking) UnMark(string) { t.ended++ }
+func (t *tracking) TrackRequest(string) func() {
+	t.began++
+	return func() { t.ended++ }
+}
+
+// The client against a real gRPC server: what the loader's specs, which
+// script a backend in memory, cannot see.
+var _ = Describe("Client.FreeResult", func() {
+	serve := func(s *parkingServer) string {
+		GinkgoHelper()
+		lis, err := net.Listen("tcp", "127.0.0.1:0")
+		Expect(err).NotTo(HaveOccurred())
+		srv := gogrpc.NewServer()
+		pb.RegisterBackendServer(srv, s)
+		go func() { _ = srv.Serve(lis) }()
+		DeferCleanup(srv.GracefulStop)
+		return lis.Addr().String()
+	}
+
+	It("gives the backend's answer to Free: the message a park is told by, and its metadata", func() {
+		backend := &parkingServer{result: &pb.Result{Success: true, Message: "parked"}}
+		wd := &tracking{}
+		client := &Client{address: serve(backend), parallel: true, wd: wd}
+		res, err := client.FreeResult(context.Background())
+		Expect(err).NotTo(HaveOccurred())
+		Expect(res.GetSuccess()).To(BeTrue())
+		Expect(res.GetMessage()).To(Equal("parked"))
+		Expect(backend.frees).To(Equal(1))
+		Expect(wd.began).To(Equal(1), "a park is a request for the watchdog while it runs")
+		Expect(wd.ended).To(Equal(1))
+		Expect(client.IsBusy()).To(BeFalse())
+	})
+
+	It("keeps the code and the words of a refusal: the loader reads both", func() {
+		backend := &parkingServer{err: status.Error(codes.FailedPrecondition, "busy: a request is running, the model stays on the device")}
+		client := &Client{address: serve(backend), parallel: true}
+		_, err := client.FreeResult(context.Background())
+		Expect(status.Code(err)).To(Equal(codes.FailedPrecondition))
+		Expect(status.Convert(err).Message()).To(Equal("busy: a request is running, the model stays on the device"))
+	})
+
+	It("is what Free sends: one call, the answer dropped, a backend with no Free still Unimplemented", func() {
+		backend := &parkingServer{result: &pb.Result{Success: true, Message: "parked"}}
+		client := &Client{address: serve(backend), parallel: true}
+		Expect(client.Free(context.Background())).To(Succeed())
+		Expect(backend.frees).To(Equal(1))
+
+		none := &Client{address: serve(&parkingServer{err: status.Error(codes.Unimplemented, "method Free not implemented")}), parallel: true}
+		Expect(status.Code(none.Free(context.Background()))).To(Equal(codes.Unimplemented))
+	})
+})

diff --git a/core/http/app.go b/core/http/app.go
index 37f63e8..1fce9a3 100644
--- a/core/http/app.go
+++ b/core/http/app.go
@@ -116,6 +116,29 @@ func applyModelLoadCooldown(err error, code int, c echo.Context) int {
 	return http.StatusServiceUnavailable
 }
 
+// noRoomRetryAfterSeconds is how long a client is told to wait before it
+// sends again a request the device had no room for.
+const noRoomRetryAfterSeconds = 2
+
+// applyNoRoomOnDevice maps a refusal of the moment - the device had no
+// memory for a model's weights to come back, for a context, or for a
+// computation - to 503 with a Retry-After. Nothing is wrong with the request
+// or with the model, and the same request may be served a moment later: it
+// was a 500, which no client could tell from a fault. It returns the message
+// to answer with, "" when err is something else.
+func applyNoRoomOnDevice(err error, code int, c echo.Context) (int, string) {
+	message, noRoom := model.NoRoomOnDevice(err)
+	if !noRoom {
+		return code, ""
+	}
+	var typed *model.NoRoomOnDeviceError
+	if errors.As(err, &typed) {
+		message = typed.Error()
+	}
+	c.Response().Header().Set("Retry-After", strconv.Itoa(noRoomRetryAfterSeconds))
+	return http.StatusServiceUnavailable, message
+}
+
 func applyBackendAdmission(err error, code int, c echo.Context) int {
 	var capacityErr *corebackend.BackendAdmissionError
 	if !errors.As(err, &capacityErr) {
@@ -264,6 +287,7 @@ func API(application *application.Application) (*echo.Echo, error) {
 			code = applyModelLoadCooldown(err, code, c)
 			code = applyBackendAdmission(err, code, c)
 			code = applyNoAvailableNodes(err, code)
+			code, noRoom := applyNoRoomOnDevice(err, code, c)
 
 			// Handle 404 errors: serve React SPA for HTML requests, JSON otherwise
 			if code == http.StatusNotFound {
@@ -285,8 +309,13 @@ func API(application *application.Application) (*echo.Echo, error) {
 			if errors.As(err, &capErr) {
 				errType = "rate_limit_error"
 			}

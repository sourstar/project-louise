diff --git a/core/application/park_floor_internal_test.go b/core/application/park_floor_internal_test.go
new file mode 100644
index 0000000..c73d407
--- /dev/null
+++ b/core/application/park_floor_internal_test.go
@@ -0,0 +1,72 @@
+package application
+
+import (
+	"context"
+
+	"github.com/mudler/LocalAI/core/config"
+	grpcPkg "github.com/mudler/LocalAI/pkg/grpc"
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/model"
+	"github.com/mudler/LocalAI/pkg/system"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+// floorBackend is a backend that parks. Embedding leaves any other call as a
+// panic rather than a network call.
+type floorBackend struct {
+	grpcPkg.Backend
+}
+
+func (floorBackend) HealthCheck(context.Context) (bool, error) { return true, nil }
+func (floorBackend) IsBusy() bool                              { return false }
+func (floorBackend) Status(context.Context) (*pb.StatusResponse, error) {
+	return &pb.StatusResponse{Memory: &pb.MemoryUsageData{Breakdown: map[string]uint64{"park_size": 1 << 30}}}, nil
+}
+func (floorBackend) FreeResult(context.Context) (*pb.Result, error) {
+	return &pb.Result{Success: true, Message: "parked"}, nil
+}
+
+var _ = Describe("The host's floor for parking", func() {
+	It("is the runtime setting, read at each park: nothing parks while it is 0, and a change is followed at once", func() {
+		appConfig := config.NewApplicationConfig(config.WithSystemState(&system.SystemState{}))
+		app := newApplication(appConfig)
+		ml := app.ModelLoader()
+		ml.SetHostAvailableMemorySource(func() (uint64, error) { return 64 << 30, nil })
+		store := model.NewInMemoryModelStore()
+		held := model.NewModelWithClient("m", "addr", floorBackend{})
+		held.SetParks(true)
+		store.Set("m", held)
+		ml.SetModelStore(store)
+
+		Expect(appConfig.ParkHostFloorBytes).To(BeZero(), "the default")
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).To(MatchError(model.ErrParkingOff))
+
+		floor := uint64(8 << 30)
+		Expect(appConfig.ApplyRuntimeSettings(&config.RuntimeSettings{ParkHostFloorBytes: &floor})).To(BeFalse(), "no restart of anything")
+		state, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(state.Parked).To(BeTrue())
+	})
+})
+
+var _ = Describe("The failover prober and a parked model", func() {
+	It("takes a parked model for not loaded: a probe sent to it would bring its weights back behind the loader's back", func() {
+		ml := model.NewModelLoader(&system.SystemState{})
+		ml.SetParkHostFloorSource(func() uint64 { return 8 << 30 })
+		ml.SetHostAvailableMemorySource(func() (uint64, error) { return 64 << 30, nil })
+		store := model.NewInMemoryModelStore()
+		held := model.NewModelWithClient("m", "addr", floorBackend{})
+		held.SetParks(true)
+		store.Set("m", held)
+		ml.SetModelStore(store)
+		loaded := failoverLoadedBackend(ml)
+		cfg := config.ModelConfig{Name: "m"}
+
+		Expect(loaded(cfg)).NotTo(BeNil(), "loaded: it is probed")
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(loaded(cfg)).To(BeNil(), "parked: not probed")
+	})
+})

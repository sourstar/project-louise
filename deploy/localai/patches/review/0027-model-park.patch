+++ b/core/http/no_room_handler_test.go
@@ -0,0 +1,56 @@
+package http
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+
+	"github.com/labstack/echo/v4"
+	"github.com/mudler/LocalAI/pkg/model"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// A request the device had no room for at that moment is a deferral: 503
+// with a Retry-After, where it was a 500 like a fault.
+var _ = Describe("No room on the device", func() {
+	apply := func(err error) (int, string, string) {
+		e := echo.New()
+		rec := httptest.NewRecorder()
+		c := e.NewContext(httptest.NewRequest(http.MethodPost, "/", nil), rec)
+		code, message := applyNoRoomOnDevice(err, http.StatusInternalServerError, c)
+		return code, message, rec.Header().Get("Retry-After")
+	}
+
+	It("maps a model that could not come back to 503 with a Retry-After, naming the model", func() {
+		code, message, retry := apply(fmt.Errorf("loading: %w", &model.NoRoomOnDeviceError{Model: "bge-m3", Message: "the weights cannot come back to the device now"}))
+		Expect(code).To(Equal(http.StatusServiceUnavailable))
+		Expect(message).To(Equal("bge-m3: the weights cannot come back to the device now"))
+		Expect(retry).To(Equal("2"))
+	})
+
+	It("maps a backend's own refusal the same way, under whatever a caller wrapped it in", func() {
+		refusal := status.Error(codes.ResourceExhausted, "no_room_on_device: the context cannot be created now, try again later")
+		code, message, retry := apply(fmt.Errorf("embeddings: %w", refusal))
+		Expect(code).To(Equal(http.StatusServiceUnavailable))
+		Expect(message).To(Equal("the context cannot be created now, try again later"))
+		Expect(retry).To(Equal("2"))
+	})
+
+	It("leaves the other meanings of ResourceExhausted, and every other error, as they were", func() {
+		for _, other := range []error{
+			status.Error(codes.ResourceExhausted, "backend is busy"),
+			status.Error(codes.ResourceExhausted, "grpc: received message larger than max (60000000 vs. 52428800)"),
+			status.Error(codes.Internal, "the weights could not be brought back to the device: a failure, not a refusal"),
+			errors.New("some other error"),
+		} {
+			code, message, retry := apply(other)
+			Expect(code).To(Equal(http.StatusInternalServerError), other.Error())
+			Expect(message).To(BeEmpty())
+			Expect(retry).To(BeEmpty())
+		}
+	})
+})

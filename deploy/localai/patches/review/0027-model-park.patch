+// tryAcquire takes the model's lifecycle lock only if it is free at this
+// moment - nobody holds it and nobody waits for it - and never blocks. A
+// caller that must not queue behind a load, a return or a stop uses it and
+// reads "not free" as "busy".
+func (l *modelOperationLocks) tryAcquire(modelID string, exclusive bool) (func(), bool) {
+	l.mu.Lock()
+	entry := l.entries[modelID]
+	if entry == nil {
+		entry = &modelOperationLock{sem: semaphore.NewWeighted(math.MaxInt64)}
+		l.entries[modelID] = entry
+	}
+	entry.refs++
+	l.mu.Unlock()
+
+	weight := int64(1)
+	if exclusive {
+		weight = math.MaxInt64
+	}
+	if !entry.sem.TryAcquire(weight) {
+		l.releaseReference(modelID, entry)
+		return nil, false
+	}
+
+	return func() {
+		entry.sem.Release(weight)
+		l.releaseReference(modelID, entry)
+	}, true
+}
+

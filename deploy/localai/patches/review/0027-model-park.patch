index c60e92a..ec89fb8 100644
--- a/core/http/endpoints/localai/backend_monitor.go
+++ b/core/http/endpoints/localai/backend_monitor.go
@@ -76,3 +76,64 @@ func BackendShutdownEndpoint(bm *monitoring.BackendMonitorService) echo.HandlerF

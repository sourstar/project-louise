+			}
+			Expect(calls).To(Equal(2), "the second request reached the backend again")
+
+			failing := func(string, string, string) (*Model, error) {
+				calls++
+				return nil, errors.New("could not load model: the file is not a model")
+			}
+			_, err := ml.LoadModel("broken", "broken.gguf", failing)
+			Expect(err).To(HaveOccurred())
+			_, err = ml.LoadModel("broken", "broken.gguf", failing)
+			Expect(calls).To(Equal(3), "a load that FAILED still arms it")
+			Expect(err).To(HaveOccurred())
+		})
+	})
+
+	Describe("NoRoomOnDevice", func() {
+		It("is the code AND the head of the message: the code alone has other meanings on this wire", func() {
+			message, ok := NoRoomOnDevice(status.Error(codes.ResourceExhausted, "no_room_on_device: the context cannot be created now"))
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("the context cannot be created now"))
+
+			for _, other := range []error{
+				status.Error(codes.ResourceExhausted, "backend is busy"),
+				status.Error(codes.ResourceExhausted, "grpc: received message larger than max"),
+				status.Error(codes.Internal, "no_room_on_device: said under another code"),
+				status.Error(codes.ResourceExhausted, "it said no_room_on_device: somewhere inside"),
+				errors.New("no_room_on_device: not a status at all"),
+				nil,
+			} {
+				_, ok := NoRoomOnDevice(other)
+				Expect(ok).To(BeFalse(), fmt.Sprint(other))
+			}
+		})
+
+		It("is found under what callers wrap it in", func() {
+			wrapped := fmt.Errorf("conversation too long for per-token embeddings: %w",
+				fmt.Errorf("predict: %w", status.Error(codes.ResourceExhausted, "no_room_on_device: Compute error")))
+			message, ok := NoRoomOnDevice(wrapped)
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("Compute error"))
+
+			message, ok = NoRoomOnDevice(fmt.Errorf("loading: %w", &NoRoomOnDeviceError{Model: "m", Message: "the weights cannot come back"}))
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("the weights cannot come back"))
+		})
+	})
+})
diff --git a/pkg/model/park_watchdog_internal_test.go b/pkg/model/park_watchdog_internal_test.go
new file mode 100644
index 0000000..69a3b65
--- /dev/null
+++ b/pkg/model/park_watchdog_internal_test.go
@@ -0,0 +1,184 @@
+package model
+
+import (
+	"context"
+	"time"
+
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/system"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// The loader and a REAL watchdog together: what a park and a return do to
+// the registry the limits are counted from. The loader's own specs run
+// without a watchdog, and the watchdog's against a manager that only records
+// its calls; neither sees these.
+var _ = Describe("Parking under a watchdog", func() {
+	const (
+		floor = uint64(8 << 30)
+		gib   = uint64(1 << 30)
+	)
+	var (
+		ml      *ModelLoader
+		wd      *WatchDog
+		backend *parkBackend
+		m       *Model
+		options = &pb.ModelOptions{Model: "m", ModelFile: "m.gguf", ContextSize: 512}
+	)
+
+	// a loaded model, registered as a load registers it
+	loaded := func(id, address string, parks bool) (*Model, *parkBackend) {
+		b := newParkBackend()
+		held := NewModelWithClient(id, address, b)
+		held.MarkHealthy()
+		held.SetParks(parks)
+		held.SetLoadOptions(options)
+		ml.store.Set(id, held)
+		ml.wd.AddAddressModelMap(address, id)
+		return held, b
+	}
+	attach := func(opts ...WatchDogOption) {
+		wd = NewWatchDog(append([]WatchDogOption{WithProcessManager(ml)}, opts...)...)
+		ml.SetWatchDog(wd)
+	}
+
+	BeforeEach(func() {
+		ml = NewModelLoader(&system.SystemState{})
+		ml.SetLRUEvictionRetrySettings(2, time.Millisecond)
+		ml.SetParkHostFloorSource(func() uint64 { return floor })
+		ml.SetHostAvailableMemorySource(func() (uint64, error) { return 64 * gib, nil })
+		attach(WithLRULimit(1))
+		m, backend = loaded("m", "addr", true)
+	})
+
+	It("takes a parked model out of the loaded models, and puts it back BEFORE its weights move", func() {
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+		Expect(wd.GetLoadedModelCount()).To(BeZero(), "not counted against the limit, not an eviction candidate")
+
+		during := -1
+		backend.onLoad = func() { during = wd.GetLoadedModelCount() }
+		_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+		Expect(err).NotTo(HaveOccurred())
+		Expect(during).To(Equal(1), "a load that starts during the copy must count the model that is coming back")
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+	})
+
+	It("does not leave a model whose return was refused, or failed, among the loaded models", func() {
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+
+		backend.loadResult, backend.loadErr = nil, status.Error(codes.ResourceExhausted, "no_room_on_device: the weights cannot come back to the device now")
+		_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+		_, noRoom := NoRoomOnDevice(err)
+		Expect(noRoom).To(BeTrue())
+		Expect(m.ParkedState().Parked).To(BeTrue())
+		Expect(wd.GetLoadedModelCount()).To(BeZero(), "still parked: it holds nothing the limits count")
+
+		backend.loadErr = status.Error(codes.Internal, "the weights could not be brought back to the device: a failure, not a refusal")
+		Expect(ml.unpark(context.Background(), m)).To(MatchError(ErrParkedReturnFailed))
+		Expect(wd.GetLoadedModelCount()).To(BeZero())
+	})
+
+	It("makes room for a model that comes back as for a load: what took its place is stopped, or parked if it can", func() {
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+		_, plain := loaded("plain", "addr-plain", false) // loaded while m was parked: the limit is 1
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+
+		_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+		Expect(err).NotTo(HaveOccurred())
+		_, still := ml.store.Get("plain")
+		Expect(still).To(BeFalse(), "a model that does not park is stopped, as before")
+		Expect(plain.plainFrees).To(Equal(1))
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+
+		_, err = ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+		other, otherBackend := loaded("other", "addr-other", true)
+		_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+		Expect(err).NotTo(HaveOccurred())
+		Expect(other.ParkedState().Parked).To(BeTrue(), "a model that parks is parked")
+		Expect(otherBackend.parks).To(Equal(1))
+		Expect(otherBackend.plainFrees).To(BeZero())
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+	})
+
+	It("brings a parked model back once for two requests, and the second evicts nothing", func() {
+		_, err := ml.ParkModel(context.Background(), "m")
+		Expect(err).NotTo(HaveOccurred())
+
+		copying, finish := make(chan struct{}), make(chan struct{})
+		backend.onLoad = func() { close(copying); <-finish }
+		done := make(chan error, 2)
+		for range 2 {
+			go func() {
+				defer GinkgoRecover()
+				_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+				done <- err
+			}()
+		}
+		Eventually(copying).Should(BeClosed())
+		close(finish)
+		Expect(<-done).NotTo(HaveOccurred())
+		Expect(<-done).NotTo(HaveOccurred())
+		Expect(backend.loads).To(Equal(1), "one LoadModel")
+		Expect(backend.parks).To(Equal(1), "and the model the first brought back was not parked again under the limit of one")
+		Expect(m.ParkedState().Parked).To(BeFalse())
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+	})
+
+	It("parks, through the limit of loaded models, a model that can park", func() {
+		result := wd.EnforceLRULimit(0)
+		Expect(result.EvictedCount).To(Equal(1))
+		Expect(result.NeedMore).To(BeFalse())
+		Expect(m.ParkedState().Parked).To(BeTrue())
+		_, still := ml.store.Get("m")
+		Expect(still).To(BeTrue(), "its process stays")
+		Expect(wd.GetLoadedModelCount()).To(BeZero())
+	})
+
+	It("keeps, and tracks again, a model whose lifecycle lock is held when the limit selects it: it is not stopped for that", func() {
+		release := ml.operations.acquire("m", true) // its return, say
+		result := wd.EnforceLRULimit(0)
+		release()
+		Expect(result.EvictedCount).To(BeZero())
+		Expect(result.NeedMore).To(BeTrue(), "the room asked for does not exist yet")
+		Expect(m.ParkedState().Parked).To(BeFalse())
+		_, still := ml.store.Get("m")
+		Expect(still).To(BeTrue())
+		Expect(backend.parks + backend.plainFrees).To(BeZero())
+		Expect(wd.GetLoadedModelCount()).To(Equal(1), "tracked again: the next load still counts it")
+	})
+
+	It("stops at its idle timeout a model that parks: that eviction wants the model gone, not the device back", func() {
+		attach(WithIdleTimeout(time.Millisecond), WithIdleCheck(true))
+		wd.AddAddressModelMap("addr", "m")
+		wd.TrackRequest("addr")() // a request came and went: idle from now
+		time.Sleep(5 * time.Millisecond)
+		wd.checkIdle()
+		_, still := ml.store.Get("m")
+		Expect(still).To(BeFalse())
+		Expect(backend.parks).To(BeZero())
+	})
+
+	It("parks for a memory reclaimer that watches a device, and stops for one that watches the host's RAM", func() {
+		wd.evictLRU(true)
+		Expect(m.ParkedState().Parked).To(BeTrue())
+		Expect(wd.GetLoadedModelCount()).To(BeZero())
+		// its address is alive: a return registers it, and nothing erases that
+		_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+		Expect(err).NotTo(HaveOccurred())
+		Expect(wd.GetLoadedModelCount()).To(Equal(1))
+
+		wd.evictLRU(false)
+		_, still := ml.store.Get("m")
+		Expect(still).To(BeFalse(), "parking would only fill the RAM it is asked to give back")
+		Expect(backend.parks).To(Equal(1), "the one park above")
+		Expect(wd.GetLoadedModelCount()).To(BeZero())
+	})
+})

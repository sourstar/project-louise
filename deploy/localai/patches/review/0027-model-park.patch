+package model
+
+import (
+	"errors"
+	"fmt"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+)
+
+// parkingManager is a process manager that can park: what the watchdog asks
+// of it for one eviction target.
+type parkingManager struct {
+	parked  bool
+	parkErr error
+	calls   []string
+}
+
+func (pm *parkingManager) ShutdownModel(model string) error {
+	pm.calls = append(pm.calls, "shutdown "+model)
+	return nil
+}
+
+func (pm *parkingManager) ShutdownModelForce(model string) error {
+	pm.calls = append(pm.calls, "force "+model)
+	return nil
+}
+
+func (pm *parkingManager) ShutdownModelAtAddress(model, address string, force bool) error {
+	pm.calls = append(pm.calls, fmt.Sprintf("stop %s@%s force=%t", model, address, force))
+	return nil
+}
+
+func (pm *parkingManager) ParkModelAtAddress(model, address string) (bool, error) {
+	pm.calls = append(pm.calls, fmt.Sprintf("park %s@%s", model, address))
+	return pm.parked, pm.parkErr
+}
+
+// Where the watchdog would stop a model to make room, it parks one that can
+// park - and never stops one for being busy at that moment.
+var _ = Describe("WatchDog eviction with a manager that parks", func() {
+	target := evictionTarget{address: "addr", model: "m"}
+
+	It("parks instead of stopping", func() {
+		pm := &parkingManager{parked: true}
+		wd := NewWatchDog(WithProcessManager(pm))
+		Expect(wd.shutdownTarget(target)).To(Succeed())
+		Expect(pm.calls).To(Equal([]string{"park m@addr"}))
+	})
+
+	It("stops, as before, a model that cannot park or that the host has no room for", func() {
+		for _, why := range []error{ErrModelCannotPark, ErrParkingOff, ErrParkHostFloor} {
+			pm := &parkingManager{parkErr: why}
+			wd := NewWatchDog(WithProcessManager(pm))
+			Expect(wd.shutdownTarget(target)).To(Succeed())
+			Expect(pm.calls).To(Equal([]string{"park m@addr", "stop m@addr force=false"}), why.Error())
+		}
+	})
+
+	It("does not stop a model for being busy: the eviction fails, and the caller keeps it and takes another", func() {
+		pm := &parkingManager{parkErr: fmt.Errorf("%w: a request is running", ErrModelBusy)}
+		wd := NewWatchDog(WithProcessManager(pm))
+		err := wd.shutdownTarget(target)
+		Expect(errors.Is(err, ErrModelBusy)).To(BeTrue())
+		Expect(pm.calls).To(Equal([]string{"park m@addr"}))
+	})
+
+	It("does not try to park what it was told to evict while busy: that is a forced stop", func() {
+		pm := &parkingManager{parked: true}
+		wd := NewWatchDog(WithProcessManager(pm))
+		Expect(wd.shutdownTarget(evictionTarget{address: "addr", model: "m", wasBusy: true})).To(Succeed())
+		Expect(pm.calls).To(Equal([]string{"stop m@addr force=true"}))
+	})
+})

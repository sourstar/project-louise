+				errType = model.NoRoomOnDeviceType
+				message = noRoom
+			}
 			c.JSON(code, schema.ErrorResponse{
-				Error: &schema.APIError{Message: err.Error(), Code: code, Type: errType},
+				Error: &schema.APIError{Message: message, Code: code, Type: errType},
 			})
 		}
 	} else {
@@ -302,6 +331,7 @@ func API(application *application.Application) (*echo.Echo, error) {
 			// model gets the status and Retry-After but no progress detail.

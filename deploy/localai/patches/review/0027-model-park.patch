new file mode 100644
index 0000000..9147526
--- /dev/null
+++ b/pkg/xsysinfo/memory_headroom.go
@@ -0,0 +1,87 @@
+package xsysinfo
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/mudler/memory"
+)
+
+// The usage side of the memory cgroup this process runs in. Variables, as
+// the limit's paths in memory.go are.
+var (
+	cgroupV2CurrentPath = "/sys/fs/cgroup/memory.current"
+	cgroupV2StatPath    = "/sys/fs/cgroup/memory.stat"
+	cgroupV1UsagePath   = "/sys/fs/cgroup/memory/memory.usage_in_bytes"
+	cgroupV1StatPath    = "/sys/fs/cgroup/memory/memory.stat"
+)
+
+// AllocatableMemory is how many bytes this process, or a child of it, can
+// still take: the host's available memory, and under a memory cgroup limit
+// no more than what the limit still allows.
+//
+// GetSystemRAMInfo's Available is the host's MemAvailable capped at the
+// cgroup's TOTAL: in a container with a memory limit it says what the HOST
+// could give, whatever the container already uses. A caller that is about
+// to copy gigabytes into memory - a model's weights being parked - and
+// trusts that figure can take the container over its limit, and it is the
+// process holding the weights that the kernel then kills.
+func AllocatableMemory() uint64 {
+	return chooseAllocatableMemory(
+		memory.AvailableMemory(),
+		readFileBestEffort(cgroupV2MaxPath), readFileBestEffort(cgroupV2CurrentPath), readFileBestEffort(cgroupV2StatPath),
+		readFileBestEffort(cgroupV1LimitPath), readFileBestEffort(cgroupV1UsagePath), readFileBestEffort(cgroupV1StatPath),
+	)
+}
+
+// chooseAllocatableMemory is the minimum of the host's available memory and
+// each cgroup's headroom, where a cgroup has a limit.
+func chooseAllocatableMemory(hostAvailable uint64, v2Max, v2Current, v2Stat, v1Limit, v1Usage, v1Stat string) uint64 {
+	best := hostAvailable
+	if room, limited := cgroupHeadroom(parseCgroupV2Max(v2Max), v2Current, v2Stat, "inactive_file"); limited && room < best {
+		best = room
+	}
+	if room, limited := cgroupHeadroom(parseCgroupV1Limit(v1Limit), v1Usage, v1Stat, "total_inactive_file"); limited && room < best {
+		best = room
+	}
+	return best
+}
+
+// cgroupHeadroom is what a memory cgroup with a limit still allows: the
+// limit less its working set - its usage without the file cache the kernel
+// drops before it refuses anything (the measure container runtimes report as
+// "working set"). limited is false where there is no limit or the usage
+// cannot be read: an unreadable cgroup must not be read as a full one.
+func cgroupHeadroom(limit uint64, usageRaw, statRaw, inactiveFileKey string) (room uint64, limited bool) {
+	if limit == 0 {
+		return 0, false
+	}
+	usage, ok := parseUintField(usageRaw)
+	if !ok {
+		return 0, false
+	}
+	if inactive := parseStatField(statRaw, inactiveFileKey); inactive < usage {
+		usage -= inactive
+	} else {
+		usage = 0
+	}
+	if usage >= limit {
+		return 0, true
+	}
+	return limit - usage, true
+}
+
+// parseStatField reads one "key value" line of a cgroup's memory.stat; 0
+// when the key is absent.
+func parseStatField(raw, key string) uint64 {
+	for line := range strings.SplitSeq(raw, "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == key {
+			if v, err := strconv.ParseUint(fields[1], 10, 64); err == nil {
+				return v
+			}
+			return 0
+		}
+	}
+	return 0
+}

diff --git a/core/backend/park_internal_test.go b/core/backend/park_internal_test.go
new file mode 100644
index 0000000..ad60e22
--- /dev/null
+++ b/core/backend/park_internal_test.go
@@ -0,0 +1,46 @@
+package backend
+
+import (
+	"github.com/mudler/LocalAI/core/config"
+	"github.com/mudler/LocalAI/pkg/model"
+	"github.com/mudler/LocalAI/pkg/system"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"gopkg.in/yaml.v3"
+)
+
+var _ = Describe("Parking, from a model's file to its load", func() {
+	options := func(file string) *model.Options {
+		GinkgoHelper()
+		var cfg config.ModelConfig
+		Expect(yaml.Unmarshal([]byte(file), &cfg)).To(Succeed())
+		appConfig := config.NewApplicationConfig(config.WithSystemState(&system.SystemState{}))
+		return model.NewOptions(ModelOptions(cfg, appConfig)...)
+	}
+
+	It("carries `park: true` to the load, and nothing where the file does not say it", func() {
+		Expect(options("name: m\npark: true\n").Parks()).To(BeTrue())
+		Expect(options("name: m\npark: false\n").Parks()).To(BeFalse())
+		Expect(options("name: m\n").Parks()).To(BeFalse(), "nothing parks by default")
+	})
+})
+
+var _ = Describe("mapEmbeddingGRPCError", func() {
+	It("passes a refusal of the moment on as it is: the same code, another fact", func() {
+		refusal := status.Error(codes.ResourceExhausted, "no_room_on_device: the context cannot be created now")
+		mapped := mapEmbeddingGRPCError(refusal)
+		message, noRoom := model.NoRoomOnDevice(mapped)
+		Expect(noRoom).To(BeTrue())
+		Expect(message).To(Equal("the context cannot be created now"))
+		Expect(mapped.Error()).NotTo(ContainSubstring("conversation too long"))
+	})
+
+	It("still says a message over the size limit is a conversation too long", func() {
+		mapped := mapEmbeddingGRPCError(status.Error(codes.ResourceExhausted, "grpc: received message larger than max (60000000 vs. 52428800)"))
+		Expect(mapped.Error()).To(ContainSubstring("conversation too long"))
+		_, noRoom := model.NoRoomOnDevice(mapped)
+		Expect(noRoom).To(BeFalse())
+	})
+})

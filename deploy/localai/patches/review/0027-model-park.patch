@@ -0,0 +1,170 @@
+package localai_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+
+	"github.com/labstack/echo/v4"
+	"github.com/mudler/LocalAI/core/config"
+	"github.com/mudler/LocalAI/core/http/endpoints/localai"
+	"github.com/mudler/LocalAI/core/services/monitoring"
+	grpcPkg "github.com/mudler/LocalAI/pkg/grpc"
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/model"
+	"github.com/mudler/LocalAI/pkg/system"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	ggrpc "google.golang.org/grpc"
+)
+
+// parkingBackend is a backend that parks. Embedding leaves any other call as
+// a panic rather than a network call.
+type parkingBackend struct {
+	grpcPkg.Backend
+	busy       bool
+	parkSize   uint64
+	parks      int
+	freeAnswer string // what Free answers with; "parked" when empty
+	loadErr    error  // what the return's LoadModel fails with
+}
+
+func (b *parkingBackend) HealthCheck(context.Context) (bool, error) { return true, nil }
+func (b *parkingBackend) IsBusy() bool                              { return b.busy }
+func (b *parkingBackend) Free(context.Context) error                { return nil }
+func (b *parkingBackend) Status(context.Context) (*pb.StatusResponse, error) {
+	return &pb.StatusResponse{Memory: &pb.MemoryUsageData{Breakdown: map[string]uint64{"park_size": b.parkSize}}}, nil
+}
+func (b *parkingBackend) FreeResult(context.Context) (*pb.Result, error) {
+	b.parks++
+	answer := b.freeAnswer
+	if answer == "" {
+		answer = "parked"
+	}
+	return &pb.Result{Success: true, Message: answer}, nil
+}
+func (b *parkingBackend) LoadModel(context.Context, *pb.ModelOptions, ...ggrpc.CallOption) (*pb.Result, error) {
+	if b.loadErr != nil {
+		return nil, b.loadErr
+	}
+	return &pb.Result{Success: true, Message: "Model already loaded"}, nil
+}
+
+var _ = Describe("POST /backend/park", func() {
+	var (
+		ml      *model.ModelLoader
+		backend *parkingBackend
+		loaded  *model.Model
+		floor   uint64
+		host    uint64
+	)
+
+	post := func(body string) (int, map[string]any) {
+		GinkgoHelper()
+		path, err := os.MkdirTemp("", "backend-park-")
+		Expect(err).NotTo(HaveOccurred())
+		DeferCleanup(os.RemoveAll, path)
+		service := monitoring.NewBackendMonitorService(ml, config.NewModelConfigLoader(path), &config.ApplicationConfig{})
+		app := echo.New()
+		app.POST("/backend/park", localai.BackendParkEndpoint(service))
+		req := httptest.NewRequest(http.MethodPost, "/backend/park", strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		rec := httptest.NewRecorder()
+		app.ServeHTTP(rec, req)
+		var answer map[string]any
+		Expect(json.Unmarshal(rec.Body.Bytes(), &answer)).To(Succeed(), rec.Body.String())
+		return rec.Code, answer
+	}
+	errorOf := func(answer map[string]any) (string, string) {
+		GinkgoHelper()
+		e := answer["error"].(map[string]any)
+		return e["type"].(string), e["message"].(string)
+	}
+
+	BeforeEach(func() {
+		backend = &parkingBackend{parkSize: 6 << 30}
+		ml = model.NewModelLoader(&system.SystemState{})
+		store := model.NewInMemoryModelStore()
+		loaded = model.NewModelWithClient("madlad", "addr", backend)
+		loaded.SetParks(true)
+		store.Set("madlad", loaded)
+		ml.SetModelStore(store)
+		floor, host = 8<<30, 64<<30
+		ml.SetParkHostFloorSource(func() uint64 { return floor })
+		ml.SetHostAvailableMemorySource(func() (uint64, error) { return host, nil })
+	})
+
+	It("parks the model and says what went to the host and what its return takes", func() {
+		code, answer := post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusOK))
+		Expect(answer["message"]).To(Equal("model parked"))
+		parked := answer["parked"].(map[string]any)
+		Expect(parked["size_host"]).To(BeEquivalentTo(6 << 30))
+		Expect(parked["size_vram_needed"]).To(BeEquivalentTo(6 << 30))
+		Expect(backend.parks).To(Equal(1))
+		Expect(loaded.ParkedState().Parked).To(BeTrue())
+
+		// asked again: the same answer, nothing done twice
+		code, _ = post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusOK))
+		Expect(backend.parks).To(Equal(1))
+	})
+
+	It("answers 409 model_busy for a busy model, and leaves it loaded: the caller takes another", func() {
+		backend.busy = true
+		code, answer := post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusConflict))
+		errType, message := errorOf(answer)
+		Expect(errType).To(Equal("model_busy"))
+		Expect(message).To(ContainSubstring("madlad"))
+		Expect(backend.parks).To(BeZero())
+		Expect(ml.CheckIsLoaded("madlad")).NotTo(BeNil())
+	})
+
+	It("answers 412 with the reason the model is not parked: the caller stops it instead, if room is still wanted", func() {
+		host = floor + (6 << 30) - 1
+		code, answer := post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusPreconditionFailed))
+		errType, _ := errorOf(answer)
+		Expect(errType).To(Equal("host_memory_floor"))
+
+		floor = 0
+		code, answer = post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusPreconditionFailed))
+		errType, _ = errorOf(answer)
+		Expect(errType).To(Equal("parking_off"))
+
+		floor = 8 << 30
+		loaded.SetParks(false)
+		code, answer = post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusPreconditionFailed))
+		errType, _ = errorOf(answer)
+		Expect(errType).To(Equal("cannot_park"))
+
+		Expect(backend.parks).To(BeZero())
+		Expect(ml.CheckIsLoaded("madlad")).NotTo(BeNil(), "it is never stopped by a park that did not happen")
+	})
+
+	It("answers 404 with its own type for a model that is not loaded: a server without this route answers 404 too, with none", func() {
+		code, answer := post(`{"model":"another"}`)
+		Expect(code).To(Equal(http.StatusNotFound))
+		errType, message := errorOf(answer)
+		Expect(errType).To(Equal("model_not_loaded"))
+		Expect(message).To(ContainSubstring("another"))
+		code, _ = post(`{}`)
+		Expect(code).To(Equal(http.StatusBadRequest))
+	})
+
+	It("answers 500 model_stopped when the backend broke the park: the one model it stops, and the answer says so", func() {
+		backend.freeAnswer = "freed" // it released the model instead of parking it
+		code, answer := post(`{"model":"madlad"}`)
+		Expect(code).To(Equal(http.StatusInternalServerError))
+		errType, message := errorOf(answer)
+		Expect(errType).To(Equal("model_stopped"))
+		Expect(message).To(ContainSubstring("madlad"))
+		Expect(ml.CheckIsLoaded("madlad")).To(BeNil(), "the device is free; the model is not loaded")
+	})
+})

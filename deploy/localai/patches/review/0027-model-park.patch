+var _ = Describe("chooseAllocatableMemory", func() {
+	const gi = uint64(1) << 30
+
+	It("is the host's available memory where no cgroup limits it", func() {
+		Expect(chooseAllocatableMemory(40*gi, "max\n", "123\n", "inactive_file 0\n", "", "", "")).To(Equal(40 * gi))
+		Expect(chooseAllocatableMemory(40*gi, "", "", "", "9223372036854771712\n", "5\n", "")).To(Equal(40 * gi))
+		Expect(chooseAllocatableMemory(40*gi, "", "", "", "", "", "")).To(Equal(40 * gi))
+	})
+
+	It("is what a container's limit still allows, not what the host could give", func() {
+		// 24 GiB allowed, 20 GiB in use: 4 GiB, though the host has 40 available
+		Expect(chooseAllocatableMemory(40*gi, itoa(24*gi)+"\n", itoa(20*gi)+"\n", "anon 1\ninactive_file 0\n", "", "", "")).To(Equal(4 * gi))
+		// cgroup v1 says the same with its own names
+		Expect(chooseAllocatableMemory(40*gi, "", "", "", itoa(24*gi)+"\n", itoa(20*gi)+"\n", "total_inactive_file 0\n")).To(Equal(4 * gi))
+	})
+
+	It("does not count the file cache the kernel drops before it refuses anything", func() {
+		stat := "anon 5\ninactive_file " + itoa(6*gi) + "\nactive_file 7\n"
+		Expect(chooseAllocatableMemory(40*gi, itoa(24*gi)+"\n", itoa(20*gi)+"\n", stat, "", "", "")).To(Equal(10 * gi))
+	})
+
+	It("is the host's figure when that is the smaller one", func() {
+		Expect(chooseAllocatableMemory(2*gi, itoa(24*gi)+"\n", itoa(4*gi)+"\n", "", "", "", "")).To(Equal(2 * gi))
+	})
+
+	It("is nothing in a cgroup that is at its limit", func() {
+		Expect(chooseAllocatableMemory(40*gi, itoa(24*gi)+"\n", itoa(25*gi)+"\n", "", "", "", "")).To(BeZero())
+	})
+

diff --git a/core/http/endpoints/localai/backend_monitor.go b/core/http/endpoints/localai/backend_monitor.go
index c60e92a..45127fb 100644
--- a/core/http/endpoints/localai/backend_monitor.go
+++ b/core/http/endpoints/localai/backend_monitor.go
@@ -76,3 +76,77 @@ func BackendShutdownEndpoint(bm *monitoring.BackendMonitorService) echo.HandlerF
 		return c.JSON(http.StatusOK, map[string]string{"message": "model stopped"})
 	}
 }
+
+// The types of the errors /backend/park answers with: each tells its caller
+// what to do next.
+const (
+	parkErrorNotLoaded  = "model_not_loaded"  // 404: nothing to park. A server without this route answers 404 too, with no such type
+	parkErrorBusy       = "model_busy"        // 409: take another model; this one is not stopped for being busy
+	parkErrorCannotPark = "cannot_park"       // 412: stop it instead, if room is still wanted
+	parkErrorOff        = "parking_off"       // 412: no host memory floor is set
+	parkErrorHostFloor  = "host_memory_floor" // 412: the host has no room for its weights now
+	parkErrorStopped    = "model_stopped"     // 500: its backend broke the park and was stopped; the device is free, the model is not loaded
+)
+
+// BackendParkEndpoint parks a loaded model: its weights leave the device and
+// stay in host memory, its backend process stays. /backend/load, or any
+// request, brings it back. It waits for nothing but the park itself - not
+// for a busy model, and not behind a load, a return or a stop of the same
+// model that is running: each is 409 model_busy, at once. It never stops a
+// model that works: when the model is not parked the answer says why, and
+// the caller decides - another model, or /backend/shutdown. The one model it
+// stops is one whose backend broke the park (Free answered without parking,
+// or did not answer in a minute): 500 model_stopped.
+// @Summary Backend park
+// @Tags monitoring
+// @Param request body schema.BackendMonitorRequest true "Backend park request"
+// @Success 200 {object} schema.BackendParkResponse "Parked"
+// @Failure 404 {object} schema.ErrorResponse "The model is not loaded"
+// @Failure 409 {object} schema.ErrorResponse "The model is busy"
+// @Failure 412 {object} schema.ErrorResponse "The model cannot be parked now"
+// @Failure 500 {object} schema.ErrorResponse "Its backend broke the park and was stopped (type model_stopped), or the park failed"
+// @Router /backend/park [post]
+func BackendParkEndpoint(bm *monitoring.BackendMonitorService) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		input := new(schema.BackendMonitorRequest)
+		if err := c.Bind(input); err != nil {
+			return err
+		}
+		if input.Model == "" {
+			return echo.NewHTTPError(http.StatusBadRequest, "model is required")
+		}
+
+		refuse := func(code int, errType string, err error) error {
+			return c.JSON(code, schema.ErrorResponse{
+				Error: &schema.APIError{Message: fmt.Sprintf("model %q: %s", input.Model, err.Error()), Code: code, Type: errType},
+			})
+		}
+
+		state, err := bm.ParkModel(c.Request().Context(), input.Model)
+		switch {
+		case err == nil:
+			return c.JSON(http.StatusOK, schema.BackendParkResponse{
+				Message: "model parked",
+				Parked:  schema.SysInfoParked{SizeHost: state.Size, SizeVRAMNeeded: state.Size, Since: state.Since},
+			})
+		case errors.Is(err, model.ErrModelNotFound):
+			// Written here, not through the error handler, which answers
+			// every 404 "Resource not found": the caller must tell a model
+			// that is not loaded from a server that has no such route.
+			return refuse(http.StatusNotFound, parkErrorNotLoaded, errors.New("not loaded on this instance"))
+		case errors.Is(err, model.ErrModelBusy):
+			return refuse(http.StatusConflict, parkErrorBusy, err)
+		case errors.Is(err, model.ErrParkingOff):
+			return refuse(http.StatusPreconditionFailed, parkErrorOff, err)
+		case errors.Is(err, model.ErrParkHostFloor):
+			return refuse(http.StatusPreconditionFailed, parkErrorHostFloor, err)
+		case errors.Is(err, model.ErrModelCannotPark):
+			return refuse(http.StatusPreconditionFailed, parkErrorCannotPark, err)
+		case errors.Is(err, model.ErrParkStoppedModel):
+			xlog.Warn("A model's park stopped it", "model", input.Model, "error", err)
+			return refuse(http.StatusInternalServerError, parkErrorStopped, err)
+		}
+		xlog.Error("Failed to park model", "model", input.Model, "error", err)
+		return err
+	}
+}

diff --git a/pkg/model/park.go b/pkg/model/park.go
new file mode 100644
index 0000000..8708a5f
--- /dev/null
+++ b/pkg/model/park.go
@@ -0,0 +1,318 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/xsysinfo"
+	"github.com/mudler/xlog"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// Parking: a third state between loaded and stopped.
+//
+// A backend that can PARK a model answers the Free RPC by moving the model's
+// weights from the device to host memory and keeping everything else: its
+// process, its tokenizer, whatever it validated at the load. A LoadModel for
+// the model it already holds, with the options of its load, brings them
+// back. Where this loader would stop a model to make room, it parks one that
+// can park: coming back then costs a copy of the weights instead of a load.
+//
+// Three things must hold for a model to be parked:
+//   - its file says so (`park: true`): a model that parks is never sent Free
+//     on its way to being stopped, since for it Free is not a prelude to a
+//     kill;
+//   - the host's floor is set (SetParkHostFloorSource): parked weights are
+//     host memory, and the host is not what it was an hour ago, so the room
+//     is read before EACH park. Unset, nothing is parked;
+//   - its backend answers Status with what parking would move ("park_size"),
+//     and Free with success and the message "parked".
+// Anything else and the model is stopped, as it always was.
+
+var (
+	// ErrModelCannotPark: the model is stopped as before - its file does not
+	// say `park: true`, or its backend does not park.
+	ErrModelCannotPark = errors.New("model cannot be parked")
+	// ErrParkingOff: no host memory floor is set, so nothing is parked.
+	ErrParkingOff = errors.New("parking is off: no host memory floor is set")
+	// ErrParkHostFloor: parking this model now would leave the host under
+	// its memory floor.
+	ErrParkHostFloor = errors.New("parking would leave the host under its memory floor")
+)
+
+const (
+	// parkedMessage is what a backend answers Free with when it parked the
+	// model, or found it parked.
+	parkedMessage = "parked"
+	// parkSizeKey is where a backend's Status says how many bytes parking
+	// would move to the host - what the device must have room for when they
+	// come back.
+	parkSizeKey = "park_size"
+	// NoRoomOnDeviceType is the type of a refusal of the moment: the device
+	// had no memory - for parked weights to come back, for a context, for a
+	// graph. Nothing is wrong with the request or the model.
+	NoRoomOnDeviceType = "no_room_on_device"
+
+	parkStatusTimeout = 5 * time.Second
+	parkTimeout       = 60 * time.Second
+	unparkTimeout     = 60 * time.Second
+)
+
+// NoRoomOnDeviceError is a request, or a model's return, that the device
+// had no room for at that moment. The HTTP layer answers it 503 with a
+// Retry-After and the type NoRoomOnDeviceType: a deferral, not a fault.
+type NoRoomOnDeviceError struct {
+	Model   string
+	Message string
+}
+
+func (e *NoRoomOnDeviceError) Error() string {
+	if e.Model == "" {
+		return e.Message
+	}
+	return e.Model + ": " + e.Message
+}
+
+// NoRoomOnDevice tells a refusal of the moment from every other error, and
+// returns its message. A backend says it with the gRPC code ResourceExhausted
+// AND the type at the head of its message, "no_room_on_device: ...": the
+// code alone has other meanings on this wire - a stream that is busy, a
+// message over the size limit, a rate-limited upstream.
+func NoRoomOnDevice(err error) (message string, ok bool) {
+	var typed *NoRoomOnDeviceError
+	if errors.As(err, &typed) {
+		return typed.Message, true
+	}
+	var st interface{ GRPCStatus() *status.Status }
+	if !errors.As(err, &st) || st.GRPCStatus().Code() != codes.ResourceExhausted {
+		return "", false
+	}
+	return strings.CutPrefix(st.GRPCStatus().Message(), NoRoomOnDeviceType+": ")
+}
+
+// SetParkHostFloorSource sets where the host's floor for parking is read:
+// the bytes that must stay available on the host once a model's weights are
+// parked there. It is read at each park, so a caller that changes the floor
+// - it differs with what the node is doing - is followed at once. A source
+// that returns 0, and no source, mean nothing is parked.
+func (ml *ModelLoader) SetParkHostFloorSource(floor func() uint64) {
+	ml.mu.Lock()
+	defer ml.mu.Unlock()
+	ml.parkHostFloor = floor
+}
+
+// SetHostAvailableMemorySource replaces how the host's available memory is
+// read (xsysinfo's MemAvailable, by default).
+func (ml *ModelLoader) SetHostAvailableMemorySource(available func() (uint64, error)) {
+	ml.mu.Lock()
+	defer ml.mu.Unlock()
+	ml.hostAvailable = available
+}
+
+func hostAvailableMemory() (uint64, error) {
+	info, err := xsysinfo.GetSystemRAMInfo()
+	if err != nil {
+		return 0, err
+	}
+	return info.Available, nil
+}
+
+// ParkModel parks a loaded model: its weights leave the device, its process
+// stays. It never waits for a busy model and never stops one: every reason
+// it does not park is an error the caller acts on - ErrModelBusy (take
+// another), ErrModelCannotPark, ErrParkingOff, ErrParkHostFloor (stop it
+// instead, if room is still wanted). A model that is already parked is left
+// as it is.
+func (ml *ModelLoader) ParkModel(ctx context.Context, modelName string) (ParkedState, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	release, err := ml.operations.acquireContext(ctx, modelName, true)
+	if err != nil {
+		return ParkedState{}, fmt.Errorf("waiting to park model %q: %w", modelName, err)
+	}
+	defer release()
+	return ml.park(ctx, modelName, "")
+}
+
+// ParkModelAtAddress is ParkModel for an eviction the watchdog chose: the
+// address it selected must still be the model's. It reports whether the
+// model is now parked.
+func (ml *ModelLoader) ParkModelAtAddress(modelName, address string) (bool, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), parkTimeout+parkStatusTimeout)
+	defer cancel()
+	release, err := ml.operations.acquireContext(ctx, modelName, true)
+	if err != nil {
+		return false, fmt.Errorf("waiting to park model %q: %w", modelName, err)
+	}
+	defer release()
+	_, err = ml.park(ctx, modelName, address)
+	return err == nil, err
+}
+
+// park runs under the model's exclusive lifecycle lock.
+func (ml *ModelLoader) park(ctx context.Context, modelName, address string) (ParkedState, error) {
+	ml.mu.Lock()
+	store := ml.store
+	wd := ml.wd
+	floorOf := ml.parkHostFloor
+	available := ml.hostAvailable
+	ml.mu.Unlock()
+
+	m, ok := store.Get(modelName)
+	if !ok || (address != "" && m.address != address) {
+		return ParkedState{}, ErrModelNotFound
+	}
+	if state := m.ParkedState(); state.Parked {
+		return state, nil
+	}
+	if !m.Parks() {
+		return ParkedState{}, fmt.Errorf("%w: its file does not say `park: true`", ErrModelCannotPark)
+	}
+	var floor uint64
+	if floorOf != nil {
+		floor = floorOf()
+	}
+	if floor == 0 {
+		return ParkedState{}, ErrParkingOff
+	}
+
+	client := m.GRPC(false, wd)
+	parker, ok := client.(interface {
+		FreeResult(context.Context) (*pb.Result, error)
+	})
+	if !ok {
+		return ParkedState{}, fmt.Errorf("%w: it is not served by a backend process of this instance", ErrModelCannotPark)
+	}
+	if client.IsBusy() {
+		return ParkedState{}, ErrModelBusy
+	}
+
+	// What parking would move to the host: the backend says. One that has no
+	// such answer does not park.
+	statusCtx, cancel := context.WithTimeout(ctx, parkStatusTimeout)
+	backendStatus, err := client.Status(statusCtx)
+	cancel()
+	if err != nil {
+		if status.Code(err) == codes.Unimplemented {
+			return ParkedState{}, fmt.Errorf("%w: its backend does not park", ErrModelCannotPark)
+		}
+		return ParkedState{}, fmt.Errorf("asking model %q what parking it would move: %w", modelName, err)
+	}
+	size := backendStatus.GetMemory().GetBreakdown()[parkSizeKey]
+	if size == 0 {
+		return ParkedState{}, fmt.Errorf("%w: its backend names no bytes to park", ErrModelCannotPark)
+	}
+
+	// The host, now. Not an hour ago, and not a budget: what is available at
+	// this moment, less what would be copied into it, against the floor.
+	if available == nil {
+		available = hostAvailableMemory
+	}
+	free, err := available()
+	if err != nil {
+		return ParkedState{}, fmt.Errorf("%w: the host's memory could not be read (%v)", ErrParkHostFloor, err)
+	}
+	if free < size || free-size < floor {
+		return ParkedState{}, fmt.Errorf("%w: %d MiB available, %d MiB to park, a floor of %d MiB",
+			ErrParkHostFloor, free>>20, size>>20, floor>>20)
+	}
+
+	freeCtx, cancel := context.WithTimeout(ctx, parkTimeout)
+	res, err := parker.FreeResult(freeCtx)
+	cancel()
+	if err != nil {
+		switch status.Code(err) {
+		case codes.Unimplemented:
+			return ParkedState{}, fmt.Errorf("%w: its backend does not park", ErrModelCannotPark)
+		case codes.FailedPrecondition:
+			// a request reached it between the busy check and the park: not
+			// now. It is never stopped for that.
+			return ParkedState{}, fmt.Errorf("%w: %s", ErrModelBusy, status.Convert(err).Message())
+		}
+		return ParkedState{}, fmt.Errorf("parking model %q: %w", modelName, err)
+	}
+	if !res.GetSuccess() || res.GetMessage() != parkedMessage {
+		// A Free that succeeded without parking freed something this loader
+		// cannot bring back with a LoadModel: the process is no longer one
+		// to send requests to. It is stopped, as the stop path would have
+		// done after its own Free.
+		xlog.Warn("Free did not park the model; stopping it", "model", modelName, "answer", res.GetMessage())
+		if stopErr := ml.deleteProcess(ctx, modelName, true); stopErr != nil {
+			xlog.Error("stopping a model whose Free did not park it", "model", modelName, "error", stopErr)
+		}
+		return ParkedState{}, fmt.Errorf("%w: its backend answered Free with %q and was stopped", ErrModelCannotPark, res.GetMessage())
+	}
+
+	m.markParked(size, time.Now())
+	if wd != nil {
+		// Not one of the loaded models any more: not counted against the
+		// limit of loaded models, not an eviction candidate, not idle- or
+		// busy-checked. It is registered again when it comes back.
+		wd.Untrack(m.address)
+	}
+	xlog.Info("Model parked", "model", modelName, "bytes", size)
+	return m.ParkedState(), nil
+}
+
+// unpark brings a parked model's weights back to the device, with a
+// LoadModel that carries the options of its load. A model that is not
+// parked is left alone. If the device has no room the model stays parked
+// and the error is a *NoRoomOnDeviceError.
+func (ml *ModelLoader) unpark(ctx context.Context, m *Model) error {
+	if !m.ParkedState().Parked {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	release, err := ml.operations.acquireContext(ctx, m.ID, true)
+	if err != nil {
+		return fmt.Errorf("waiting to bring model %q back: %w", m.ID, err)
+	}
+	defer release()
+	if !m.ParkedState().Parked {
+		return nil // another request brought it back meanwhile
+	}
+
+	ml.mu.Lock()
+	wd := ml.wd
+	ml.mu.Unlock()
+
+	opts := m.LoadOptions()
+	if opts == nil {
+		return fmt.Errorf("model %q is parked and the options of its load are not held", m.ID)
+	}
+	loadCtx, cancel := context.WithTimeout(ctx, unparkTimeout)
+	res, err := m.GRPC(false, wd).LoadModel(loadCtx, opts)
+	cancel()
+	if err != nil {
+		if message, noRoom := NoRoomOnDevice(err); noRoom {
+			return &NoRoomOnDeviceError{Model: m.ID, Message: message}
+		}
+		return fmt.Errorf("bringing model %q back to the device: %w", m.ID, err)
+	}
+	if !res.GetSuccess() {
+		return fmt.Errorf("bringing model %q back to the device: %s", m.ID, res.GetMessage())
+	}
+
+	m.markUnparked()
+	if wd != nil {
+		// one of the loaded models again
+		if p := m.Process(); p != nil {
+			wd.Add(m.address, p)
+		}
+		wd.AddAddressModelMap(m.address, m.ID)
+		if size := m.sizeEstimate(); size > 0 {
+			wd.RegisterModelSize(m.ID, size)
+		}
+		wd.UpdateLastUsed(m.address)
+	}
+	xlog.Info("Model back on the device", "model", m.ID)
+	return nil
+}
diff --git a/pkg/model/park_internal_test.go b/pkg/model/park_internal_test.go
new file mode 100644
index 0000000..a0f2a56
--- /dev/null
+++ b/pkg/model/park_internal_test.go
@@ -0,0 +1,304 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/mudler/LocalAI/pkg/grpc"
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/system"
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	ggrpc "google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+)
+
+// parkBackend is a backend that parks: what the loader asks of it, counted.
+// Embedding leaves any other call as a panic rather than a network call.
+type parkBackend struct {
+	grpc.Backend
+	busy       bool
+	parkSize   uint64
+	statusErr  error
+	freeResult *pb.Result
+	freeErr    error
+	loadResult *pb.Result
+	loadErr    error
+
+	statuses, parks, plainFrees, loads int
+	loadedWith                         *pb.ModelOptions
+}
+
+func newParkBackend() *parkBackend {
+	return &parkBackend{
+		parkSize:   6 << 30,
+		freeResult: &pb.Result{Success: true, Message: "parked"},
+		loadResult: &pb.Result{Success: true, Message: "Model already loaded"},
+	}
+}
+
+func (b *parkBackend) HealthCheck(context.Context) (bool, error) { return true, nil }
+func (b *parkBackend) IsBusy() bool                              { return b.busy }
+func (b *parkBackend) Status(context.Context) (*pb.StatusResponse, error) {
+	b.statuses++
+	if b.statusErr != nil {
+		return nil, b.statusErr
+	}
+	return &pb.StatusResponse{Memory: &pb.MemoryUsageData{Total: 1 << 40, Breakdown: map[string]uint64{"park_size": b.parkSize}}}, nil
+}
+func (b *parkBackend) FreeResult(context.Context) (*pb.Result, error) {
+	b.parks++
+	return b.freeResult, b.freeErr
+}
+func (b *parkBackend) Free(context.Context) error {
+	b.plainFrees++
+	return nil
+}
+func (b *parkBackend) LoadModel(_ context.Context, in *pb.ModelOptions, _ ...ggrpc.CallOption) (*pb.Result, error) {
+	b.loads++
+	b.loadedWith = in
+	return b.loadResult, b.loadErr
+}
+
+var _ = Describe("Parking", func() {
+	const (
+		floor = uint64(8 << 30)
+		gib   = uint64(1 << 30)
+	)
+	var (
+		ml      *ModelLoader
+		backend *parkBackend
+		m       *Model
+		host    uint64
+		options = &pb.ModelOptions{Model: "m", ModelFile: "m.gguf", ContextSize: 512, Options: []string{"context_on_demand:true"}}
+	)
+
+	BeforeEach(func() {
+		ml = NewModelLoader(&system.SystemState{})
+		backend = newParkBackend()
+		m = NewModelWithClient("m", "addr", backend)
+		m.MarkHealthy()
+		m.SetParks(true)
+		m.SetLoadOptions(options)
+		ml.store.Set("m", m)
+		host = 64 * gib
+		ml.SetParkHostFloorSource(func() uint64 { return floor })
+		ml.SetHostAvailableMemorySource(func() (uint64, error) { return host, nil })
+	})
+
+	Describe("ParkModel", func() {
+		It("parks a model that can park, and says how much went to the host", func() {
+			state, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+			Expect(state.Parked).To(BeTrue())
+			Expect(state.Size).To(Equal(6 * gib))
+			Expect(state.Since).To(BeTemporally("~", time.Now(), 5*time.Second))
+			Expect(backend.parks).To(Equal(1))
+			Expect(m.ParkedState().Parked).To(BeTrue())
+		})
+
+		It("leaves a parked model as it is: nothing is asked twice", func() {
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+			first := m.ParkedState()
+			state, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+			Expect(state).To(Equal(first))
+			Expect(backend.parks).To(Equal(1))
+			Expect(backend.statuses).To(Equal(1))
+		})
+
+		It("does not park a model whose file does not say so", func() {
+			m.SetParks(false)
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelCannotPark))
+			Expect(backend.parks + backend.statuses).To(BeZero())
+		})
+
+		It("parks nothing while no host floor is set", func() {
+			ml.SetParkHostFloorSource(func() uint64 { return 0 })
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrParkingOff))
+			ml.SetParkHostFloorSource(nil)
+			_, err = ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrParkingOff))
+			Expect(backend.parks + backend.statuses).To(BeZero())
+		})
+
+		It("never waits for a busy model and never stops one", func() {
+			backend.busy = true
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelBusy))
+			Expect(backend.parks).To(BeZero())
+			_, still := ml.store.Get("m")
+			Expect(still).To(BeTrue())
+		})
+
+		It("takes a request that reached the backend between the check and the park for busy, not for a reason to stop it", func() {
+			backend.freeResult, backend.freeErr = nil, status.Error(codes.FailedPrecondition, "busy: a request is running, the model stays on the device")
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelBusy))
+			Expect(m.ParkedState().Parked).To(BeFalse())
+			_, still := ml.store.Get("m")
+			Expect(still).To(BeTrue())
+		})
+
+		It("reads the host before EACH park: the weights must fit above the floor at that moment", func() {
+			host = floor + 6*gib - 1
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrParkHostFloor))
+			Expect(backend.parks).To(BeZero(), "the backend is not asked to copy what the host cannot hold")
+
+			host = floor + 6*gib
+			_, err = ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+			Expect(backend.parks).To(Equal(1))
+		})
+
+		It("does not park blind when the host's memory cannot be read", func() {
+			ml.SetHostAvailableMemorySource(func() (uint64, error) { return 0, errors.New("no /proc") })
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrParkHostFloor))
+			Expect(backend.parks).To(BeZero())
+		})
+
+		It("does not park a model whose backend does not park", func() {
+			backend.statusErr = status.Error(codes.Unimplemented, "llama-cpp: no status for a model that cannot park")
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelCannotPark))
+			Expect(backend.parks).To(BeZero())
+
+			backend.statusErr = nil
+			backend.freeResult, backend.freeErr = nil, status.Error(codes.Unimplemented, "cannot park")
+			_, err = ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelCannotPark))
+			Expect(m.ParkedState().Parked).To(BeFalse())
+		})
+
+		It("stops a model whose Free succeeded without parking: nothing can bring back what it freed", func() {
+			backend.freeResult = &pb.Result{Success: true, Message: "freed"}
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).To(MatchError(ErrModelCannotPark))
+			_, still := ml.store.Get("m")
+			Expect(still).To(BeFalse())
+		})
+
+		It("says a model that is not loaded is not loaded", func() {
+			_, err := ml.ParkModel(context.Background(), "another")
+			Expect(err).To(MatchError(ErrModelNotFound))
+		})
+	})
+
+	Describe("the return", func() {
+		BeforeEach(func() {
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+		})
+
+		It("brings a parked model back before the request goes, with the options of its load", func() {
+			client, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).NotTo(HaveOccurred())
+			Expect(client).NotTo(BeNil())
+			Expect(backend.loads).To(Equal(1))
+			Expect(proto.Equal(backend.loadedWith, options)).To(BeTrue(), "the backend answers \"already loaded\" only to the options of the load")
+			Expect(m.ParkedState().Parked).To(BeFalse())
+		})
+
+		It("sends no LoadModel for a model that is not parked", func() {
+			_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).NotTo(HaveOccurred())
+			_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).NotTo(HaveOccurred())
+			Expect(backend.loads).To(Equal(1))
+		})
+
+		It("refuses the request as a deferral when the device has no room, and leaves the model parked", func() {
+			backend.loadResult, backend.loadErr = nil, status.Error(codes.ResourceExhausted, "no_room_on_device: the weights cannot come back to the device now")
+			_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+			var noRoom *NoRoomOnDeviceError
+			Expect(errors.As(err, &noRoom)).To(BeTrue())
+			Expect(noRoom.Model).To(Equal("m"))
+			Expect(noRoom.Message).To(Equal("the weights cannot come back to the device now"))
+			Expect(m.ParkedState().Parked).To(BeTrue())
+
+			backend.loadResult, backend.loadErr = &pb.Result{Success: true, Message: "Model already loaded"}, nil
+			_, err = ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).NotTo(HaveOccurred())
+			Expect(m.ParkedState().Parked).To(BeFalse())
+		})
+
+		It("does not take a return that FAILED for a refusal: it is a fault, and the model stays parked", func() {
+			backend.loadResult, backend.loadErr = nil, status.Error(codes.Internal, "the weights could not be brought back to the device: a failure, not a refusal")
+			_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).To(HaveOccurred())
+			_, noRoom := NoRoomOnDevice(err)
+			Expect(noRoom).To(BeFalse())
+			Expect(m.ParkedState().Parked).To(BeTrue())
+		})
+
+		It("does not take a backend that holds the model under other options for a return", func() {
+			backend.loadResult, backend.loadErr = nil, status.Error(codes.FailedPrecondition, "this process holds model \"m\" under other options than these")
+			_, err := ml.Load(WithContext(context.Background()), WithModelID("m"))
+			Expect(err).To(HaveOccurred())
+			Expect(m.ParkedState().Parked).To(BeTrue())
+		})
+	})
+
+	Describe("the stop", func() {
+		It("does not send Free to a model that parks: for it Free is not the prelude to a stop", func() {
+			Expect(ml.ShutdownModel("m")).To(Succeed())
+			Expect(backend.plainFrees + backend.parks).To(BeZero())
+			_, still := ml.store.Get("m")
+			Expect(still).To(BeFalse())
+		})
+
+		It("stops a parked model without bringing it back", func() {
+			_, err := ml.ParkModel(context.Background(), "m")
+			Expect(err).NotTo(HaveOccurred())
+			Expect(ml.ShutdownModel("m")).To(Succeed())
+			Expect(backend.loads + backend.plainFrees).To(BeZero())
+		})
+
+		It("still sends Free to a model that does not park, as before", func() {
+			m.SetParks(false)
+			Expect(ml.ShutdownModel("m")).To(Succeed())
+			Expect(backend.plainFrees).To(Equal(1))
+		})
+	})
+
+	Describe("NoRoomOnDevice", func() {
+		It("is the code AND the head of the message: the code alone has other meanings on this wire", func() {
+			message, ok := NoRoomOnDevice(status.Error(codes.ResourceExhausted, "no_room_on_device: the context cannot be created now"))
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("the context cannot be created now"))
+
+			for _, other := range []error{
+				status.Error(codes.ResourceExhausted, "backend is busy"),
+				status.Error(codes.ResourceExhausted, "grpc: received message larger than max"),
+				status.Error(codes.Internal, "no_room_on_device: said under another code"),
+				status.Error(codes.ResourceExhausted, "it said no_room_on_device: somewhere inside"),
+				errors.New("no_room_on_device: not a status at all"),
+				nil,
+			} {
+				_, ok := NoRoomOnDevice(other)
+				Expect(ok).To(BeFalse(), fmt.Sprint(other))
+			}
+		})
+
+		It("is found under what callers wrap it in", func() {
+			wrapped := fmt.Errorf("conversation too long for per-token embeddings: %w",
+				fmt.Errorf("predict: %w", status.Error(codes.ResourceExhausted, "no_room_on_device: Compute error")))
+			message, ok := NoRoomOnDevice(wrapped)
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("Compute error"))
+
+			message, ok = NoRoomOnDevice(fmt.Errorf("loading: %w", &NoRoomOnDeviceError{Model: "m", Message: "the weights cannot come back"}))
+			Expect(ok).To(BeTrue())
+			Expect(message).To(Equal("the weights cannot come back"))
+		})
+	})
+})

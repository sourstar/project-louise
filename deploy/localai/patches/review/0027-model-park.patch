 	l.mu.Lock()
 	entry.refs--
diff --git a/pkg/model/park.go b/pkg/model/park.go
new file mode 100644
index 0000000..290ce6e
--- /dev/null
+++ b/pkg/model/park.go
@@ -0,0 +1,455 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	pb "github.com/mudler/LocalAI/pkg/grpc/proto"
+	"github.com/mudler/LocalAI/pkg/xsysinfo"
+	"github.com/mudler/xlog"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// Parking: a third state between loaded and stopped.
+//
+// A backend that can PARK a model answers the Free RPC by moving the model's
+// weights from the device to host memory and keeping everything else: its
+// process, its tokenizer, whatever it validated at the load. A LoadModel for
+// the model it already holds, with the options of its load, brings them
+// back. Where this loader would stop a model to make room, it parks one that
+// can park: coming back then costs a copy of the weights instead of a load.
+//
+// Three things must hold for a model to be parked:
+//   - its file says so (`park: true`): a model that parks is never sent Free
+//     on its way to being stopped, since for it Free is not a prelude to a
+//     kill;
+//   - the host's floor is set (SetParkHostFloorSource): parked weights are
+//     host memory, and the host is not what it was an hour ago, so the room
+//     is read before EACH park. Unset, nothing is parked;
+//   - its backend answers Status with what parking would move ("park_size"),
+//     and Free with success and the message "parked".
+// Anything else and the model is stopped, as it always was.
+
+var (
+	// ErrModelCannotPark: the model is stopped as before - its file does not
+	// say `park: true`, or its backend does not park.
+	ErrModelCannotPark = errors.New("model cannot be parked")
+	// ErrParkingOff: no host memory floor is set, so nothing is parked.
+	ErrParkingOff = errors.New("parking is off: no host memory floor is set")
+	// ErrParkHostFloor: parking this model now would leave the host under
+	// its memory floor.
+	ErrParkHostFloor = errors.New("parking would leave the host under its memory floor")
+	// ErrParkedReturnFailed: a parked model's weights did not come back to
+	// the device, for another reason than room, and its process was stopped.
+	// The model is not loaded any more: the next load of it is an ordinary
+	// one, from its file.
+	ErrParkedReturnFailed = errors.New("a parked model's return failed and its process was stopped")
+	// ErrParkStoppedModel: the park left a backend that cannot be trusted
+	// with requests - its Free succeeded without parking, or had not
+	// answered in parkTimeout - and its process was stopped. The device is
+	// free; the model is not loaded any more.
+	ErrParkStoppedModel = errors.New("the model could not be parked and its process was stopped")
+	// errParkedModelGone: the parked model a request waited for was stopped
+	// meanwhile. Nothing failed; the request is served by an ordinary load.
+	errParkedModelGone = errors.New("the parked model was stopped meanwhile")
+)
+
+const (
+	// parkedMessage is what a backend answers Free with when it parked the
+	// model, or found it parked.
+	parkedMessage = "parked"
+	// parkSizeKey is where a backend's Status says how many bytes parking
+	// would move to the host - what the device must have room for when they
+	// come back.
+	parkSizeKey = "park_size"
+	// busyHead is how a backend's refusal to park begins when the reason is
+	// of the moment - a request is running, requests are waiting, the model
+	// is still loading. FailedPrecondition alone is not that: a backend also
+	// says it of a model it does not hold.
+	busyHead = "busy: "
+	// NoRoomRetryAfterSeconds is how long a client is told to wait before it
+	// sends again a request the device had no room for.
+	NoRoomRetryAfterSeconds = 2
+	// parkedReturnAttempts bounds how many times one request looks again at
+	// a model whose return failed or that was stopped under it.
+	parkedReturnAttempts = 3
+	// NoRoomOnDeviceType is the type of a refusal of the moment: the device
+	// had no memory - for parked weights to come back, for a context, for a
+	// graph. Nothing is wrong with the request or the model.
+	NoRoomOnDeviceType = "no_room_on_device"
+
+	parkStatusTimeout = 5 * time.Second
+)
+
+// parkTimeout and unparkTimeout are how long a park and a return may take:
+// one copy of the weights, measured in milliseconds to seconds. A backend
+// that has not answered by then hangs, and is stopped: what it did with the
+// weights is not known.
+var (
+	parkTimeout   = 60 * time.Second
+	unparkTimeout = 60 * time.Second
+)
+
+// NoRoomOnDeviceError is a request, or a model's return, that the device
+// had no room for at that moment. The HTTP layer answers it 503 with a
+// Retry-After and the type NoRoomOnDeviceType: a deferral, not a fault.
+type NoRoomOnDeviceError struct {
+	Model   string
+	Message string
+}
+
+func (e *NoRoomOnDeviceError) Error() string {
+	if e.Model == "" {
+		return e.Message
+	}
+	return e.Model + ": " + e.Message
+}
+
+// NoRoomOnDevice tells a refusal of the moment from every other error, and
+// returns its message. A backend says it with the gRPC code ResourceExhausted
+// AND the type at the head of its message, "no_room_on_device: ...": the
+// code alone has other meanings on this wire - a stream that is busy, a
+// message over the size limit, a rate-limited upstream.
+func NoRoomOnDevice(err error) (message string, ok bool) {
+	var typed *NoRoomOnDeviceError
+	if errors.As(err, &typed) {
+		return typed.Message, true
+	}
+	var st interface{ GRPCStatus() *status.Status }
+	if !errors.As(err, &st) || st.GRPCStatus().Code() != codes.ResourceExhausted {
+		return "", false
+	}
+	return strings.CutPrefix(st.GRPCStatus().Message(), NoRoomOnDeviceType+": ")
+}
+
+// SetParkHostFloorSource sets where the host's floor for parking is read:
+// the bytes that must stay available on the host once a model's weights are
+// parked there. It is read at each park, so a caller that changes the floor
+// - it differs with what the node is doing - is followed at once. A source
+// that returns 0, and no source, mean nothing is parked.
+func (ml *ModelLoader) SetParkHostFloorSource(floor func() uint64) {
+	ml.mu.Lock()
+	defer ml.mu.Unlock()
+	ml.parkHostFloor = floor
+}
+
+// SetHostAvailableMemorySource replaces how the host's available memory is
+// read (xsysinfo's MemAvailable, by default).
+func (ml *ModelLoader) SetHostAvailableMemorySource(available func() (uint64, error)) {
+	ml.mu.Lock()
+	defer ml.mu.Unlock()
+	ml.hostAvailable = available
+}
+
+// hostAvailableMemory is what a backend of this process can still take: the
+// host's available memory and, in a container with a memory limit, no more
+// than the limit still allows. The weights are copied into the BACKEND's
+// memory, which is this process's cgroup.
+func hostAvailableMemory() (uint64, error) {
+	return xsysinfo.AllocatableMemory(), nil
+}
+
+// ParkModel parks a loaded model: its weights leave the device, its process
+// stays. It waits for nothing but the park itself - not for a busy model,
+// and not for the model's lifecycle lock: a load, a return or a stop of it
+// that is running is ErrModelBusy at once, like a request. It never stops a
+// model: every reason it does not park is an error the caller acts on -
+// ErrModelBusy (take another), ErrModelCannotPark, ErrParkingOff,
+// ErrParkHostFloor (stop it instead, if room is still wanted). A model that
+// is already parked is left as it is.
+func (ml *ModelLoader) ParkModel(ctx context.Context, modelName string) (ParkedState, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	release, free := ml.operations.tryAcquire(modelName, true)
+	if !free {
+		return ParkedState{}, fmt.Errorf("%w: a load, a return or a stop of it is running", ErrModelBusy)
+	}
+	defer release()
+	return ml.park(ctx, modelName, "")
+}
+
+// ParkModelAtAddress is ParkModel for an eviction the watchdog chose: the
+// address it selected must still be the model's. It reports whether the
+// model is now parked. A model that does not park, and every model while
+// parking is off, is answered before the lifecycle lock is looked at: its
+// eviction is the stop it always was, waits included.
+func (ml *ModelLoader) ParkModelAtAddress(modelName, address string) (bool, error) {
+	ml.mu.Lock()
+	store := ml.store
+	floorOf := ml.parkHostFloor
+	ml.mu.Unlock()
+	if m, ok := store.Get(modelName); !ok || m.address != address {
+		return false, ErrModelNotFound
+	} else if !m.Parks() {
+		return false, ErrModelCannotPark
+	}
+	if floorOf == nil || floorOf() == 0 {
+		return false, ErrParkingOff
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), parkTimeout+parkStatusTimeout)
+	defer cancel()
+	release, free := ml.operations.tryAcquire(modelName, true)
+	if !free {
+		return false, fmt.Errorf("%w: a load, a return or a stop of it is running", ErrModelBusy)
+	}
+	defer release()
+	_, err := ml.park(ctx, modelName, address)
+	return err == nil, err
+}
+
+// park runs under the model's exclusive lifecycle lock.
+func (ml *ModelLoader) park(ctx context.Context, modelName, address string) (ParkedState, error) {
+	ml.mu.Lock()
+	store := ml.store
+	wd := ml.wd
+	floorOf := ml.parkHostFloor
+	available := ml.hostAvailable
+	ml.mu.Unlock()
+
+	m, ok := store.Get(modelName)
+	if !ok || (address != "" && m.address != address) {
+		return ParkedState{}, ErrModelNotFound
+	}
+	if state := m.ParkedState(); state.Parked {
+		return state, nil
+	}
+	if !m.Parks() {
+		return ParkedState{}, fmt.Errorf("%w: its file does not say `park: true`", ErrModelCannotPark)
+	}
+	var floor uint64
+	if floorOf != nil {
+		floor = floorOf()
+	}
+	if floor == 0 {
+		return ParkedState{}, ErrParkingOff
+	}
+
+	client := m.GRPC(false, wd)
+	parker, ok := client.(interface {
+		FreeResult(context.Context) (*pb.Result, error)
+	})
+	if !ok {
+		return ParkedState{}, fmt.Errorf("%w: it is not served by a backend process of this instance", ErrModelCannotPark)
+	}
+	if client.IsBusy() {
+		return ParkedState{}, ErrModelBusy
+	}
+
+	// What parking would move to the host: the backend says. One that has no
+	// such answer does not park.
+	statusCtx, cancel := context.WithTimeout(ctx, parkStatusTimeout)
+	backendStatus, err := client.Status(statusCtx)
+	cancel()
+	if err != nil {
+		if status.Code(err) == codes.Unimplemented {
+			return ParkedState{}, fmt.Errorf("%w: its backend does not park", ErrModelCannotPark)
+		}
+		return ParkedState{}, fmt.Errorf("asking model %q what parking it would move: %w", modelName, err)
+	}
+	size := backendStatus.GetMemory().GetBreakdown()[parkSizeKey]
+	if size == 0 {
+		return ParkedState{}, fmt.Errorf("%w: its backend names no bytes to park", ErrModelCannotPark)
+	}
+
+	// The host, now. Not an hour ago, and not a budget: what is available at
+	// this moment, less what the parks in flight are about to copy into it
+	// and what this one would, against the floor.
+	if available == nil {
+		available = hostAvailableMemory
+	}
+	free, err := available()
+	if err != nil {
+		return ParkedState{}, fmt.Errorf("%w: the host's memory could not be read (%v)", ErrParkHostFloor, err)
+	}
+	ml.mu.Lock()
+	reserved := ml.parkReserved
+	fits := free >= reserved && free-reserved >= size && free-reserved-size >= floor
+	if fits {
+		ml.parkReserved += size
+	}
+	ml.mu.Unlock()
+	if !fits {
+		return ParkedState{}, fmt.Errorf("%w: %d MiB available, %d MiB being parked by others, %d MiB to park, a floor of %d MiB",
+			ErrParkHostFloor, free>>20, reserved>>20, size>>20, floor>>20)
+	}
+	defer func() {
+		ml.mu.Lock()
+		ml.parkReserved -= size
+		ml.mu.Unlock()
+	}()
+
+	stopped := func(why string) error {
+		xlog.Warn("A park left a backend that cannot be trusted with requests; stopping it", "model", modelName, "reason", why)
+		stopCtx, cancel := context.WithTimeout(context.Background(), forcedShutdownTimeout)
+		defer cancel()
+		if stopErr := ml.deleteProcess(stopCtx, modelName, true); stopErr != nil && !errors.Is(stopErr, ErrModelNotFound) {
+			xlog.Error("stopping a model after its park", "model", modelName, "error", stopErr)
+		}
+		return fmt.Errorf("%w: %s", ErrParkStoppedModel, why)
+	}
+
+	// Once Free is sent it is followed to its end whatever the caller does:
+	// a caller that leaves in the middle of the copy must not leave a model
+	// recorded as loaded whose weights are in host memory.
+	freeCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), parkTimeout)
+	res, err := parker.FreeResult(freeCtx)
+	cancel()
+	if err != nil {
+		answer := status.Convert(err)
+		switch answer.Code() {
+		case codes.Unimplemented:
+			return ParkedState{}, fmt.Errorf("%w: its backend does not park", ErrModelCannotPark)
+		case codes.FailedPrecondition:
+			if strings.HasPrefix(answer.Message(), busyHead) {
+				// a request reached it between the busy check and the park:
+				// not now. It is never stopped for that.
+				return ParkedState{}, fmt.Errorf("%w: %s", ErrModelBusy, answer.Message())
+			}
+			// a precondition that is not of the moment: it does not park
+			return ParkedState{}, fmt.Errorf("%w: its backend refused: %s", ErrModelCannotPark, answer.Message())
+		case codes.DeadlineExceeded:
+			// It may still park, or never answer anything again: neither
+			// record would be true.
+			return ParkedState{}, stopped(fmt.Sprintf("its backend had not answered Free in %s", parkTimeout))
+		}
+		// The backend says the park failed: nothing moved, the model is
+		// where it was.
+		return ParkedState{}, fmt.Errorf("parking model %q: %w", modelName, err)
+	}
+	if !res.GetSuccess() || res.GetMessage() != parkedMessage {
+		// A Free that succeeded without parking freed something this loader
+		// cannot bring back with a LoadModel.
+		return ParkedState{}, stopped(fmt.Sprintf("its backend answered Free with %q instead of parking", res.GetMessage()))
+	}
+
+	m.markParked(size, time.Now())
+	if wd != nil {
+		// Not one of the loaded models any more: not counted against the
+		// limit of loaded models, not an eviction candidate, not idle- or
+		// busy-checked. It is registered again when it comes back.
+		wd.Untrack(m.address)
+	}
+	xlog.Info("Model parked", "model", modelName, "bytes", size)
+	return m.ParkedState(), nil
+}
+
+// unpark brings a parked model's weights back to the device, with a
+// LoadModel that carries the options of its load. A model that is not
+// parked is left alone. It runs under the model's exclusive lifecycle lock,
+// so of several requests for a parked model one brings it back and the
+// others find it back.
+//
+// A return is a load for the limits, and they are enforced HERE, under that
+// lock and after the model was found still parked: the models it may not
+// share the device with are evicted or parked first, and from the moment
+// its LoadModel is sent the model is one of the loaded models again - a
+// load that starts beside it counts it, and none evicts what another
+// request has just brought back.
+//
+// It ends one of three ways, and in none of them is the model left in a
+// state that fails again:
+//   - the weights are back;
+//   - the device has no room NOW: the model stays parked and the error is a
+//     *NoRoomOnDeviceError - a deferral, the next request asks again;
+//   - anything else - the backend failed the return, holds the model under
+//     other options, is gone, or has not answered within unparkTimeout: the
+//     process is stopped and the error is ErrParkedReturnFailed. The same
+//     LoadModel to the same process would fail the same way for ever, and
+//     nothing else stops a parked model; stopped, its next load is an
+//     ordinary one, from its file.
+//
+// Once the LoadModel is sent it is followed to its end whatever the caller
+// does: a request that goes away in the middle of the copy must not leave
+// the weights on the device under a record that says "parked".
+func (ml *ModelLoader) unpark(ctx context.Context, m *Model) error {
+	if !m.ParkedState().Parked {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	release, err := ml.operations.acquireContext(ctx, m.ID, true)
+	if err != nil {
+		return fmt.Errorf("waiting to bring model %q back: %w", m.ID, err)
+	}
+	defer release()
+	if !m.ParkedState().Parked {
+		return nil // another request brought it back meanwhile
+	}
+
+	ml.mu.Lock()
+	wd := ml.wd
+	store := ml.store
+	ml.mu.Unlock()
+	if held, ok := store.Get(m.ID); !ok || held != m {
+		// stopped, or stopped and loaded again, while this request waited:
+		// what the store holds now is not this parked process
+		return errParkedModelGone
+	}
+
+	failed := func(cause error) error {
+		xlog.Error("A parked model's return failed; its process is stopped and its next load is from its file",
+			"model", m.ID, "error", cause)
+		stopCtx, cancel := context.WithTimeout(context.Background(), forcedShutdownTimeout)
+		defer cancel()
+		if stopErr := ml.deleteProcess(stopCtx, m.ID, true); stopErr != nil && !errors.Is(stopErr, ErrModelNotFound) {
+			if held, ok := store.Get(m.ID); ok && held == m {
+				// the process could not be stopped: the model is still
+				// parked, and the next request tries both again
+				if wd != nil {
+					wd.Untrack(m.address)
+				}
+				return fmt.Errorf("bringing model %q back to the device: %w (and its process could not be stopped: %v)", m.ID, cause, stopErr)
+			}
+		}
+		return fmt.Errorf("%w: model %q: %w", ErrParkedReturnFailed, m.ID, cause)
+	}
+
+	opts := m.LoadOptions()
+	if opts == nil {
+		return failed(errors.New("the options of its load are not held"))
+	}
+
+	// The limits, as for a load: this model is not yet one of the loaded
+	// models, so they make room for one more.
+	ml.enforceGroupExclusivity(m.ID)
+	ml.enforceLRULimit()
+
+	// One of the loaded models from here on, before its weights move.
+	if wd != nil {
+		if p := m.Process(); p != nil {
+			wd.Add(m.address, p)
+		}
+		wd.AddAddressModelMap(m.address, m.ID)
+		if size := m.sizeEstimate(); size > 0 {
+			wd.RegisterModelSize(m.ID, size)
+		}
+		wd.UpdateLastUsed(m.address)
+	}
+
+	loadCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), unparkTimeout)
+	res, err := m.GRPC(false, wd).LoadModel(loadCtx, opts)
+	cancel()
+	if err != nil {
+		if message, noRoom := NoRoomOnDevice(err); noRoom {
+			if wd != nil {
+				wd.Untrack(m.address) // still parked: not one of the loaded models
+			}
+			return &NoRoomOnDeviceError{Model: m.ID, Message: message}
+		}
+		return failed(err)
+	}
+	if !res.GetSuccess() {
+		return failed(errors.New(res.GetMessage()))
+	}
+
+	m.markUnparked()
+	xlog.Info("Model back on the device", "model", m.ID)
+	return nil
+}

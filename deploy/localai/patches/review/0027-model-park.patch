+package openai
+
+import (
+	"errors"
+	"fmt"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// The error event a chat stream ends with, once the answer has begun: no
+// status code can say anything any more, so the event's type does.
+var _ = Describe("the error event of a chat stream", func() {
+	It("says a refusal of the moment is one, so a client can send the request again", func() {
+		refusal := fmt.Errorf("stream: %w", status.Error(codes.ResourceExhausted, "no_room_on_device: the computation cannot be placed on the device now"))
+		errType, message := streamErrorTypeAndMessage(refusal)
+		Expect(errType).To(Equal("no_room_on_device"))
+		Expect(message).To(Equal("the computation cannot be placed on the device now"))
+	})
+
+	It("leaves every other error a server_error with its own words, as it was", func() {
+		for _, other := range []error{
+			errors.New("the backend went away"),
+			status.Error(codes.ResourceExhausted, "backend is busy"),
+			status.Error(codes.Internal, "Compute error."),
+		} {
+			errType, message := streamErrorTypeAndMessage(other)

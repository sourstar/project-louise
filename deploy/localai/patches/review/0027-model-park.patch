 func (m *Model) IsRecentlyHealthy() bool {
 	m.Lock()
diff --git a/pkg/model/operation_locks.go b/pkg/model/operation_locks.go
index ce64312..608e1a9 100644
--- a/pkg/model/operation_locks.go
+++ b/pkg/model/operation_locks.go
@@ -61,6 +61,35 @@ func (l *modelOperationLocks) acquireContext(ctx context.Context, modelID string

++// parking
++
++static thread_local enum ggml_backend_buffer_usage ggml_backend_alloc_usage_hint = GGML_BACKEND_BUFFER_USAGE_ANY;
++
++void ggml_backend_set_alloc_usage_hint(enum ggml_backend_buffer_usage usage) {
++    ggml_backend_alloc_usage_hint = usage;
++}
++
++enum ggml_backend_buffer_usage ggml_backend_get_alloc_usage_hint(void) {
++    return ggml_backend_alloc_usage_hint;
++}
++
++// the buffers a buffer is made of: itself, or the parts of a multi-buffer
++static std::vector<ggml_backend_buffer_t> ggml_backend_buffer_parts(ggml_backend_buffer_t buffer) {
++    GGML_ASSERT(buffer);
++    if (ggml_backend_buffer_is_multi_buffer(buffer)) {
++        ggml_backend_multi_buffer_context * ctx = (ggml_backend_multi_buffer_context *) buffer->context;
++        return std::vector<ggml_backend_buffer_t>(ctx->buffers, ctx->buffers + ctx->n_buffers);
++    }
++    return { buffer };
++}
++
++bool ggml_backend_buffer_can_park(ggml_backend_buffer_t buffer) {
++    const std::vector<ggml_backend_buffer_t> parts = ggml_backend_buffer_parts(buffer);
++    for (ggml_backend_buffer_t part : parts) {
++        if (part->iface.park == NULL || part->iface.unpark == NULL) {
++            return false;
++        }
++    }
++    return !parts.empty();
++}
++
++// park (or unpark) every part; if one cannot, the parts already done are put back as they were
++static bool ggml_backend_buffer_park_all(ggml_backend_buffer_t buffer, bool park) {
++    if (!ggml_backend_buffer_can_park(buffer)) {
++        return false;
++    }
++    const std::vector<ggml_backend_buffer_t> parts = ggml_backend_buffer_parts(buffer);
++    for (size_t i = 0; i < parts.size(); i++) {
++        const bool ok = park ? parts[i]->iface.park(parts[i]) : parts[i]->iface.unpark(parts[i]);
++        if (ok) {
++            continue;
++        }
++        for (size_t j = 0; j < i; j++) {
++            const bool back = park ? parts[j]->iface.unpark(parts[j]) : parts[j]->iface.park(parts[j]);
++            if (!back) {
++                // half of a buffer on the device and half not: nothing above can use it, and nothing can repair it
++                GGML_ABORT("%s: part %zu of a buffer could not be %s again after part %zu failed\n", __func__, j,
++                           park ? "unparked" : "parked", i);
++            }
++        }
++        return false;
++    }
++    return true;
++}
++
++bool ggml_backend_buffer_park(ggml_backend_buffer_t buffer) {
++    return ggml_backend_buffer_park_all(buffer, true);
++}
++
++bool ggml_backend_buffer_unpark(ggml_backend_buffer_t buffer) {
++    return ggml_backend_buffer_park_all(buffer, false);
++}
++
+ void ggml_backend_multi_buffer_set_usage(ggml_backend_buffer_t buffer, enum ggml_backend_buffer_usage usage) {
+     GGML_ASSERT(buffer);
+     GGML_ASSERT(ggml_backend_buffer_is_multi_buffer(buffer));
+@@ -2892,6 +2958,8 @@ static const struct ggml_backend_buffer_i ggml_backend_cpu_buffer_i = {

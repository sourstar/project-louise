++#if defined(GGML_SYCL_SUPPORT_VMM)
++// The device memory of a buffer that can PARK: physical memory mapped into a reserved virtual range, the extension the
++// pool grows with. Releasing the physical memory and committing it again leaves the range, and so every address into
++// the buffer, where it was: nothing that refers to a tensor of the buffer (its data pointer, its extra, a reorder that
++// was done on it) has to change across a park. While it is parked the contents are in host memory.
++struct ggml_sycl_parkable_mem {
++    // committed in pieces of at most this (a multiple of the granularity), none large enough to need relaxed limits
++    static constexpr size_t PIECE = 1ull << 30;
++
++    struct mapping {
++        sycl::ext::oneapi::experimental::physical_mem phys;
++        void * ptr;
++    };
++
++    sycl::context ctx;
++    sycl::device  dev;
++    uintptr_t     addr = 0; // the reserved range
++    size_t        size = 0; // its size, a multiple of the granularity
++    std::vector<mapping> mappings; // empty: nothing is committed
++
++    void *   host      = nullptr; // the contents while parked
++    uint64_t n_park    = 0;
++    uint64_t first_sum = 0;       // the checksum of the contents at the first park (GGML_SYCL_PARK_VERIFY)
++
++    ggml_sycl_parkable_mem(queue_ptr qptr, int device, size_t bytes) : ctx(qptr->get_context()), dev(qptr->get_device()) {
++        const size_t granularity = ggml_sycl_info().devices[device].vmm_granularity;
++        GGML_ASSERT(granularity > 0 && PIECE % granularity == 0);
++        size = GGML_PAD(std::max(bytes, (size_t) 1), granularity);
++        addr = sycl::ext::oneapi::experimental::reserve_virtual_mem(size, ctx);
++    }
++
++    ~ggml_sycl_parkable_mem() {
++        release();
++        if (addr != 0) {
++            SYCL_CHECK(CHECK_TRY_ERROR(sycl::ext::oneapi::experimental::free_virtual_mem(addr, size, ctx)));
++        }
++        if (host != nullptr) {
++            free_aligned_mem_host(host);
++        }
++    }
++
++    ggml_sycl_parkable_mem(const ggml_sycl_parkable_mem &)             = delete;
++    ggml_sycl_parkable_mem & operator=(const ggml_sycl_parkable_mem &) = delete;
++
++    bool committed() const { return !mappings.empty(); }
++
++    // physical memory behind the whole range; false, with nothing committed, when the device refuses it
++    bool commit() {
++        GGML_ASSERT(!committed());
++        try {
++            mappings.reserve((size + PIECE - 1) / PIECE);
++            for (size_t off = 0; off < size; off += PIECE) {
++                const size_t n = std::min(PIECE, size - off);
++                sycl::ext::oneapi::experimental::physical_mem phys(dev, ctx, n);
++                void * ptr = phys.map(addr + off, n, sycl::ext::oneapi::experimental::address_access_mode::read_write);
++                mappings.push_back({ std::move(phys), ptr });
++            }
++        } catch (const sycl::exception & e) {
++            GGML_LOG_ERROR("%s: the device refused memory for a parkable buffer (%zu of %zu MiB committed): %s\n", __func__,
++                           mappings.size() * PIECE / (1024 * 1024), size / (1024 * 1024), e.what());
++            release();
++            return false;
++        }
++        return true;
++    }
++
++    // unmap exactly what was mapped, before the physical memory goes: its destructor does not unmap
++    void release() {
++        for (auto & m : mappings) {
++            SYCL_CHECK(CHECK_TRY_ERROR(sycl::ext::oneapi::experimental::unmap(m.ptr, m.phys.size(), ctx)));
++        }
++        mappings.clear();
++    }
++};
++#endif // defined(GGML_SYCL_SUPPORT_VMM)
++

++@pytest.fixture(autouse=True)
++def create_server():
++    global server
++    server = ServerPreset.tinyllama2()
++    server.context_on_demand = True
++    server.server_metrics = True
++
++
++def get_metric(server: ServerProcess, name: str) -> float:
++    res = server.make_request("GET", "/metrics")
++    assert res.status_code == 200
++    prefix = f"llamacpp:{name} "
++    values = [ln for ln in res.body.splitlines() if ln.startswith(prefix)]
++    assert len(values) == 1, f"{name} not found in metrics"
++    return float(values[0][len(prefix):])
++
++
++def wait_for_context(server: ServerProcess, loaded: bool, timeout: float = 10.0):
++    start = time.time()
++    while time.time() - start < timeout:
++        if (get_metric(server, "context_loaded") == 1) == loaded:
++            return
++        time.sleep(0.05)
++    raise TimeoutError(f"context_loaded did not become {int(loaded)}")
++
++
++def completion(server: ServerProcess, prompt: str = "I believe the meaning of life is", **kwargs):
++    return server.make_request("POST", "/completion", data={
++        "prompt": prompt,
++        "n_predict": 8,
++        "seed": 42,
++        "temperature": 0.0,
++        **kwargs,
++    })
++
++
++def test_context_is_freed_when_idle():
++    global server
++    server.start()
++
++    wait_for_context(server, False)
++
++    # the model stays loaded, these do not need the context and must not create it
++    for path in ["/health", "/props", "/models"]:
++        res = server.make_request("GET", path)
++        assert res.status_code == 200
++    res = server.make_request("POST", "/tokenize", data={"content": "Hello world"})
++    assert res.status_code == 200
++    assert len(res.body["tokens"]) > 0
++
++    assert get_metric(server, "context_loaded") == 0
++    assert get_metric(server, "context_creations_total") == 0
++
++
++def test_slots_are_listed_without_the_context():
++    global server
++    server.server_slots = True
++    server.start()
++    wait_for_context(server, False)
++
++    res = server.make_request("GET", "/slots")
++    assert res.status_code == 200
++    assert len(res.body) == server.n_slots
++    assert all(not slot["is_processing"] for slot in res.body)
++    assert get_metric(server, "context_loaded") == 0
++    assert get_metric(server, "context_creations_total") == 0
++
++
++def test_with_sleep_idle_seconds():
++    global server
++    server.sleep_idle_seconds = 1
++    server.start()
++
++    # asleep, the model is unloaded as well
++    start = time.time()
++    while time.time() - start < 10:
++        res = server.make_request("GET", "/props")
++        assert res.status_code == 200
++        if res.body["is_sleeping"]:
++            break
++        time.sleep(0.1)
++    assert res.body["is_sleeping"]
++
++    # a request loads the model again, and its context goes when it is done
++    res = completion(server, keep_context_ms=0)
++    assert res.status_code == 200
++    wait_for_context(server, False)
++    res = completion(server, keep_context_ms=0)
++    assert res.status_code == 200
++

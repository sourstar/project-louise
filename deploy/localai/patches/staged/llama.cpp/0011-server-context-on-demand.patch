+    static bool task_needs_context(server_task_type type) {
+        switch (type) {
+            case SERVER_TASK_TYPE_CANCEL:
+            case SERVER_TASK_TYPE_CONTROL:
+            case SERVER_TASK_TYPE_NEXT_RESPONSE:
+            case SERVER_TASK_TYPE_METRICS:
+            case SERVER_TASK_TYPE_SLOT_GET:
+            case SERVER_TASK_TYPE_GET_LORA:
+            case SERVER_TASK_TYPE_SET_LORA:
+                return false;
+            default:
+                return true;
+        }
+    }
+
+    // free the context and what is bound to it, keep the model
+    void context_release() {
+        GGML_ASSERT(ctx_tgt != nullptr);
+
+        const int64_t t_start = ggml_time_us();
+
+        for (auto & slot : slots) {
+            GGML_ASSERT(!slot.is_processing());
+
+            // the cached prompt goes with the KV cache
+            slot.prompt.clear();
+            slot.ctx_tgt = nullptr;
+            slot.mem     = {};
+        }
+
+        batch.view = common_batch();
+        batch.tokens.clear();
+
+        llama_init->free_context();
+        ctx_tgt = nullptr;
+
+        metrics.ctx_loaded = false;
+
+        SRV_INF("context freed in %.2f ms, it lived %.3f s\n",
+                (ggml_time_us() - t_start) / 1000.0, (ggml_time_ms() - t_ctx_created) / 1000.0);
+    }
+
+    // create the context again, as the load made it
+    // returns false if it cannot be created, the server is then left without one
+    bool context_acquire() {
+        GGML_ASSERT(ctx_tgt == nullptr && llama_init != nullptr);
+
+        const int64_t t_start = ggml_time_us();
+
+        if (ctx_create_fail > 0) {
+            ctx_create_fail--;
+            SRV_WRN("%s", "LLAMA_SERVER_CTX_CREATE_FAIL: failing the creation of the context\n");
+            return false;
+        }
+
+        if (!common_init_context_from_params(*llama_init, params_base)) {
+            SRV_WRN("%s", "failed to create the context, is the memory it needs available?\n");
+            return false;
+        }
+
+        ctx_tgt = llama_init->context();
+
+        GGML_ASSERT((int32_t) llama_n_ctx_seq(ctx_tgt) == n_ctx_seq && (int32_t) llama_n_ctx(ctx_tgt) == n_ctx);
+
+        for (auto & slot : slots) {
+            slot.ctx_tgt = ctx_tgt;
+            slot.mem.init(ctx_tgt, ctx_dft);
+        }
+
+        {
+            const int32_t n_batch = llama_n_batch(ctx_tgt);
+            const int32_t n_embd  = llama_model_n_embd_inp(model_tgt);
+            batch.init(ctx_tgt, std::max(n_batch, params_base.n_parallel), n_embd);
+        }
+
+        const int64_t t_create = ggml_time_us() - t_start;

+    res->init_stop = common_init_context_apply(*res, params);
+
     return res;
 }
 
+bool common_init_context_from_params(common_init_result & res, common_params & params) {
+    if (!res.init_context()) {
+        return false;
+    }
+
+    // the same state as the context of the load, or none
+    if (common_init_context_apply(res, params) != res.init_stop) {
+        res.free_context();
+        return false;
+    }
+
+    return true;
+}

diff --git a/tools/server/tests/unit/test_context_on_demand.py b/tools/server/tests/unit/test_context_on_demand.py
new file mode 100644
index 0000000..ccc649d
--- /dev/null
+++ b/tools/server/tests/unit/test_context_on_demand.py
@@ -0,0 +1,487 @@
+import pytest
+import time
+from utils import *
+
+server = ServerPreset.tinyllama2()
+
+
+@pytest.fixture(autouse=True)
+def create_server():
+    global server
+    server = ServerPreset.tinyllama2()
+    server.context_on_demand = True
+    server.server_metrics = True
+
+
+def get_metric(server: ServerProcess, name: str) -> float:
+    res = server.make_request("GET", "/metrics")
+    assert res.status_code == 200
+    prefix = f"llamacpp:{name} "
+    values = [ln for ln in res.body.splitlines() if ln.startswith(prefix)]
+    assert len(values) == 1, f"{name} not found in metrics"
+    return float(values[0][len(prefix):])
+
+
+def wait_for_context(server: ServerProcess, loaded: bool, timeout: float = 10.0):
+    start = time.time()
+    while time.time() - start < timeout:
+        if (get_metric(server, "context_loaded") == 1) == loaded:
+            return
+        time.sleep(0.05)
+    raise TimeoutError(f"context_loaded did not become {int(loaded)}")
+
+
+def completion(server: ServerProcess, prompt: str = "I believe the meaning of life is", **kwargs):
+    return server.make_request("POST", "/completion", data={
+        "prompt": prompt,
+        "n_predict": 8,
+        "seed": 42,
+        "temperature": 0.0,
+        **kwargs,
+    })
+
+
+def test_context_is_freed_when_idle():
+    global server
+    server.start()
+
+    wait_for_context(server, False)
+
+    # the model stays loaded, these do not need the context and must not create it
+    for path in ["/health", "/props", "/models"]:
+        res = server.make_request("GET", path)
+        assert res.status_code == 200
+    res = server.make_request("POST", "/tokenize", data={"content": "Hello world"})
+    assert res.status_code == 200
+    assert len(res.body["tokens"]) > 0
+
+    assert get_metric(server, "context_loaded") == 0
+    assert get_metric(server, "context_creations_total") == 0
+
+
+def test_slots_are_listed_without_the_context():
+    global server
+    server.server_slots = True
+    server.start()
+    wait_for_context(server, False)
+
+    res = server.make_request("GET", "/slots")
+    assert res.status_code == 200
+    assert len(res.body) == server.n_slots
+    assert all(not slot["is_processing"] for slot in res.body)
+    assert get_metric(server, "context_loaded") == 0
+    assert get_metric(server, "context_creations_total") == 0
+
+
+def test_with_sleep_idle_seconds():
+    global server
+    server.sleep_idle_seconds = 1
+    server.start()
+
+    # asleep, the model is unloaded as well
+    start = time.time()
+    while time.time() - start < 10:
+        res = server.make_request("GET", "/props")
+        assert res.status_code == 200
+        if res.body["is_sleeping"]:
+            break
+        time.sleep(0.1)
+    assert res.body["is_sleeping"]
+
+    # a request loads the model again, and its context goes when it is done
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    wait_for_context(server, False)
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+
+
+def test_a_request_with_a_keep_of_zero_creates_the_context_and_frees_it():
+    global server
+    server.start()
+    wait_for_context(server, False)
+
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    wait_for_context(server, False)
+    assert get_metric(server, "context_creations_total") == 1
+
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    wait_for_context(server, False)
+    assert get_metric(server, "context_creations_total") == 2
+
+
+def test_a_request_without_a_keep_leaves_the_context_loaded():
+    global server
+    server.n_slots = 1
+    server.start()
+    wait_for_context(server, False)
+
+    prompt = "Once upon a time, there was a little girl who lived in a house near the big forest."
+
+    # a client that does not know the option is served as by a server without it:
+    # the context is created for its request and not freed after it
+    res = completion(server, prompt, cache_prompt=True)
+    assert res.status_code == 200
+    time.sleep(1.5)
+    assert get_metric(server, "context_loaded") == 1
+    assert get_metric(server, "context_creations_total") == 1
+
+    # cached prompt included
+    res = completion(server, prompt, cache_prompt=True)
+    assert res.status_code == 200
+    assert res.body["timings"]["cache_n"] > 0
+    assert get_metric(server, "context_creations_total") == 1
+
+    # a keep asked earlier does not free it either: the last request to finish said nothing
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    res = completion(server)
+    assert res.status_code == 200
+    time.sleep(1.0)
+    assert get_metric(server, "context_loaded") == 1
+
+    # until a request that carries one is answered
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    wait_for_context(server, False)
+
+
+def test_keep_from_the_request():
+    global server
+    server.start()
+    wait_for_context(server, False)
+
+    t_start = time.time()
+    res = completion(server, keep_context_ms=3000)
+    assert res.status_code == 200
+    assert get_metric(server, "context_loaded") == 1
+
+    # another request finds the context
+    res = completion(server, keep_context_ms=100)
+    assert res.status_code == 200
+    # a keep can only extend the time the context is kept: 0 does not free it
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    assert time.time() - t_start < 2.5, "the requests took too long for this test to mean anything"
+    assert get_metric(server, "context_loaded") == 1
+    assert get_metric(server, "context_creations_total") == 1
+
+    # and it is freed when the keep has run out
+    wait_for_context(server, False)
+    assert time.time() - t_start >= 3.0
+
+
+def test_keep_from_a_chat_completion():
+    global server
+    server.start()
+    wait_for_context(server, False)
+
+    res = server.make_request("POST", "/v1/chat/completions", data={
+        "messages": [{"role": "user", "content": "What is the meaning of life?"}],
+        "max_tokens": 8,
+        "keep_context_ms": 3000,
+    })
+    assert res.status_code == 200
+    assert get_metric(server, "context_loaded") == 1
+    assert get_metric(server, "context_creations_total") == 1
+
+
+def test_keep_default_of_the_server():
+    global server
+    server.keep_context_ms = 3000
+    server.start()
+
+    # the load itself keeps the context that long
+    assert get_metric(server, "context_loaded") == 1
+
+    t_start = time.time()
+    res = completion(server)
+    assert res.status_code == 200
+    assert get_metric(server, "context_loaded") == 1
+    assert get_metric(server, "context_creations_total") == 0
+
+    wait_for_context(server, False)
+    assert time.time() - t_start >= 3.0
+
+
+def test_same_completion_across_contexts():
+    global server
+    server.start()
+    wait_for_context(server, False)
+
+    contents = []
+    for _ in range(3):
+        res = completion(server, keep_context_ms=0)
+        assert res.status_code == 200
+        contents.append(res.body["content"])
+        wait_for_context(server, False)
+
+    assert get_metric(server, "context_creations_total") == 3
+    assert contents[0] == contents[1] == contents[2]
+
+
+def test_cached_prompt_goes_with_the_context():
+    global server
+    server.n_slots = 1
+    server.start()
+    wait_for_context(server, False)
+
+    prompt = "Once upon a time, there was a little girl who lived in a house near the big forest."
+
+    # kept: the second request reuses the prompt of the first
+    res = completion(server, prompt, keep_context_ms=2000, cache_prompt=True)
+    assert res.status_code == 200
+    res = completion(server, prompt, keep_context_ms=2000, cache_prompt=True)
+    assert res.status_code == 200
+    assert res.body["timings"]["cache_n"] > 0
+
+    # freed: the cached prompt went with the KV cache
+    wait_for_context(server, False)
+    res = completion(server, prompt, cache_prompt=True, keep_context_ms=0)
+    assert res.status_code == 200
+    assert res.body["timings"]["cache_n"] == 0
+
+
+def test_creation_refused_then_retried():
+    global server
+    server.context_create_fail = 1
+    server.start()
+    wait_for_context(server, False)
+
+    # the context cannot be created: the request is refused, the server stays up
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 503
+    assert res.body["error"]["type"] == "unavailable_error"
+    assert get_metric(server, "context_loaded") == 0
+
+    # and the next one is served
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    assert get_metric(server, "context_creations_total") == 1
+
+
+def test_concurrent_requests():
+    global server
+    server.start()
+    wait_for_context(server, False)
+
+    def keyed(i: int):
+        return completion(server, f"Write a story about number {i}", keep_context_ms=0)
+
+    tasks = [(keyed, (i,)) for i in range(8)]
+    results = parallel_function_calls(tasks)
+    for res in results:
+        assert res.status_code == 200
+        assert len(res.body["content"]) > 0
+
+    wait_for_context(server, False)
+    assert 1 <= get_metric(server, "context_creations_total") <= 8
+
+
+def test_embeddings_identical_across_contexts():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.start()
+    wait_for_context(server, False)
+
+    embeddings = []
+    for _ in range(3):
+        res = server.make_request("POST", "/v1/embeddings", data={
+            "input": "I believe the meaning of life is",
+            "keep_context_ms": 0,
+        })
+        assert res.status_code == 200
+        embeddings.append(res.body["data"][0]["embedding"])
+        wait_for_context(server, False)
+
+    assert get_metric(server, "context_creations_total") == 3
+    assert embeddings[0] == embeddings[1] == embeddings[2]
+
+    # a batch of inputs is one busy period
+    res = server.make_request("POST", "/v1/embeddings", data={
+        "input": ["I believe the meaning of life is", "This is a test", "Hello world"],
+        "keep_context_ms": 1000,
+    })
+    assert res.status_code == 200
+    assert res.body["data"][0]["embedding"] == embeddings[0]
+    assert get_metric(server, "context_creations_total") == 4
+
+
+def test_a_result_says_when_the_context_was_created_for_it():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.start()
+    wait_for_context(server, False)
+
+    # the non-OAI route returns its results as they are
+    res = server.make_request("POST", "/embedding", data={
+        "content": "I believe the meaning of life is",
+        "keep_context_ms": 60000,
+    })
+    assert res.status_code == 200
+    assert res.body[0]["context_create_ms"] >= 0
+
+    # the context is there for the next one
+    res = server.make_request("POST", "/embedding", data={
+        "content": "This is a test",
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert "context_create_ms" not in res.body[0]
+    assert get_metric(server, "context_creations_total") == 1
+
+
+def test_one_result_of_a_batch_says_the_context_was_created():
+    global server
+    server = ServerPreset.bert_bge_small()
+    server.context_on_demand = True
+    server.server_metrics = True
+    server.start()
+    wait_for_context(server, False)
+
+    res = server.make_request("POST", "/embedding", data={
+        "content": ["I believe the meaning of life is", "This is a test", "Hello world"],
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert len(res.body) == 3
+    assert sum("context_create_ms" in r for r in res.body) == 1
+    wait_for_context(server, False)
+
+    # without the option, no result says anything
+    server.stop()
+    server = ServerPreset.bert_bge_small()
+    server.start()
+    res = server.make_request("POST", "/embedding", data={
+        "content": "This is a test",
+        "keep_context_ms": 0,
+    })
+    assert res.status_code == 200
+    assert "context_create_ms" not in res.body[0]
+
+
+def test_each_created_context_is_held_to_the_canary_of_the_load():
+    global server
+    server.start()
+    assert get_metric(server, "context_canary") == 1
+    wait_for_context(server, False)
+
+    texts = []
+    for _ in range(3):
+        res = completion(server, keep_context_ms=0)
+        assert res.status_code == 200
+        texts.append(res.body["content"])
+        wait_for_context(server, False)
+
+    assert texts[0] == texts[1] == texts[2]
+    assert get_metric(server, "context_creations_total") == 3
+    assert get_metric(server, "context_canary_failures_total") == 0
+
+
+def test_a_context_that_fails_its_canary_is_discarded_and_the_request_refused():
+    global server
+    server.context_canary_fail = 2
+    server.start()
+    wait_for_context(server, False)
+
+    for _ in range(2):
+        res = completion(server, keep_context_ms=0)
+        assert res.status_code == 503
+        assert res.body["error"]["type"] == "unavailable_error"
+        assert res.body["error"]["message"].startswith("context canary failed")
+        # no context is left behind, the server stays up
+        assert get_metric(server, "context_loaded") == 0
+    assert get_metric(server, "context_canary_failures_total") == 2
+    assert get_metric(server, "context_creations_total") == 0
+
+    # the next context reproduces it and serves
+    res = completion(server, keep_context_ms=0)
+    assert res.status_code == 200
+    assert get_metric(server, "context_creations_total") == 1
+    assert get_metric(server, "context_canary_failures_total") == 2
+
+
+def test_the_canary_can_be_switched_off():
+    global server
+    server.context_canary = False

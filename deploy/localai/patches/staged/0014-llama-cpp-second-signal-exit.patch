diff --git a/backend/cpp/llama-cpp/second_signal.h b/backend/cpp/llama-cpp/second_signal.h
new file mode 100644
index 0000000..a6bc026
--- /dev/null
+++ b/backend/cpp/llama-cpp/second_signal.h
@@ -0,0 +1,48 @@
+// What the llama.cpp gRPC backend does on a SECOND termination signal.
+//
+// The first SIGTERM/SIGINT ends the server loop and main() cleans up: the gRPC
+// server's shutdown, the GPU runtime's teardown. A second one, arriving while
+// that runs, used to call exit(1) from inside the signal handler. exit() runs
+// the exit handlers and the static destructors - on a thread that interrupted,
+// or runs beside, the very clean-up those destructors belong to - and can
+// block there for good: "terminating immediately" printed, the process still
+// alive, its GPU memory still held, until a supervisor's SIGKILL.
+//
+// A backend gets two signals whenever something between LocalAI and it
+// forwards one: LocalAI stops a backend with SIGTERM to its process GROUP, so
+// a wrapper script or supervisor in that group that passes the signal on to
+// its child delivers a second one a millisecond after the first.
+//
+// terminate_on_second_signal() leaves at once with async-signal-safe calls
+// only (POSIX: write(2) and _Exit; no stdio, no exit handlers, no destructors).
+// The operating system reclaims the process's memory, the GPU's included.
+//
+// Dependency-free (C and C++ standard library, unistd.h) so that
+// second_signal_test.cpp can exercise it without building the backend.
+#ifndef LLAMA_GRPC_SECOND_SIGNAL_H
+#define LLAMA_GRPC_SECOND_SIGNAL_H
+
+#include <cstdlib>
+
+#if defined(_WIN32)
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace llama_grpc {
+
+[[noreturn]] inline void terminate_on_second_signal() {
+    static const char msg[] = "Received second interrupt, terminating immediately.\n";
+#if defined(_WIN32)
+    (void) _write(2, msg, (unsigned int) (sizeof(msg) - 1));
+#else
+    const ssize_t written = write(STDERR_FILENO, msg, sizeof(msg) - 1);
+    (void) written;
+#endif
+    std::_Exit(1);
+}
+
+} // namespace llama_grpc
+
+#endif // LLAMA_GRPC_SECOND_SIGNAL_H
diff --git a/backend/cpp/llama-cpp/second_signal_test.cpp b/backend/cpp/llama-cpp/second_signal_test.cpp
new file mode 100644
index 0000000..fad1e91
--- /dev/null
+++ b/backend/cpp/llama-cpp/second_signal_test.cpp
@@ -0,0 +1,92 @@
+// Unit test for the second-signal exit (second_signal.h).
+//
+// Build & run standalone (standard library only):
+//   g++ -std=c++17 second_signal_test.cpp -o t && ./t
+//
+// A child process registers an exit handler that never returns - the stand-in
+// for a clean-up the signal interrupted - and is sent a signal whose handler
+// leaves the way the backend leaves on a second signal. With
+// terminate_on_second_signal() the child is gone at once, status 1. The same
+// child leaving with exit(1), as the backend did, is still there a second
+// later: the test shows the hang it guards against, then kills it.
+//
+// On Windows this file compiles to a no-op success (no fork).
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "second_signal.h"
+
+static int failures = 0;
+
+static void check(bool ok, const std::string &name) {
+    if (!ok) {
+        failures++;
+        fprintf(stderr, "FAIL: %s\n", name.c_str());
+    } else {
+        fprintf(stderr, "ok:   %s\n", name.c_str());
+    }
+}
+
+#if !defined(_WIN32)
+#include <signal.h>
+#include <sys/wait.h>
+#include <time.h>
+
+static void never_returns() {
+    for (;;) {
+        pause();
+    }
+}
+
+static void leave_at_once(int) { llama_grpc::terminate_on_second_signal(); }
+static void leave_through_exit(int) { exit(1); }
+
+// Forks a child that leaves through `handler` on SIGTERM. Returns its wait
+// status once it has ended, or -1 if it is still alive after `wait_ms` (it is
+// then killed).
+static int status_of_child(void (*handler)(int), long wait_ms) {
+    const pid_t pid = fork();
+    if (pid == 0) {
+        fclose(stderr); // the message is the parent's test output otherwise
+        atexit(never_returns);
+        signal(SIGTERM, handler);
+        raise(SIGTERM);
+        for (;;) {
+            pause();
+        }
+    }
+    for (long waited = 0; waited < wait_ms; waited += 10) {
+        int status = 0;
+        if (waitpid(pid, &status, WNOHANG) == pid) {
+            return status;
+        }
+        const struct timespec ten_ms = {0, 10 * 1000 * 1000};
+        nanosleep(&ten_ms, nullptr);
+    }
+    kill(pid, SIGKILL);
+    waitpid(pid, nullptr, 0);
+    return -1;
+}
+
+static void test_second_signal() {
+    const int status = status_of_child(leave_at_once, 5000);
+    check(status != -1, "the process is gone although an exit handler never returns");
+    check(status != -1 && WIFEXITED(status) && WEXITSTATUS(status) == 1, "exit status 1");
+    check(status_of_child(leave_through_exit, 1000) == -1,
+          "exit() from the handler is still there a second later (what it replaces)");
+}
+#else
+static void test_second_signal() {}
+#endif
+
+int main() {
+    test_second_signal();
+    if (failures > 0) {
+        fprintf(stderr, "%d test(s) failed\n", failures);
+        return 1;
+    }
+    fprintf(stderr, "all tests passed\n");
+    return 0;
+}

--- a/backend/cpp/llama-cpp/grpc-server.cpp
+++ b/backend/cpp/llama-cpp/grpc-server.cpp
@@ -116,6 +116,7 @@
 #endif
 
 #include "parent_watch.h" // best-effort parent-death backstop (see header)

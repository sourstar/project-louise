+diff --git a/src/llama-moe-record.h b/src/llama-moe-record.h
+new file mode 100644
+index 0000000..34fcafd
+--- /dev/null
++++ b/src/llama-moe-record.h
+@@ -0,0 +1,262 @@
++#pragma once
++
++// The record of the experts a MoE model used, kept beyond a context.
++//
++// The MoE cache (llama-moe-cache) keeps the recently and repeatedly used experts of host-resident MoE layers in a
++// device buffer. Its knowledge of which experts those are lives and dies with the context: every new context starts
++// with an empty cache and fills it miss by miss, an upload at a time, under its first tokens.
++//
++// This record is that knowledge kept: per layer and expert, the number of tokens that selected the expert, decayed
++// over `half_life` tokens of the layer - answers, where the cache's own score decays over a hundred tokens. A cache
++// is filled from it when it is created (the best first) and its eviction order is seeded from it; when the cache
++// goes, what it saw is folded in. It is kept in memory with the model, for the next context of the process, and in a
++// file, for the next process.
++//
++// It only ever decides WHERE an expert is read from, never what is computed: an expert in the cache and an expert
++// uploaded at a miss are the same bytes. So a record that is missing, unreadable, or another model's or build's is
++// ignored, and a wrong one costs uploads, not answers.
++//
++// Standard library only, so that the file format and the choice of experts are tested without a model or a device
++// (tests/test-moe-record.cpp).
++
++#include <algorithm>
++#include <cmath>
++#include <cstdint>
++#include <cstdio>
++#include <cstring>
++#include <mutex>
++#include <string>
++#include <vector>
++
++struct llama_moe_record {
++    // tokens: a use counts for half as much after this many tokens of its layer
++    static constexpr float half_life = 4096.0f;
++
++    static constexpr char     magic[8] = { 'M', 'O', 'E', 'R', 'E', 'C', '1', '\n' };
++    static constexpr uint32_t max_dim  = 1u << 20; // layers, experts: a header that says more is not a record
++
++    // what the record is of: a record is used only by the same weights and the same build of the engine
++    struct identity {
++        uint32_t    n_layer    = 0;
++        uint32_t    n_expert   = 0;
++        uint64_t    n_bytes    = 0; // size of the model's tensors
++        uint64_t    n_elements = 0;
++        std::string name;           // general.name
++        std::string build;          // of the engine that writes it
++
++        bool operator==(const identity & o) const {
++            return n_layer == o.n_layer && n_expert == o.n_expert && n_bytes == o.n_bytes && n_elements == o.n_elements &&
++                   name == o.name && build == o.build;
++        }
++    };
++
++    identity           id;
++    std::vector<float> score;         // [n_layer*n_expert]
++    uint64_t           n_tokens = 0;  // tokens folded in, over all layers, for the log
++
++    void init(const identity & of) {
++        id = of;
++        score.assign((size_t) id.n_layer*id.n_expert, 0.0f);
++        n_tokens = 0;
++    }
++
++    bool empty() const {
++        return std::none_of(score.begin(), score.end(), [](float s) { return s > 0.0f; });
++    }
++
++    int32_t key(int32_t il, int32_t e) const { return il*(int32_t) id.n_expert + e; }
++
++    // fold in what a cache saw: uses[key] tokens that selected the expert, layer_tokens[il] tokens the layer computed
++    // through the cache. What was recorded before decays by the tokens the layer has seen since.
++    void add(const std::vector<uint32_t> & uses, const std::vector<int64_t> & layer_tokens) {
++        if (uses.size() != score.size() || layer_tokens.size() != id.n_layer) {
++            return;
++        }
++        for (uint32_t il = 0; il < id.n_layer; ++il) {
++            const int64_t t = layer_tokens[il];
++            if (t <= 0) {
++                continue;
++            }
++            const float decay = std::exp2(-(float) t/half_life);
++            for (uint32_t e = 0; e < id.n_expert; ++e) {
++                float & s = score[(size_t) il*id.n_expert + e];
++                s = s*decay + (float) uses[(size_t) il*id.n_expert + e];
++            }
++            n_tokens += (uint64_t) t;
++        }
++    }
++
++    // the experts of `layers` to keep in `n` slots: those with a score, the highest first, a tie by layer and expert
++    // (so the choice is the same on every run)
++    std::vector<int32_t> best(const std::vector<int32_t> & layers, size_t n) const {
++        std::vector<int32_t> keys;
++        for (int32_t il : layers) {
++            if (il < 0 || (uint32_t) il >= id.n_layer) {
++                continue;
++            }
++            for (uint32_t e = 0; e < id.n_expert; ++e) {
++                if (score[(size_t) il*id.n_expert + e] > 0.0f) {
++                    keys.push_back(key(il, (int32_t) e));
++                }
++            }

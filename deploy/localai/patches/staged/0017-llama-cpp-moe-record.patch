++    // --- the file: the magic, the identity, the scores, a checksum of all of it; little endian ---
++
++    static uint64_t fnv1a(const void * data, size_t size, uint64_t h = 1469598103934665603ull) {
++        const uint8_t * p = (const uint8_t *) data;
++        for (size_t i = 0; i < size; ++i) {
++            h = (h ^ p[i])*1099511628211ull;
++        }
++        return h;
++    }
++
++    // the name of the record of these weights and this build in a directory: one file each, so two models, or two
++    // engines, never read each other's
++    static std::string file_name(const identity & of) {
++        uint64_t h = fnv1a(of.name.data(), of.name.size());
++        h = fnv1a(of.build.data(), of.build.size(), h);
++        const uint64_t dims[4] = { of.n_layer, of.n_expert, of.n_bytes, of.n_elements };
++        h = fnv1a(dims, sizeof(dims), h);
++        char buf[48];
++        snprintf(buf, sizeof(buf), "moe-record-%016llx.bin", (unsigned long long) h);
++        return buf;
++    }
++
++    std::vector<uint8_t> serialize() const {
++        std::vector<uint8_t> out;
++        auto put = [&](const void * p, size_t n) { out.insert(out.end(), (const uint8_t *) p, (const uint8_t *) p + n); };
++        auto u32 = [&](uint32_t v) { put(&v, sizeof(v)); };
++        auto u64 = [&](uint64_t v) { put(&v, sizeof(v)); };
++        auto str = [&](const std::string & s) { u32((uint32_t) s.size()); put(s.data(), s.size()); };
++        put(magic, sizeof(magic));
++        u32(id.n_layer);
++        u32(id.n_expert);
++        u64(id.n_bytes);
++        u64(id.n_elements);
++        str(id.name);
++        str(id.build);
++        u64(n_tokens);
++        put(score.data(), score.size()*sizeof(float));
++        u64(fnv1a(out.data(), out.size()));
++        return out;
++    }
++
++    enum status {
++        LOADED,
++        UNREADABLE,  // not a record, cut short, or its checksum does not hold
++        OTHER_MODEL, // a record of other weights or of another build of the engine
++    };
++
++    // reads a record of `of`; on anything else the record is left as it was
++    status deserialize(const uint8_t * data, size_t size, const identity & of) {
++        size_t pos = 0;
++        auto get = [&](void * p, size_t n) {
++            if (n > size - pos) {
++                return false;
++            }
++            memcpy(p, data + pos, n);
++            pos += n;
++            return true;
++        };
++        auto str = [&](std::string & s) {
++            uint32_t n = 0;
++            if (!get(&n, sizeof(n)) || n > 4096 || n > size - pos) {
++                return false;
++            }
++            s.assign((const char *) data + pos, n);
++            pos += n;
++            return true;
++        };
++        if (size < sizeof(magic) + sizeof(uint64_t) || memcmp(data, magic, sizeof(magic)) != 0) {
++            return UNREADABLE;
++        }
++        uint64_t sum = 0;
++        memcpy(&sum, data + size - sizeof(sum), sizeof(sum));
++        if (sum != fnv1a(data, size - sizeof(sum))) {
++            return UNREADABLE;
++        }
++        size -= sizeof(sum);
++        pos   = sizeof(magic);
++
++        identity in;
++        uint64_t tokens = 0;
++        if (!get(&in.n_layer, 4) || !get(&in.n_expert, 4) || !get(&in.n_bytes, 8) || !get(&in.n_elements, 8) ||
++            !str(in.name) || !str(in.build) || !get(&tokens, 8)) {
++            return UNREADABLE;
++        }
++        if (in.n_layer == 0 || in.n_expert == 0 || in.n_layer > max_dim || in.n_expert > max_dim) {
++            return UNREADABLE;
++        }
++        const size_t n = (size_t) in.n_layer*in.n_expert;
++        if (size - pos != n*sizeof(float)) {
++            return UNREADABLE;
++        }
++        if (!(in == of)) {
++            return OTHER_MODEL;
++        }
++        std::vector<float> in_score(n);
++        memcpy(in_score.data(), data + pos, n*sizeof(float));
++        for (float s : in_score) {
++            if (!(s >= 0.0f) || !std::isfinite(s)) { // a NaN compares false
++                return UNREADABLE;
++            }
++        }
++        id       = in;
++        score    = std::move(in_score);
++        n_tokens = tokens;
++        return LOADED;
++    }
++
++    // false if the file cannot be read at all (it does not exist, most often): nothing to say then
++    static bool read_file(const std::string & path, std::vector<uint8_t> & out) {
++        FILE * f = fopen(path.c_str(), "rb");
++        if (f == nullptr) {
++            return false;
++        }
++        out.clear();
++        uint8_t buf[65536];
++        size_t n;
++        while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
++            out.insert(out.end(), buf, buf + n);
++            if (out.size() > ((size_t) 1 << 30)) {
++                break; // no record is a gigabyte
++            }
++        }
++        const bool ok = ferror(f) == 0;
++        fclose(f);
++        return ok;
++    }
++
++    // the whole file beside the old one, then renamed over it: a reader sees the old record or the new, never a part
++    bool save(const std::string & path) const {
++        const std::vector<uint8_t> out = serialize();
++        const std::string tmp = path + ".tmp";
++        FILE * f = fopen(tmp.c_str(), "wb");
++        if (f == nullptr) {
++            return false;
++        }
++        const bool written = fwrite(out.data(), 1, out.size(), f) == out.size();
++        const bool closed  = fclose(f) == 0;
++        if (!written || !closed || rename(tmp.c_str(), path.c_str()) != 0) {
++            remove(tmp.c_str());
++            return false;
++        }
++        return true;
++    }
++};

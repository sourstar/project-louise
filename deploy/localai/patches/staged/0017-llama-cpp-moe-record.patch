++    uses[r.key(0, 5)] = 32;
++    uses[r.key(0, 1)] = 1;
++    uses[r.key(2, 7)] = 10;
++    r.add(uses, { 64, 0, 10 });
++    check(!r.empty() && r.n_tokens == 74, "what a cache saw is folded in");
++
++    const auto all = r.best({ 0, 1, 2 }, 100);
++    check(all == std::vector<int32_t>({ r.key(0, 3), r.key(0, 5), r.key(2, 7), r.key(0, 1) }),
++          "the experts with a score, the most used first, the unused left out");

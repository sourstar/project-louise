From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 07:13:08 +0000
Subject: [PATCH] fix(llama-cpp): a park waits for the host's reserve before
 each piece it copies to host memory

Carried as a llama.cpp patch beside the others
(patches/0025-sycl-park-paced-by-the-host-reserve.patch), after
0023-server-park-when-told.patch, whose park it paces.

A park copies a model's weights into host memory at full speed. On a host
whose page cache gives memory back slowly (the ZFS ARC: 24 s unmoved under a
10 GiB allocation, then 2.3 GiB back, measured on a node) that can take the
host under what it must keep free before the cache has given back.

With GGML_SYCL_PARK_HOST_RESERVE=<bytes> in the model's env the copy goes in
pieces of 256 MiB, and before each piece waits - in steps, at most
GGML_SYCL_PARK_HOST_WAIT_MS in all - while MemAvailable is under the reserve
plus the piece; at the bound the weights stay on the device (NO_MEMORY).
Unset, nothing changes. The reserve must not be above zfs_arc_sys_free, or
the wait waits for nothing.

Checked: a standalone test of 12 cases; the backend compiles with icpx. Not
run on a card.

Assisted-by: Claude Code
---
 ...-sycl-park-paced-by-the-host-reserve.patch | 295 ++++++++++++++++++
 1 file changed, 295 insertions(+)
 create mode 100644 backend/cpp/llama-cpp/patches/0025-sycl-park-paced-by-the-host-reserve.patch

diff --git a/backend/cpp/llama-cpp/patches/0025-sycl-park-paced-by-the-host-reserve.patch b/backend/cpp/llama-cpp/patches/0025-sycl-park-paced-by-the-host-reserve.patch
new file mode 100644
index 0000000..b1dd9ff
--- /dev/null
+++ b/backend/cpp/llama-cpp/patches/0025-sycl-park-paced-by-the-host-reserve.patch
@@ -0,0 +1,295 @@
+ggml-sycl: a park's copy to host memory waits for the host's reserve (GGML_SYCL_PARK_HOST_RESERVE)
+
+Parking copies a model's weights into ordinary host memory, which the kernel
+commits page by page as the copy writes it. On a host whose page cache gives
+memory back slowly - the ZFS ARC: a 10 GiB allocation, the ARC unmoved for
+24 s, then 2.3 GiB back (measured on a node) - a copy at full speed can take
+the host under what it must keep free before the cache has given back.
+
+With GGML_SYCL_PARK_HOST_RESERVE=<bytes> in a model's env, a park copies in
+pieces of 256 MiB and, before each piece, reads the host's MemAvailable;
+while it is under the reserve plus the piece the park waits, in steps of
+50 ms and at most GGML_SYCL_PARK_HOST_WAIT_MS (30000) in all. At that bound
+the park does not happen: the host copy is freed, the device memory was
+never released, NO_MEMORY - as a host with no room. A park that waited says
+how long. Unset (the default), the copy runs as before, one piece of 1 GiB
+after another, with no reading and no wait.
+
+The reserve must not be above what ZFS keeps free (zfs_arc_sys_free): ZFS
+gives memory back when the host's free memory falls under that, so a wait
+under a higher reserve waits for nothing and every park ends at its bound.
+MemAvailable that cannot be read is no reason to refuse.
+
+Checked: tests/test-sycl-park-pace.cpp, standard library only, 12 cases (no
+reserve: no reading; room: at once; under it: steps until the host is back;
+never back: refused after exactly the bound, the bound the park's and not
+the piece's; unreadable: goes; the switches as written in an env). The
+backend's object compiles with icpx (oneAPI 2025.3). Not run on a card.
+---
+diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
+index a7f6827..8cdcf36 100644
+--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
++++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
+@@ -71,6 +71,7 @@
+ #include "ggml-sycl/fused-gemm.hpp"
+ #include "ggml-sycl/gemm.hpp"
+ #include "ggml-sycl/getrows.hpp"
++#include "ggml-sycl/park-pace.hpp"
+ #include "ggml-sycl/mem.hpp"
+ #include "ggml-sycl/norm.hpp"
+ #include "ggml-sycl/presets.hpp"
+@@ -1397,6 +1398,27 @@ static uint64_t ggml_sycl_park_checksum(const void * data, size_t size) {
+ }
+ 
+ // host <-> device over the whole buffer, in pieces, each waited for
++static void ggml_sycl_park_copy(sycl::queue & q, void * dst, const void * src, size_t size);
++
++// device -> host for a park: paced on the host's free memory where a reserve is set (park-pace.hpp), as one copy
++// otherwise. false when the host stayed under its reserve for the whole bound; nothing is released then
++static bool ggml_sycl_park_copy_to_host(sycl::queue & q, void * dst, const void * src, size_t size, int64_t & waited_ms) {
++    const ggml_sycl_park_pace & pace = ggml_sycl_park_pace::env();
++    waited_ms = 0;
++    if (pace.reserve == 0) {
++        ggml_sycl_park_copy(q, dst, src, size);
++        return true;
++    }
++    for (size_t off = 0; off < size; off += ggml_sycl_park_pace::PIECE) {
++        const size_t n = std::min(ggml_sycl_park_pace::PIECE, size - off);
++        if (!ggml_sycl_park_wait_for_host(pace, n, ggml_sycl_host_mem_available, ggml_sycl_park_sleep_ms, waited_ms)) {
++            return false;
++        }
++        q.memcpy((char *) dst + off, (const char *) src + off, n).wait_and_throw();
++    }
++    return true;
++}
++
+ static void ggml_sycl_park_copy(sycl::queue & q, void * dst, const void * src, size_t size) {
+     for (size_t off = 0; off < size; off += ggml_sycl_parkable_mem::PIECE) {
+         const size_t n = std::min(ggml_sycl_parkable_mem::PIECE, size - off);
+@@ -1427,7 +1449,16 @@ static ggml_backend_park_status ggml_backend_sycl_buffer_park(ggml_backend_buffe
+                        buffer->size / 1024.0 / 1024.0, ctx->name.c_str());
+         return GGML_BACKEND_PARK_NO_MEMORY;
+     }
+-    ggml_sycl_park_copy(*ctx->stream, mem->host, ctx->dev_ptr, buffer->size);
++    int64_t waited_ms = 0;
++    if (!ggml_sycl_park_copy_to_host(*ctx->stream, mem->host, ctx->dev_ptr, buffer->size, waited_ms)) {
++        free_aligned_mem_host(mem->host);
++        mem->host = nullptr;
++        GGML_LOG_WARN("%s: the host stayed under its reserve of %.0f MiB for %lld ms while %.2f MiB of %s were copied "
++                      "to it: it stays on the device\n", __func__,
++                      ggml_sycl_park_pace::env().reserve / 1024.0 / 1024.0, (long long) waited_ms,
++                      buffer->size / 1024.0 / 1024.0, ctx->name.c_str());
++        return GGML_BACKEND_PARK_NO_MEMORY;
++    }
+     const int64_t t_copied = ggml_time_us();
+ 
+     char said[64] = "";
+@@ -1446,9 +1477,13 @@ static ggml_backend_park_status ggml_backend_sycl_buffer_park(ggml_backend_buffe
+     mem->n_park++;
+ 
+     const int64_t t_end = ggml_time_us();
+-    GGML_LOG_INFO("%s: %s parked, %.2f MiB to the host in %.1f ms (the copy %.1f, the release %.1f)%s; park %" PRIu64 "\n",
++    char paced[96] = "";
++    if (waited_ms > 0) {
++        snprintf(paced, sizeof(paced), ", %lld ms of it waiting for the host's reserve", (long long) waited_ms);
++    }
++    GGML_LOG_INFO("%s: %s parked, %.2f MiB to the host in %.1f ms (the copy %.1f%s, the release %.1f)%s; park %" PRIu64 "\n",
+                   __func__, ctx->name.c_str(), buffer->size / 1024.0 / 1024.0,
+-                  (t_end - t_start - (t_summed - t_copied)) / 1000.0, (t_copied - t_start) / 1000.0,
++                  (t_end - t_start - (t_summed - t_copied)) / 1000.0, (t_copied - t_start) / 1000.0, paced,
+                   (t_end - t_summed) / 1000.0, said, mem->n_park);
+     return GGML_BACKEND_PARK_OK;
+ }
+diff --git a/ggml/src/ggml-sycl/park-pace.hpp b/ggml/src/ggml-sycl/park-pace.hpp
+new file mode 100644
+index 0000000..ec8835e
+--- /dev/null
++++ b/ggml/src/ggml-sycl/park-pace.hpp
+@@ -0,0 +1,101 @@
++#pragma once
++// A park's copy to host memory, paced on the host's free memory (GGML_SYCL_PARK_HOST_RESERVE).
++//
++// Parking copies a model's weights into ordinary host memory, which the kernel commits page by page as the copy
++// writes it. On a host whose page cache gives memory back slowly - the ZFS ARC: measured on a node, 2026-11-26, a
++// 10 GiB allocation, the ARC unmoved for 24 s, then 2.3 GiB back - a copy that runs at full speed can take the host
++// under what it must keep free before the cache has given anything back. With a reserve set, the copy goes in pieces
++// and, before each piece, waits (in steps, at most GGML_SYCL_PARK_HOST_WAIT_MS) while the host's MemAvailable is under
++// the reserve plus the piece; at that bound the park does not happen: the weights stay on the device, NO_MEMORY, as a
++// host with no room. Without a reserve (the default) the copy runs as before, without a wait.
++//
++// THE RESERVE MUST NOT BE ABOVE WHAT ZFS KEEPS FREE (zfs_arc_sys_free): ZFS gives memory back when the host's free
++// memory falls under that, so a wait under a higher reserve waits for nothing and every park ends at the bound.
++
++#include <chrono>
++#include <cstdint>
++#include <cstdio>
++#include <cstdlib>
++#include <cstring>
++#include <limits>
++#include <thread>
++
++struct ggml_sycl_park_pace {
++    size_t  reserve = 0;      // bytes the host keeps free while weights are copied into it; 0: no pacing
++    int64_t wait_ms = 30000;  // the longest a park waits for the host, in all
++    int64_t step_ms = 50;     // between two readings
++
++    static constexpr size_t PIECE = 256ull << 20; // the copy's pieces when paced
++
++    static ggml_sycl_park_pace from(const char * reserve, const char * wait_ms) {
++        ggml_sycl_park_pace p;
++        if (reserve && reserve[0]) {
++            char * end = nullptr;
++            const unsigned long long v = strtoull(reserve, &end, 10);
++            if (end && *end == '\0') {
++                p.reserve = (size_t) v;
++            }
++        }
++        if (wait_ms && wait_ms[0]) {
++            char * end = nullptr;
++            const long long v = strtoll(wait_ms, &end, 10);
++            if (end && *end == '\0' && v >= 0) {
++                p.wait_ms = (int64_t) v;
++            }
++        }
++        return p;
++    }
++
++    static const ggml_sycl_park_pace & env() {
++        static const ggml_sycl_park_pace p =
++            from(std::getenv("GGML_SYCL_PARK_HOST_RESERVE"), std::getenv("GGML_SYCL_PARK_HOST_WAIT_MS"));
++        return p;
++    }
++};
++
++// MemAvailable of /proc/meminfo, in bytes; SIZE_MAX where it cannot be read (no reading, no wait: the park is not
++// refused on a guess - the server's own check came before it)
++static inline size_t ggml_sycl_host_mem_available() {
++    FILE * f = fopen("/proc/meminfo", "r");
++    if (!f) {
++        return std::numeric_limits<size_t>::max();
++    }
++    char line[256];
++    size_t kb = std::numeric_limits<size_t>::max();
++    while (fgets(line, sizeof(line), f)) {
++        unsigned long long v = 0;
++        if (sscanf(line, "MemAvailable: %llu kB", &v) == 1) {
++            kb = (size_t) v;
++            break;
++        }
++    }
++    fclose(f);
++    return kb == std::numeric_limits<size_t>::max() ? kb : kb * 1024;
++}
++
++// Before a piece of `need` bytes: true at once where the host has the reserve and the piece available, or where no
++// reserve is set; else reads again every step_ms until it has, and false once the park has waited wait_ms in all.
++// `waited_ms` is the park's running total. `available` and `sleep_ms` are the host's, or a test's.
++template <typename Available, typename Sleep>
++static bool ggml_sycl_park_wait_for_host(const ggml_sycl_park_pace & pace, size_t need, Available && available,
++                                         Sleep && sleep_ms, int64_t & waited_ms) {
++    if (pace.reserve == 0) {
++        return true;
++    }
++    for (;;) {
++        const size_t have = available();
++        if (have == std::numeric_limits<size_t>::max() || have >= pace.reserve + need) {
++            return true;
++        }
++        if (waited_ms >= pace.wait_ms) {
++            return false;
++        }
++        const int64_t step = std::min(pace.step_ms, pace.wait_ms - waited_ms);
++        sleep_ms(step);
++        waited_ms += step;
++    }
++}
++
++static inline void ggml_sycl_park_sleep_ms(int64_t ms) {
++    std::this_thread::sleep_for(std::chrono::milliseconds(ms));
++}
+diff --git a/tests/test-sycl-park-pace.cpp b/tests/test-sycl-park-pace.cpp
+new file mode 100644
+index 0000000..7234e91
+--- /dev/null
++++ b/tests/test-sycl-park-pace.cpp
+@@ -0,0 +1,78 @@
++// A park's copy paced on the host's free memory (ggml/src/ggml-sycl/park-pace.hpp). Standard library only:
++//   c++ -std=c++17 -I ggml/src/ggml-sycl tests/test-sycl-park-pace.cpp -o test-sycl-park-pace && ./test-sycl-park-pace
++
++#include <algorithm>
++#include <cstdio>
++#include <vector>
++
++#include "park-pace.hpp"
++
++static int failed = 0;
++
++static void expect(bool ok, const char * what) {
++    if (!ok) {
++        failed++;
++    }
++    printf("%s %s\n", ok ? "ok:  " : "FAIL:", what);
++}
++
++int main() {
++    const size_t mib = 1ull << 20, gib = 1ull << 30;
++    std::vector<int64_t> slept;
++    auto sleep = [&](int64_t ms) { slept.push_back(ms); };
++
++    {   // no reserve: no reading, no wait - the copy as before
++        ggml_sycl_park_pace pace;
++        int64_t waited = 0, reads = 0;
++        const bool go = ggml_sycl_park_wait_for_host(pace, 256 * mib, [&] { reads++; return (size_t) 0; }, sleep, waited);
++        expect(go && waited == 0 && reads == 0 && slept.empty(), "no reserve set: the copy goes, the host not even read");
++    }
++    {   // room for the reserve and the piece: at once
++        ggml_sycl_park_pace pace = ggml_sycl_park_pace::from("2147483648", nullptr);
++        int64_t waited = 0;
++        const bool go = ggml_sycl_park_wait_for_host(pace, 256 * mib, [&] { return 2 * gib + 256 * mib; }, sleep, waited);
++        expect(go && waited == 0 && slept.empty(), "the reserve and the piece available: at once");
++    }
++    {   // under it: waits in steps while the host gives memory back, and goes on when it has
++        ggml_sycl_park_pace pace = ggml_sycl_park_pace::from("2147483648", "30000");
++        std::vector<size_t> readings = { gib, gib + 512 * mib, 2 * gib, 2 * gib + 256 * mib };
++        size_t i = 0;
++        int64_t waited = 0;
++        slept.clear();
++        const bool go = ggml_sycl_park_wait_for_host(pace, 256 * mib, [&] { return readings[std::min(i++, readings.size() - 1)]; },
++                                                     sleep, waited);
++        expect(go && waited == 150 && slept == std::vector<int64_t>({ 50, 50, 50 }),
++               "under the reserve: three steps of 50 ms, then the piece goes");
++    }
++    {   // never back: false at the bound, the bound kept to the ms, across pieces
++        ggml_sycl_park_pace pace = ggml_sycl_park_pace::from("2147483648", "120");
++        int64_t waited = 0;
++        slept.clear();
++        const bool go = ggml_sycl_park_wait_for_host(pace, 256 * mib, [&] { return gib; }, sleep, waited);
++        expect(!go && waited == 120 && slept == std::vector<int64_t>({ 50, 50, 20 }),
++               "the host never back over its reserve: no park, after exactly the bound");
++        int64_t again = 100;   // a later piece of the same park has only what is left of the bound
++        slept.clear();
++        const bool later = ggml_sycl_park_wait_for_host(pace, 256 * mib, [&] { return gib; }, sleep, again);
++        expect(!later && again == 120 && slept == std::vector<int64_t>({ 20 }), "the bound is the park's, not the piece's");
++    }
++    {   // a host that cannot be read is not refused on a guess
++        ggml_sycl_park_pace pace = ggml_sycl_park_pace::from("2147483648", nullptr);
++        int64_t waited = 0;
++        const bool go = ggml_sycl_park_wait_for_host(pace, 256 * mib, [] { return std::numeric_limits<size_t>::max(); }, sleep, waited);
++        expect(go && waited == 0, "MemAvailable not readable: the copy goes");
++    }
++    {   // the switches as written in a model's env
++        expect(ggml_sycl_park_pace::from(nullptr, nullptr).reserve == 0, "unset: no reserve");
++        expect(ggml_sycl_park_pace::from("0", nullptr).reserve == 0, "0: no reserve");
++        expect(ggml_sycl_park_pace::from("4294967296", "5000").reserve == 4 * gib &&
++               ggml_sycl_park_pace::from("4294967296", "5000").wait_ms == 5000, "a reserve and a bound in bytes and ms");
++        expect(ggml_sycl_park_pace::from("4 GiB", "-1").reserve == 0 && ggml_sycl_park_pace::from("4 GiB", "-1").wait_ms == 30000,
++               "what is not a number is not read: no reserve, the default bound");
++        expect(ggml_sycl_park_pace::PIECE == 256 * mib, "pieces of 256 MiB");
++        const size_t have = ggml_sycl_host_mem_available();
++        expect(have > 0, "this host's MemAvailable is read");
++    }
++    printf("%s\n", failed ? "FAILED" : "all passed");
++    return failed ? 1 : 0;
++}
+-- 
+2.43.0

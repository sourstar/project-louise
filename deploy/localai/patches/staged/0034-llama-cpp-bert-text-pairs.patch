+int main() {
+    using namespace llama_grpc;
+    const int32_t CLS = 101, SEP = 102;
+
+    // the marker: at the start a pair, absent one text, elsewhere refused
+    check(pair_body(PAIR_MARK + "[\"t\", \"a\"]") == std::optional<std::string>("[\"t\", \"a\"]"),
+          "a pair: the JSON after the marker");
+    check(!pair_body("an abstract").has_value(), "one text: no pair");
+    check(throws([&] { pair_body("x" + PAIR_MARK + "[]"); }), "the marker inside a text is refused");
+    check(PAIR_MARK == std::string("\x1eLOUISE-PAIR\x1e"), "the marker is VeGa's (app/vega/tag.py PAIR_MARK)");
+
+    // longest first, as Hugging Face cuts: every row of its table
+    size_t agree = 0, rows = sizeof(HF) / sizeof(HF[0]);
+    for (const auto & r : HF) {
+        const auto kept = longest_first((size_t) r[1], (size_t) r[2], (size_t) r[0] - 3);
+        agree += kept.first == (size_t) r[3] && kept.second == (size_t) r[4];
+    }
+    check(rows > 200 && agree == rows, "longest first keeps what Hugging Face keeps: " + std::to_string(agree) + " of " +
+          std::to_string(rows) + " rows");
+
+    // [CLS] a [SEP] b [SEP], whole when it fits
+    {
+        const auto p = pair_tokens(CLS, SEP, { 7, 8 }, { 9, 10, 11 }, 512);
+        check(p.tokens == std::vector<int32_t>({ CLS, 7, 8, SEP, 9, 10, 11, SEP }) && p.first == 2 && p.second == 3,
+              "a pair that fits: [CLS] a [SEP] b [SEP]");
+    }
+    // a short title, a long abstract: the abstract is cut, the title kept
+    {
+        const auto p = pair_tokens(CLS, SEP, run(1000, 20), run(2000, 600), 512);
+        check(p.tokens.size() == 512 && p.first == 20 && p.second == 489 && p.tokens[21] == SEP && p.tokens.back() == SEP &&
+              p.tokens[22] == 2000 && p.tokens[510] == 2000 + 488,
+              "a short title and a long abstract: the abstract cut to 489, the whole 512");
+    }
+    // both long: half each, the second the odd token
+    {
+        const auto p = pair_tokens(CLS, SEP, run(1000, 400), run(2000, 400), 512);
+        check(p.first == 254 && p.second == 255 && p.tokens.size() == 512, "both long: 254 and 255");
+    }
+    // an empty second segment: [CLS] a [SEP] [SEP]
+    check(pair_tokens(CLS, SEP, { 7 }, {}, 512).tokens == std::vector<int32_t>({ CLS, 7, SEP, SEP }),
+          "an empty second segment: [CLS] a [SEP] [SEP]");
+    // a separator inside the first segment is refused; inside the second it is the text's own
+    check(throws([&] { pair_tokens(CLS, SEP, { 7, SEP, 8 }, { 9 }, 512); }), "a [SEP] inside the first segment is refused");
+    check(!throws([&] { pair_tokens(CLS, SEP, { 7 }, { 9, SEP, 10 }, 512); }), "a [SEP] inside the second segment is kept");
+    check(throws([&] { pair_tokens(CLS, SEP, {}, {}, 2); }), "a bound under the three special tokens is refused");
+
+    // one text in a pair model: a [SEP] anywhere but its end
+    check(!has_inner_separator({ CLS, 7, 8, SEP }, SEP), "one text: its closing [SEP] is not inside it");
+    check(has_inner_separator({ CLS, 7, SEP, 8, SEP }, SEP), "one text with a [SEP] inside it");
+    check(!has_inner_separator({}, SEP), "no tokens: nothing inside");
+
+    std::printf("%s\n", failures == 0 ? "all passed" : "FAILED");
+    return failures == 0 ? 0 : 1;
+}

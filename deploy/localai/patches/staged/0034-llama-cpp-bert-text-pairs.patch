++// The segment of each of `n_tokens` tokens: `token[i]` at position `pos[i]`
++// in sequence `seq[i]`; `sep` the separator. Positions decide "after", not
++// the tokens' order in the batch.
++static inline std::vector<int32_t> llama_pair_segments(
++        int32_t n_tokens, const int32_t * token, const int32_t * pos, const int32_t * seq, int32_t sep) {
++    std::unordered_map<int32_t, int32_t> first_sep; // sequence -> position of its first separator
++    for (int32_t i = 0; i < n_tokens; ++i) {
++        if (token[i] != sep) {
++            continue;
++        }
++        auto it = first_sep.find(seq[i]);
++        if (it == first_sep.end() || pos[i] < it->second) {
++            first_sep[seq[i]] = pos[i];
++        }
++    }
++    std::vector<int32_t> segment(n_tokens, 0);
++    for (int32_t i = 0; i < n_tokens; ++i) {
++        const auto it = first_sep.find(seq[i]);
++        segment[i] = it != first_sep.end() && pos[i] > it->second ? 1 : 0;
++    }
++    return segment;
++}

++// A TEXT PAIR'S SEGMENTS for a BERT graph (a context made with pair_segments).
++//
++// A BERT reads a text pair as `[CLS] a [SEP] b [SEP]`, the first segment's
++// tokens with token-type row 0 and the second's with row 1: Hugging Face's
++// pair template gives token_type_ids 0 to `[CLS] a [SEP]` and 1 to `b [SEP]`.
++// llama.cpp's graph gave row 0 to every token, so a model trained on pairs
++// (MedCPT's article encoder: title and abstract; its cross-encoder: query and
++// article) read its second segment as a continuation of the first.
++//
++// The segment is read off the tokens themselves: a token after the first
++// separator of its sequence, by position, is in segment 1; everything up to
++// and including that separator is in segment 0. A single text, `[CLS] a
++// [SEP]`, is all 0 - what the graph gave before. The rule holds only while the
++// first segment carries no separator of its own: the caller that builds the
++// pair refuses one that does (a literal "[SEP]" in a title, tokenized as the
++// special token, as Hugging Face's tokenizer does).
++//
++// Standard library only (tests/test-bert-pair-segments.cpp).
++
++#include <cstdint>
++#include <unordered_map>
++#include <vector>

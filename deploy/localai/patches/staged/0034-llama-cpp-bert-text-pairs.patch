diff --git a/backend/cpp/llama-cpp/text_pair.h b/backend/cpp/llama-cpp/text_pair.h
new file mode 100644
index 0000000..a68a629
--- /dev/null
+++ b/backend/cpp/llama-cpp/text_pair.h
@@ -0,0 +1,123 @@
+#pragma once
+
+// A TEXT PAIR for a BERT that reads two segments (the model option
+// `pairs:true`; MedCPT's article encoder reads a title and an abstract, its
+// cross-encoder a query and an article).
+//
+// VeGa's wrapper sends a pair as PAIR_MARK followed by the JSON array
+// [first, second] (deploy/vega/vega_wrapper.py, app/vega/tag.py
+// `backend_pair`), and only to a model loaded with `pairs:true`. The backend
+// builds what Hugging Face's pair tokenizer builds, the model card's
+// `tokenizer([[a, b]], truncation=True, max_length=M)`:
+//
+//     [CLS] a [SEP] b [SEP]      segment 0: [CLS] a [SEP]   segment 1: b [SEP]
+//
+// the two segments cut LONGEST FIRST so that the whole is at most M tokens
+// (`longest_first`, Hugging Face tokenizers' TruncationStrategy::LongestFirst,
+// tokenizers/src/utils/truncation.rs), and libllama's BERT graph gives a
+// token after its sequence's first [SEP] token-type row 1
+// (src/llama-pair-segments.h, the context's pair_segments). That rule holds
+// only while the first segment carries no [SEP] of its own, so a first
+// segment that does is REFUSED, never read wrongly (a literal "[SEP]" in a
+// title is the special token, as in Hugging Face's tokenizer); so is a single
+// text, in a pair model, with a [SEP] inside it.
+//
+// Standard library only (text_pair_test.cpp); the JSON behind the marker is
+// read by grpc-server.cpp.
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace llama_grpc {
+
+// app/vega/tag.py PAIR_MARK: record separators around a name no text carries
+inline const std::string PAIR_MARK = "\x1e" "LOUISE-PAIR" "\x1e";
+
+// The JSON text after the marker when `content` is a pair; nullopt for one
+// text. A marker anywhere but at the start is refused: only VeGa writes it.
+inline std::optional<std::string> pair_body(const std::string & content) {
+    if (content.compare(0, PAIR_MARK.size(), PAIR_MARK) == 0) {
+        return content.substr(PAIR_MARK.size());
+    }
+    if (content.find(PAIR_MARK) != std::string::npos) {
+        throw std::invalid_argument("a text carries the pair marker inside it: a pair starts with it, and only VeGa writes it");
+    }
+    return std::nullopt;
+}
+
+// How many tokens of each segment Hugging Face keeps when the two, `n1` and
+// `n2` tokens, must fit in `max_len` (the bound less the special tokens):
+// tokenizers/src/utils/truncation.rs, TruncationStrategy::LongestFirst. The
+// shorter segment is kept whole while it fits in half; otherwise each gets
+// half, the second segment the odd token.
+inline std::pair<size_t, size_t> longest_first(size_t n1, size_t n2, size_t max_len) {
+    if (n1 + n2 <= max_len) {
+        return { n1, n2 };
+    }
+    size_t a = n1, b = n2;
+    const bool swap = a > b;
+    if (swap) {
+        std::swap(a, b);
+    }
+    b = a > max_len ? a : std::max(a, max_len - a);
+    if (a + b > max_len) {
+        a = max_len / 2;
+        b = a + max_len % 2;
+    }
+    if (swap) {
+        std::swap(a, b);
+    }
+    return { std::min(a, n1), std::min(b, n2) };
+}
+
+struct PairTokens {
+    std::vector<int32_t> tokens; // [CLS] a [SEP] b [SEP]
+    size_t first  = 0;           // tokens of a kept
+    size_t second = 0;           // tokens of b kept
+};
+
+// `[CLS] a [SEP] b [SEP]`, at most `max_tokens` in all, from the segments'
+// own tokens (no special tokens added). Throws std::invalid_argument for a
+// [SEP] inside `a`, or a bound that cannot hold the three special tokens.
+inline PairTokens pair_tokens(int32_t cls, int32_t sep, const std::vector<int32_t> & a,
+                              const std::vector<int32_t> & b, size_t max_tokens) {
+    for (const int32_t t : a) {
+        if (t == sep) {
+            throw std::invalid_argument("a text pair's first segment holds the separator token itself: the second "
+                                        "segment would start there, so the pair is not embedded");
+        }
+    }
+    if (max_tokens < 3) {
+        throw std::invalid_argument("a text pair needs a bound of at least its three special tokens");
+    }
+    const auto [k1, k2] = longest_first(a.size(), b.size(), max_tokens - 3);
+    PairTokens out;
+    out.first  = k1;
+    out.second = k2;
+    out.tokens.reserve(k1 + k2 + 3);
+    out.tokens.push_back(cls);
+    out.tokens.insert(out.tokens.end(), a.begin(), a.begin() + (std::ptrdiff_t) k1);
+    out.tokens.push_back(sep);
+    out.tokens.insert(out.tokens.end(), b.begin(), b.begin() + (std::ptrdiff_t) k2);
+    out.tokens.push_back(sep);
+    return out;
+}
+
+// A single text in a pair model, tokenized with its special tokens: true when
+// a [SEP] stands anywhere but at its end (the graph would read what follows as
+// a second segment).
+inline bool has_inner_separator(const std::vector<int32_t> & tokens, int32_t sep) {
+    for (size_t i = 0; i + 1 < tokens.size(); ++i) {
+        if (tokens[i] == sep) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace llama_grpc

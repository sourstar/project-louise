++    expect(!ggml_sycl_op_refusal(false, false, node), "the same outside a graph (a load) ends the process as before");
++    expect(ggml_sycl_op_refusal(true, true, "Native API failed"), "errc::memory_allocation within a graph, whatever the words");
++    expect(!ggml_sycl_op_refusal(true, false, "level_zero backend failed with error: 38 (UR_RESULT_ERROR_OUT_OF_HOST_MEMORY)"),
++           "the host's memory is not the device's refusal");
++    expect(!ggml_sycl_op_refusal(true, false, "level_zero backend failed with error: 20 (UR_RESULT_ERROR_DEVICE_LOST)"),
++           "a device lost is a failure, not a refusal");
++    expect(!ggml_sycl_op_refusal(true, false, nullptr), "no words: not a refusal");
++    expect(ggml_sycl_says_out_of_device_memory("... PI_ERROR_OUT_OF_DEVICE_MEMORY ..."), "an older runtime's words too");

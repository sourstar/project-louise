+         g_ggml_sycl_graph_refuse = ggml_sycl_get_env("GGML_SYCL_GRAPH_REFUSE", 0);
++        g_ggml_sycl_op_refuse = ggml_sycl_get_env("GGML_SYCL_OP_REFUSE", 0);
+         if (const char * arm = getenv("GGML_SYCL_GRAPH_REFUSE_ARM")) {

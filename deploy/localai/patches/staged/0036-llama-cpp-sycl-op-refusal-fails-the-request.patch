++++ b/ggml/src/ggml-sycl/op-refusal.hpp
+@@ -0,0 +1,31 @@
++#pragma once
++// A DEVICE'S REFUSAL OF MEMORY MET INSIDE AN OP, failed as the pool's refusal is.
++//
++// The pool's refusal (ggml_sycl_out_of_device_memory, thrown by the pool and caught by
++// ggml_sycl_graph_compute_or_fail) fails the graph and the process goes on. A refusal met anywhere else in an op did
++// not: a kernel's launch, a copy or a library call (oneMKL allocates its own workspace) raises a sycl::exception, and
++// the op's own handler - its function-try-block, or CHECK_TRY_ERROR around one call - ended the process. On a card
++// shared with other models that is contention, not a fault: a node, 2026-11-27, a speech request on a card at 30.7
++// of 32 GB, "level_zero backend failed with error: 39 (UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY)Exception caught at
++// file:.../ggml-sycl.cpp, line:3828", the backend exited 1 and LocalAI loaded it again.
++//
++// The rule: WITHIN A GRAPH, an exception that says the device had no memory - errc::memory_allocation, or the
++// runtime's words for it, which come with errc::runtime and the cause in the message alone - is answered as the
++// pool's refusal. Anything else, and anything outside a graph (a load, a copy of weights), ends the process as
++// before: a device that FAILS is no request's to survive.
++//
++// Standard library only (tests/test-sycl-op-refusal.cpp).
++
++#include <cstring>
++
++// the runtime's words for a refusal of device memory: Level Zero's error 39 as it reaches a sycl::exception
++// ("level_zero backend failed with error: 39 (UR_RESULT_ERROR_OUT_OF_DEVICE_MEMORY)"); the host's own memory
++// (UR_RESULT_ERROR_OUT_OF_HOST_MEMORY) is not the device's and is not a refusal of it
++static inline bool ggml_sycl_says_out_of_device_memory(const char * what) {
++    return what != nullptr && strstr(what, "OUT_OF_DEVICE_MEMORY") != nullptr;
++}
++
++// whether an exception an op met fails the graph (true) or ends the process (false)
++static inline bool ggml_sycl_op_refusal(bool in_graph, bool memory_allocation, const char * what) {
++    return in_graph && (memory_allocation || ggml_sycl_says_out_of_device_memory(what));
++}

++// mtmd_audio_preprocessor_omnivoice
++//
++// The codec reads the clip twice: the acoustic encoder at 24 kHz, HuBERT at 16 kHz with 160 zeros on each side.
++// The resampler is omnivoice.cpp's (the Kaiser-windowed sinc of torchaudio): the codes depend on it.
++//
++
++namespace omnivoice_ref {
++#include <omnivoice/audio-resample.h>
++} // namespace omnivoice_ref
++
++bool mtmd_audio_preprocessor_omnivoice::process(const float * samples, size_t n_samples, std::vector<mtmd_audio_mel> & output, bool /*shape_only*/) const {
++    const size_t hop = (size_t) hparams.audio_samples_per_token();
++    const size_t n   = n_samples / hop * hop; // a partial frame at the end is dropped, like the reference
++    if (n == 0 || n > (size_t) INT32_MAX / 2) {
++        return false;
++    }
++    int n_16k = 0;
++    float * a16 = omnivoice_ref::audio_resample(samples, (int) n, hparams.audio_sample_rate, 16000, 1, &n_16k);
++    if (!a16 || (size_t) n_16k != n / 3 * 2) {
++        free(a16);
++        LOG_ERR("%s: failed to resample the clip\n", __func__);
++        return false;
++    }
++
++    mtmd_audio_mel out;
++    out.n_mel     = 1;
++    out.n_len     = mtmd_hparams::omnivoice_spk_n_input((int32_t) (n / hop));
++    out.n_len_org = (int64_t) n_samples;
++    out.data.assign((size_t) out.n_len, 0.0f);
++    std::copy(samples, samples + n, out.data.begin());
++    std::copy(a16, a16 + n_16k, out.data.begin() + n + 160);
++    free(a16);
++
++    output.push_back(std::move(out));
++    return true;
++}

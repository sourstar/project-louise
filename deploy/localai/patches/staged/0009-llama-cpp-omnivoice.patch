++    static void log_softmax(float * x, int n) {
++        float m = x[0];
++        for (int v = 1; v < n; v++) {
++            if (x[v] > m) {
++                m = x[v];
++            }
++        }
++        float sum = 0.0f;
++        for (int v = 0; v < n; v++) {
++            sum += std::exp(x[v] - m);
++        }
++        const float lse = m + std::log(sum);
++        for (int v = 0; v < n; v++) {
++            x[v] = x[v] - lse;
++        }
++    }

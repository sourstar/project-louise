++        } else {
++            if (prev_was_ws) {
++                last_word_byte_start = byte_pos;
++            }
++            any_non_ws           = true;
++            trailing_ws_start_at = byte_pos + (size_t) n;
++        }
++        prev_was_ws = is_ws;
++        p += n;
++    }

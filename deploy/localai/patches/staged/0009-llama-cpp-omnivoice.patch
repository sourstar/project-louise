+ struct mtmd_graph_kokoro : mtmd_graph {
+     enum stage_type {
+         STAGE_TEXT, // tokens -> text encoder CNN
+diff --git a/tools/mtmd/models/omnivoice.cpp b/tools/mtmd/models/omnivoice.cpp
+new file mode 100644
+index 0000000..ef3baa8
+--- /dev/null
++++ b/tools/mtmd/models/omnivoice.cpp
+@@ -0,0 +1,343 @@
++#include "models.h"
++
++// OmniVoice (k2-fsa/OmniVoice): what the mmproj holds, the backbone being the text model (src/models/omnivoice.cpp)
++// - the audio heads: one linear layer, the 8 codebooks side by side
++// - the codec of Higgs Audio v2: 8 residual codebooks, then a DAC decoder, 24 kHz, 960 samples per frame
++// the decoder follows omnivoice.cpp (MIT, https://github.com/ServeurpersoCom/omnivoice.cpp) op for op, but for the
++// transposed convolutions of odd stride, see conv_transpose()
++
++ggml_tensor * mtmd_graph_omnivoice::tensor(const std::string & name) const {
++    const auto it = model.cbx_tensors.find("a.gen." + name);
++    if (it == model.cbx_tensors.end() || !it->second) {
++        throw std::runtime_error("omnivoice: missing tensor a.gen." + name);
++    }
++    return it->second;
++}
++
++ggml_cgraph * mtmd_graph_omnivoice::output(const char * name, ggml_tensor * t) const {
++    ggml_set_name(t, name);
++    ggml_set_output(t);
++    ggml_build_forward_expand(gf, t);
++    return gf;
++}
++
++// x + sin^2(alpha x) / (alpha + 1e-9), x: [T, C]; the reciprocal is folded at conversion
++// the five nodes are consecutive, a backend can fuse them
++ggml_tensor * mtmd_graph_omnivoice::snake(const std::string & name, ggml_tensor * x) const {
++    ggml_tensor * t = ggml_mul(ctx0, x, tensor(name + ".alpha"));
++    t = ggml_sin(ctx0, t);
++    t = ggml_sqr(ctx0, t);
++    t = ggml_mul(ctx0, t, tensor(name + ".inv_b"));
++    return ggml_add(ctx0, x, t);
++}
++
++// same-length convolution, stride 1; x: [T, IC], weight: [K, IC, OC], returns [T, OC]

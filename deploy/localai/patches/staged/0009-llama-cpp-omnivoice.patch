++// Sum of per-character weights over a UTF-8 string.
++static float duration_total_weight(const std::string & utf8) {
++    float  total = 0.0f;
++    size_t i     = 0;
++    while (i < utf8.size()) {
++        uint32_t cp = 0;
++        int      n  = duration_utf8_decode(utf8.data() + i, utf8.size() - i, &cp);
++        if (n == 0) {
++            i++;
++            continue;
++        }
++        total += duration_get_char_weight(cp);
++        i += n;
++    }
++    return total;
++}

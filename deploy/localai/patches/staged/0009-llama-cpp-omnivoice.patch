++    while (p < end) {
++        int n = chunker_utf8_len(*p);
++        if (p + n > end) {
++            n = (int) (end - p);
++        }
++        std::string cp((const char *) p, (size_t) n);
++        size_t      byte_pos = (size_t) (p - (const unsigned char *) s.data());

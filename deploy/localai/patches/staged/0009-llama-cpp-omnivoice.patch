++//
++// reference clip -> codes -> backbone rows (voice cloning)
++//
++// The codec's encoder, as in omnivoice.cpp: HuBERT reads the clip at 16 kHz and a small conv stack turns the mean of
++// its 13 hidden states into semantic features (768 per frame); a DAC encoder reads it at 24 kHz (256 per frame); a
++// linear layer joins the two and 8 residual codebooks quantize the result. The row of a frame is the sum of the
++// embeddings of its 8 codes, what the backbone reads for a frame of audio.
++//
++
++ggml_tensor * mtmd_graph_omnivoice_spkenc::tensor(const std::string & name) const {
++    const auto it = model.cbx_tensors.find(name);
++    if (it == model.cbx_tensors.end() || !it->second) {
++        throw std::runtime_error("omnivoice: missing tensor " + name);
++    }
++    return it->second;
++}
++
++ggml_tensor * mtmd_graph_omnivoice_spkenc::snake(const std::string & name, ggml_tensor * x) const {
++    ggml_tensor * t = ggml_mul(ctx0, x, tensor(name + ".alpha"));
++    t = ggml_sin(ctx0, t);
++    t = ggml_sqr(ctx0, t);
++    t = ggml_mul(ctx0, t, tensor(name + ".inv_b"));
++    return ggml_add(ctx0, x, t);
++}
++
++// x: [T, IC], w: [K, IC, OC], returns [T_out, OC]
++ggml_tensor * mtmd_graph_omnivoice_spkenc::conv(ggml_tensor * w, ggml_tensor * b, ggml_tensor * x, int stride, int pad, int dilation) const {
++    ggml_tensor * y = ggml_conv_2d_direct(ctx0,
++            ggml_reshape_4d(ctx0, w, w->ne[0], 1, w->ne[1], w->ne[2]),
++            ggml_reshape_4d(ctx0, x, x->ne[0], 1, x->ne[1], 1), stride, 1, pad, 0, dilation, 1);
++    y = ggml_reshape_2d(ctx0, y, y->ne[0], y->ne[2]);
++    return b ? ggml_add(ctx0, y, ggml_reshape_2d(ctx0, b, 1, b->ne[0])) : y;
++}
++
++ggml_tensor * mtmd_graph_omnivoice_spkenc::conv(const std::string & name, ggml_tensor * x, int stride, int pad, int dilation, bool bias) const {
++    return conv(tensor(name + ".weight"), bias ? tensor(name + ".bias") : nullptr, x, stride, pad, dilation);

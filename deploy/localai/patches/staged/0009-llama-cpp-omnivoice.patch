++    // _combine_text of the reference: the voice's transcript before the text, no line break, ASCII parentheses,
++    // single spaces, and no space next to a CJK ideograph
++    static std::string combine_text(const std::string & text, const std::string & ref_text) {
++        auto strip = [](const std::string & s) {
++            size_t a = 0, b = s.size();
++            while (a < b && (s[a] == ' ' || s[a] == '\t')) { a++; }
++            while (b > a && (s[b - 1] == ' ' || s[b - 1] == '\t')) { b--; }
++            return s.substr(a, b - a);
++        };
++        const std::string raw = ref_text.empty() ? strip(text) : (strip(ref_text) + " " + strip(text));
++
++        std::vector<uint32_t> cps;
++        bool in_space = false;
++        for (size_t i = 0; i < raw.size();) {
++            uint32_t cp = 0;
++            const int n = utf8_decode(raw, i, cp);
++            if (n == 0) {
++                i++;
++                continue;
++            }
++            i += n;
++            if (cp == '\r' || cp == '\n') {
++                continue;
++            }
++            if (cp == 0xFF08) { cp = '('; }
++            if (cp == 0xFF09) { cp = ')'; }
++            if (cp == ' ' || cp == '\t') {
++                if (!in_space) {
++                    cps.push_back(' ');
++                }
++                in_space = true;
++            } else {
++                cps.push_back(cp);
++                in_space = false;
++            }
++        }
++        auto is_cjk = [](uint32_t cp) { return cp >= 0x4E00 && cp <= 0x9FFF; };
++        std::string out;
++        for (size_t j = 0; j < cps.size(); j++) {
++            if (cps[j] == ' ' && ((j > 0 && is_cjk(cps[j - 1])) || (j + 1 < cps.size() && is_cjk(cps[j + 1])))) {
++                continue;
++            }
++            utf8_append(out, cps[j]);
++        }
++        return out;
++    }

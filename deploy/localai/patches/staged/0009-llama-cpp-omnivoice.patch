++// DAC residual unit: x + conv2(snake2(conv1(snake1(x)))), kernel 7 then 1
++ggml_tensor * mtmd_graph_omnivoice_spkenc::res_unit(const std::string & name, ggml_tensor * x, int dilation) const {

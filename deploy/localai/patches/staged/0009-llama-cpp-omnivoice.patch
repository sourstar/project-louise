++#include "models.h"
++
++// backbone of the OmniVoice TTS pipeline (k2-fsa/OmniVoice): the layers of Qwen3-0.6B, read in both directions
++// - the input rows are text token embeddings or sums of audio code embeddings, the caller builds them (the code
++//   embeddings and the audio heads are inside the mmproj)
++// - no KV cache: each step of the iterative decoding recomputes the whole sequence
++// - the conditional and the unconditional sequence of a step are two sequences of one batch, a sequence only sees itself
++// - it has no text output: a batch of embedding rows stops at the hidden states; a batch of tokens also gets logits
++//   from the embedding table, they are unused and only there so a sampler can still run
++
++void llama_model_omnivoice::load_arch_hparams(llama_model_loader & ml) {
++    llama_model_qwen3::load_arch_hparams(ml);
++
++    hparams.causal_attn = false;
++}
++
++std::unique_ptr<llm_graph_context> llama_model_omnivoice::build_arch_graph(const llm_graph_params & params) const {
++    return std::make_unique<graph>(params);
++}
++
++llama_model_omnivoice::graph::graph(const llm_graph_params & params) : llama_model_qwen3::graph(params, no_build{}) {
++    const int64_t n_embd_head = hparams.n_embd_head_v();
++
++    GGML_ASSERT(n_embd_head == hparams.n_embd_head_k());
++    GGML_ASSERT(n_embd_head == n_rot);
++
++    ggml_tensor * cur;
++    ggml_tensor * inpL;
++
++    inpL = build_inp_embd(model.tok_embd);
++
++    ggml_tensor * inp_pos = build_inp_pos();
++
++    auto * inp_attn = build_attn_inp_no_cache();
++
++    ggml_tensor * inp_out_ids = build_inp_out_ids();
++
++    for (int il = 0; il < n_layer; ++il) {
++        ggml_tensor * inpSA = inpL;
++
++        cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
++        cb(cur, "attn_norm", il);
++
++        // self-attention, Q and K are normalized per head before RoPE
++        {
++            auto [Qcur, Kcur, Vcur] = build_qkv(model.layers[il], cur,
++                    n_embd_head, n_head, n_head_kv, il);
++
++            Qcur = build_norm(Qcur, model.layers[il].attn_q_norm, NULL, LLM_NORM_RMS, il);
++            Qcur = build_rope(Qcur, inp_pos, il);
++
++            Kcur = build_norm(Kcur, model.layers[il].attn_k_norm, NULL, LLM_NORM_RMS, il);
++            Kcur = build_rope(Kcur, inp_pos, il);
++
++            cb(Qcur, "Qcur", il);
++            cb(Kcur, "Kcur", il);
++            cb(Vcur, "Vcur", il);
++
++            cur = build_attn(inp_attn,
++                    model.layers[il].wo, model.layers[il].wo_b, model.layers[il].wo_s,
++                    Qcur, Kcur, Vcur, nullptr, nullptr, nullptr, 1.0f / sqrtf(float(n_embd_head)), il);
++        }
++        if (il == n_layer - 1 && inp_out_ids) {
++            cur   = ggml_get_rows(ctx0, cur,   inp_out_ids);
++            inpSA = ggml_get_rows(ctx0, inpSA, inp_out_ids);
++        }
++        ggml_tensor * ffn_inp = ggml_add(ctx0, cur, inpSA);
++        cb(ffn_inp, "ffn_inp", il);
++
++        cur = build_norm(ffn_inp, model.layers[il].ffn_norm, NULL, LLM_NORM_RMS, il);
++        cb(cur, "ffn_norm", il);
++
++        cur = build_ffn(cur,
++                model.layers[il].ffn_up,   NULL, model.layers[il].ffn_up_s,
++                model.layers[il].ffn_gate, NULL, model.layers[il].ffn_gate_s,
++                model.layers[il].ffn_down, NULL, model.layers[il].ffn_down_s,
++                NULL,
++                LLM_FFN_SILU, LLM_FFN_PAR, il);
++        cb(cur, "ffn_out", il);
++
++        cur = ggml_add(ctx0, cur, ffn_inp);
++        cb(cur, "l_out", il);
++
++        inpL = cur;
++    }
++    cur = inpL;
++
++    cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
++
++    cb(cur, "result_norm", -1);
++    res->t_embd = cur;
++
++    // the vocabulary is 150k entries wide: its head would cost a third of a decoding step, for logits nobody reads
++    if (ubatch.token != nullptr) {
++        cur = build_lora_mm(model.output, cur, model.output_s);
++
++        cb(cur, "result_output", -1);
++        res->t_logits = cur;
++    }
++}

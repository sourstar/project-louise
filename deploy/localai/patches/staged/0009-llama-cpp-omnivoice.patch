++// peak_normalize_half: rescale so peak amplitude becomes 0.5 (-6 dBFS).
++// Mirrors the no-ref branch of _post_process_audio in omnivoice.py.
++static void peak_normalize_half(std::vector<float> & a) {
++    if (a.empty()) {
++        return;
++    }
++
++    float peak = 0.0f;
++    for (float s : a) {
++        float v = std::fabs(s);
++        if (v > peak) {
++            peak = v;
++        }
++    }
++
++    if (peak > 1e-6f) {
++        float k = 0.5f / peak;
++        for (float & s : a) {
++            s *= k;
++        }
++    }
++}

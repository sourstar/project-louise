@@ -276,6 +277,37 @@ var _ = Describe("Parking", func() {
 			Expect(backend.parks).To(Equal(1))
 		})
 
+		It("says what it read when it refuses for the floor, and decides on that very reading", func() {
+			// the default source: one reading, the same one the answer and the log name
+			ml.SetHostAvailableMemorySource(nil)
+			was := readHostMemory
+			defer func() { readHostMemory = was }()
+			reads := 0
+			readHostMemory = func() xsysinfo.MemoryReading {
+				reads++
+				return xsysinfo.MemoryReading{HostAvailable: 40 * gib,

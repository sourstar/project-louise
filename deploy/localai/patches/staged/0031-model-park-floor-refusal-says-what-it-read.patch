diff --git a/pkg/xsysinfo/memory_headroom.go b/pkg/xsysinfo/memory_headroom.go
index 9147526..9e86055 100644
--- a/pkg/xsysinfo/memory_headroom.go
+++ b/pkg/xsysinfo/memory_headroom.go
@@ -1,6 +1,7 @@
 package xsysinfo
 
 import (
+	"fmt"
 	"strconv"
 	"strings"
 
@@ -14,6 +15,8 @@ var (
 	cgroupV2StatPath    = "/sys/fs/cgroup/memory.stat"
 	cgroupV1UsagePath   = "/sys/fs/cgroup/memory/memory.usage_in_bytes"
 	cgroupV1StatPath    = "/sys/fs/cgroup/memory/memory.stat"
+	// the ZFS ARC, where the host has one: read for what it says, never decided on
+	zfsArcstatsPath = "/proc/spl/kstat/zfs/arcstats"
 )
 
 // AllocatableMemory is how many bytes this process, or a child of it, can
@@ -27,24 +30,121 @@ var (
 // trusts that figure can take the container over its limit, and it is the
 // process holding the weights that the kernel then kills.
 func AllocatableMemory() uint64 {
-	return chooseAllocatableMemory(
-		memory.AvailableMemory(),
+	return ReadMemory().Allocatable()
+}
+
+// MemoryReading is everything AllocatableMemory is decided on, read at one
+// moment, and the ZFS ARC beside it: a caller that refuses something for
+// want of memory can say what it saw, not only the result.
+type MemoryReading struct {
+	// HostAvailable is the host's MemAvailable.
+	HostAvailable uint64
+	// V2 and V1: the memory cgroup this process runs in, where it has a limit.
+	V2, V1 CgroupRoom
+	// ARCSize and ARCMin: the ZFS ARC's size and the floor it is not shrunk
+	// under (c_min), where the host has an ARC (ARC false otherwise). Linux's
+	// MemAvailable does not count the ARC, though the ARC gives memory back
+	// under pressure: it is said here, and not decided on.
+	ARC             bool
+	ARCSize, ARCMin uint64
+}
+
+// CgroupRoom is one memory cgroup's limit, its working set (its usage less
+// the inactive file cache) and what the limit still allows. Limited is false
+// where there is no limit or the usage cannot be read.
+type CgroupRoom struct {
+	Limited                     bool
+	Limit, WorkingSet, Headroom uint64
+}
+
+// ReadMemory reads the host's and this process's cgroup's memory once.
+func ReadMemory() MemoryReading {
+	return readingFrom(memory.AvailableMemory(),
 		readFileBestEffort(cgroupV2MaxPath), readFileBestEffort(cgroupV2CurrentPath), readFileBestEffort(cgroupV2StatPath),
 		readFileBestEffort(cgroupV1LimitPath), readFileBestEffort(cgroupV1UsagePath), readFileBestEffort(cgroupV1StatPath),
-	)
+		readFileBestEffort(zfsArcstatsPath))
+}
+
+// Allocatable is the minimum of the host's available memory and each
+// cgroup's headroom, where a cgroup has a limit.
+func (r MemoryReading) Allocatable() uint64 {
+	best := r.HostAvailable
+	for _, c := range []CgroupRoom{r.V2, r.V1} {
+		if c.Limited && c.Headroom < best {
+			best = c.Headroom
+		}
+	}
+	return best
+}
+
+// String says the reading in MiB, for a log line or an answer.
+func (r MemoryReading) String() string {
+	mib := func(v uint64) uint64 { return v >> 20 }
+	s := fmt.Sprintf("MemAvailable %d MiB", mib(r.HostAvailable))
+	for _, c := range []struct {
+		name string
+		room CgroupRoom
+	}{{"cgroup v2", r.V2}, {"cgroup v1", r.V1}} {
+		if c.room.Limited {
+			s += fmt.Sprintf("; %s: limit %d MiB, working set %d MiB, room %d MiB", c.name, mib(c.room.Limit),
+				mib(c.room.WorkingSet), mib(c.room.Headroom))
+		}
+	}
+	if r.ARC {
+		s += fmt.Sprintf("; ZFS ARC %d MiB, its floor %d MiB (not counted in MemAvailable)", mib(r.ARCSize), mib(r.ARCMin))
+	} else {
+		s += "; no ZFS ARC"
+	}
+	return s
 }
 
 // chooseAllocatableMemory is the minimum of the host's available memory and
 // each cgroup's headroom, where a cgroup has a limit.
 func chooseAllocatableMemory(hostAvailable uint64, v2Max, v2Current, v2Stat, v1Limit, v1Usage, v1Stat string) uint64 {
-	best := hostAvailable
-	if room, limited := cgroupHeadroom(parseCgroupV2Max(v2Max), v2Current, v2Stat, "inactive_file"); limited && room < best {
-		best = room
+	return readingFrom(hostAvailable, v2Max, v2Current, v2Stat, v1Limit, v1Usage, v1Stat, "").Allocatable()
+}
+
+func readingFrom(hostAvailable uint64, v2Max, v2Current, v2Stat, v1Limit, v1Usage, v1Stat, arcstats string) MemoryReading {
+	r := MemoryReading{HostAvailable: hostAvailable,
+		V2: cgroupRoom(parseCgroupV2Max(v2Max), v2Current, v2Stat, "inactive_file"),
+		V1: cgroupRoom(parseCgroupV1Limit(v1Limit), v1Usage, v1Stat, "total_inactive_file")}
+	r.ARCSize, r.ARCMin, r.ARC = parseArcstats(arcstats)
+	return r
+}
+
+func cgroupRoom(limit uint64, usageRaw, statRaw, inactiveFileKey string) CgroupRoom {
+	room, limited := cgroupHeadroom(limit, usageRaw, statRaw, inactiveFileKey)
+	if !limited {
+		return CgroupRoom{}
 	}
-	if room, limited := cgroupHeadroom(parseCgroupV1Limit(v1Limit), v1Usage, v1Stat, "total_inactive_file"); limited && room < best {
-		best = room
+	working := uint64(0)
+	if limit > room {
+		working = limit - room
 	}
-	return best
+	return CgroupRoom{Limited: true, Limit: limit, WorkingSet: working, Headroom: room}
+}
+
+// parseArcstats reads the ARC's "size" and "c_min" rows of
+// /proc/spl/kstat/zfs/arcstats ("name type data"); ok false where the file
+// is absent or holds no size.
+func parseArcstats(raw string) (size, min uint64, ok bool) {
+	for line := range strings.SplitSeq(raw, "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 3 {
+			continue
+		}
+		v, err := strconv.ParseUint(fields[2], 10, 64)
+		if err != nil {
+			continue
+		}
+		switch fields[0] {
+		case "size":
+			size, ok = v, true
+		case "c_min":
+			min = v
+		}
+	}
+	return size, min, ok
 }
 
 // cgroupHeadroom is what a memory cgroup with a limit still allows: the
diff --git a/pkg/xsysinfo/memory_headroom_test.go b/pkg/xsysinfo/memory_headroom_test.go
index db0b6ed..6ed166c 100644
--- a/pkg/xsysinfo/memory_headroom_test.go
+++ b/pkg/xsysinfo/memory_headroom_test.go
@@ -38,3 +38,32 @@ var _ = Describe("chooseAllocatableMemory", func() {
 		Expect(chooseAllocatableMemory(40*gi, itoa(24*gi)+"\n", "", "", "", "", "")).To(Equal(40 * gi))
 	})
 })
+
+var _ = Describe("MemoryReading", func() {
+	const gi = uint64(1) << 30
+
+	It("keeps what the room was decided on: the host, each cgroup's limit, working set and room", func() {
+		r := readingFrom(40*gi, itoa(24*gi)+"\n", itoa(20*gi)+"\n", "inactive_file "+itoa(6*gi)+"\n", "", "", "", "")
+		Expect(r.Allocatable()).To(Equal(10 * gi))
+		Expect(r.V2).To(Equal(CgroupRoom{Limited: true, Limit: 24 * gi, WorkingSet: 14 * gi, Headroom: 10 * gi}))
+		Expect(r.V1.Limited).To(BeFalse())
+		Expect(r.String()).To(Equal("MemAvailable 40960 MiB; cgroup v2: limit 24576 MiB, working set 14336 MiB, room 10240 MiB; no ZFS ARC"))
+	})
+
+	It("reads the ZFS ARC where the host has one, and decides nothing on it", func() {
+		arc := "13 1 0x01 123 33536 1234 5678\nname                            type data\nhits                            4    9\n" +
+			"c_min                           4    " + itoa(gi) + "\nsize                            4    " + itoa(14*gi) + "\n"
+		r := readingFrom(2*gi, "", "", "", "", "", "", arc)
+		Expect(r.ARC).To(BeTrue())
+		Expect(r.ARCSize).To(Equal(14 * gi))
+		Expect(r.ARCMin).To(Equal(gi))
+		Expect(r.Allocatable()).To(Equal(2*gi), "the ARC is said, not counted")
+		Expect(r.String()).To(Equal("MemAvailable 2048 MiB; ZFS ARC 14336 MiB, its floor 1024 MiB (not counted in MemAvailable)"))
+		Expect(readingFrom(2*gi, "", "", "", "", "", "", "garbage\n").ARC).To(BeFalse())
+	})
+
+	It("is the same figure as chooseAllocatableMemory, the one function both read through", func() {
+		Expect(readingFrom(40*gi, "", "", "", itoa(24*gi)+"\n", itoa(20*gi)+"\n", "total_inactive_file 0\n", "").Allocatable()).
+			To(Equal(chooseAllocatableMemory(40*gi, "", "", "", itoa(24*gi)+"\n", itoa(20*gi)+"\n", "total_inactive_file 0\n")))
+	})
+})

+	// and what this one would, against the floor. Read ONCE, and the reading
+	// kept: a refusal says what it was decided on (MemAvailable, the cgroup's
+	// room, the ZFS ARC beside them), in its answer and in the log.
+	var free uint64
+	saw := "the host's memory as a source set for this process reads it"
 	if available == nil {
-		available = hostAvailableMemory
-	}
-	free, err := available()
-	if err != nil {

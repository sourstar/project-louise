+		free, saw = reading.Allocatable(), reading.String()
+	} else {
+		var err error
+		if free, err = available(); err != nil {
+			return ParkedState{}, fmt.Errorf("%w: the host's memory could not be read (%v)", ErrParkHostFloor, err)
+		}
 	}
 	ml.mu.Lock()
 	reserved := ml.parkReserved
@@ -290,8 +295,11 @@ func (ml *ModelLoader) park(ctx context.Context, modelName, address string) (Par
 	}
 	ml.mu.Unlock()
 	if !fits {
-		return ParkedState{}, fmt.Errorf("%w: %d MiB available, %d MiB being parked by others, %d MiB to park, a floor of %d MiB",
-			ErrParkHostFloor, free>>20, reserved>>20, size>>20, floor>>20)
+		xlog.Warn("A park was refused: it would leave the host under its memory floor", "model", modelName,
+			"available_mib", free>>20, "parking_by_others_mib", reserved>>20, "to_park_mib", size>>20,
+			"floor_mib", floor>>20, "read", saw)
+		return ParkedState{}, fmt.Errorf("%w: %d MiB available, %d MiB being parked by others, %d MiB to park, a floor of %d MiB (%s)",
+			ErrParkHostFloor, free>>20, reserved>>20, size>>20, floor>>20, saw)
 	}
 	defer func() {
 		ml.mu.Lock()

+// park_reply.h names its codes apart from gRPC's
+static grpc::StatusCode grpc_code_of(llama_grpc::ParkCode code) {
+    switch (code) {
+        case llama_grpc::ParkCode::Ok:                 return grpc::StatusCode::OK;
+        case llama_grpc::ParkCode::Unimplemented:      return grpc::StatusCode::UNIMPLEMENTED;
+        case llama_grpc::ParkCode::FailedPrecondition: return grpc::StatusCode::FAILED_PRECONDITION;
+        case llama_grpc::ParkCode::ResourceExhausted:  return grpc::StatusCode::RESOURCE_EXHAUSTED;
+        case llama_grpc::ParkCode::Internal:           break;
+    }
+    return grpc::StatusCode::INTERNAL;
+}
+
+// The NAMES of the top-level fields in which two messages differ, never their
+// values: load options can carry credentials, and this goes into an error
+// message and a log.
+class FieldNameReporter : public google::protobuf::util::MessageDifferencer::Reporter {
+public:
+    using SpecificField = google::protobuf::util::MessageDifferencer::SpecificField;
+    std::set<std::string> names;
+
+    void ReportAdded(const google::protobuf::Message &, const google::protobuf::Message &,
+                     const std::vector<SpecificField> & path) override { note(path); }
+    void ReportDeleted(const google::protobuf::Message &, const google::protobuf::Message &,
+                       const std::vector<SpecificField> & path) override { note(path); }
+    void ReportModified(const google::protobuf::Message &, const google::protobuf::Message &,
+                        const std::vector<SpecificField> & path) override { note(path); }
+
+private:
+    void note(const std::vector<SpecificField> & path) {
+        if (!path.empty() && path.front().field != nullptr) {
+            names.insert(std::string(path.front().field->name()));
+        } else {
+            names.insert("(a field this backend does not know)");
+        }
+    }
+};
+
+// "" if the two messages are the same; else the names of the fields that are not
+static std::string fields_that_differ(const google::protobuf::Message & a, const google::protobuf::Message & b) {
+    google::protobuf::util::MessageDifferencer differencer;
+    FieldNameReporter reporter;
+    differencer.ReportDifferencesTo(&reporter);
+    if (differencer.Compare(a, b)) {
+        return "";
+    }
+    return llama_grpc::join_names(reporter.names);
+}
+
+// The memory of this process, as LocalAI samples a backend that has no Status
+// of its own: its virtual size and its resident set. false where it cannot be
+// read (not Linux).
+static bool process_memory(uint64_t & virtual_bytes, uint64_t & resident_bytes) {
+#if defined(__linux__)
+    std::ifstream statm("/proc/self/statm");
+    uint64_t size_pages = 0, resident_pages = 0;
+    if (!(statm >> size_pages >> resident_pages)) {
+        return false;
+    }
+    const uint64_t page = (uint64_t) sysconf(_SC_PAGESIZE);
+    virtual_bytes  = size_pages * page;
+    resident_bytes = resident_pages * page;
+    return true;
+#else
+    (void) virtual_bytes;
+    (void) resident_bytes;
+    return false;
+#endif
+}
+
+static std::string error_type_of(const json & error) {
+    return error.is_object() ? error.value("type", std::string()) : std::string();
+}
+
+// The status of a request llama.cpp's server answered with an error. One
+// error is told apart: the device had no memory at that moment - for parked
+// weights to come back, for a context, for a graph. That is RESOURCE_EXHAUSTED,
+// a request to send again, where it was INTERNAL like a fault. Every other
+// error is INTERNAL, as before.
+//
+// RESOURCE_EXHAUSTED has other meanings on this wire - a stream that is busy,
+// a message over the size limit - so the refusal also says its type at the
+// head of its message, "no_room_on_device: ...", where a caller that maps
+// statuses can tell it from them (park_reply.h).
+static grpc::Status grpc_status_of_request_error(const json & error, const std::string & message) {
+    const llama_grpc::ParkCode code = llama_grpc::code_of_request_error(error_type_of(error));
+    if (code == llama_grpc::ParkCode::ResourceExhausted) {
+        return grpc::Status(grpc_code_of(code), llama_grpc::no_room_message(message));
+    }
+    return grpc::Status(grpc_code_of(code), message);
+}
 
 

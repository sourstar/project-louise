diff --git a/backend/cpp/llama-cpp/park_reply.h b/backend/cpp/llama-cpp/park_reply.h
new file mode 100644
index 0000000..99fb6b6
--- /dev/null
+++ b/backend/cpp/llama-cpp/park_reply.h
@@ -0,0 +1,94 @@
+// Parking: the words and the status codes the backend answers with.
+//
+// A model whose weights can leave the device (llama.cpp's llama_model_park)
+// is parked by the Free RPC and brought back by a LoadModel for the model the
+// process already holds - LocalAI's own two calls, no new one. This header
+// holds what a CALLER reads of that, apart from grpc-server.cpp so that it is
+// tested without a model: the messages, whose bytes are an interface, and
+// which gRPC code each outcome is.
+//
+// Standard library only.
+#pragma once
+
+#include <set>
+#include <string>
+
+namespace llama_grpc {
+
+// LoadModel for the model already held, parked or not, once it is on the
+// device. A proxy in front of a backend tells a RETURN from a LOAD by this
+// message: do not reword it.
+inline constexpr const char * LOAD_ALREADY_LOADED = "Model already loaded";
+
+// Free that parked the model (or found it parked).
+inline constexpr const char * FREE_PARKED = "parked";
+
+// The "type" llama.cpp's server gives the refusal of the moment: the device
+// had no memory - for parked weights to come back, for a context, or for a
+// graph. Nothing is wrong with the request or the model.
+inline constexpr const char * ERROR_TYPE_NO_ROOM = "no_room_on_device";
+
+// The codes used here, named apart from gRPC's so that this header needs no
+// gRPC. grpc-server.cpp maps them one to one.
+enum class ParkCode {
+    Ok,
+    Unimplemented,       // the model cannot park: the caller does what it did before (it stops the process)
+    FailedPrecondition,  // not now: a request is running. The model stays on the device
+    ResourceExhausted,   // the device has no room now: try again later. LocalAI's code for "backend is busy";
+                         // never Unavailable, which LocalAI reads as a backend it can no longer reach
+    Internal,
+};
+
+// A request's error, by the "type" of llama.cpp's error object. Only the
+// refusal of the moment is told apart; every other error is Internal, as
+// before.
+inline ParkCode code_of_request_error(const std::string & type) {
+    return type == ERROR_TYPE_NO_ROOM ? ParkCode::ResourceExhausted : ParkCode::Internal;
+}
+
+// Free: the answer of the park task when it is an error.
+//   not_supported_error  the model cannot park          -> Unimplemented, as a backend with no Free
+//   unavailable_error    a request is running            -> FailedPrecondition
+//   anything else        the weights stayed on the device (no host memory for them) -> Internal
+inline ParkCode code_of_free_error(const std::string & type) {
+    if (type == "not_supported_error") {
+        return ParkCode::Unimplemented;
+    }
+    if (type == "unavailable_error") {
+        return ParkCode::FailedPrecondition;
+    }
+    return ParkCode::Internal;
+}
+
+// RESOURCE_EXHAUSTED has other meanings on this wire: a stream that is busy,
+// a message over the size limit, a rate-limited upstream. So the refusal of
+// the moment says its type at the HEAD OF ITS MESSAGE as well, where a caller
+// that maps statuses - LocalAI's HTTP layer, a client's deferral - can tell it
+// from them without a list of messages:
+//   "no_room_on_device: the weights cannot come back to the device now"
+inline std::string no_room_message(const std::string & message) {
+    return std::string(ERROR_TYPE_NO_ROOM) + ": " + message;
+}
+
+inline bool is_no_room_message(const std::string & message) {
+    const std::string head = std::string(ERROR_TYPE_NO_ROOM) + ": ";
+    return message.compare(0, head.size(), head) == 0;
+}
+
+// LoadModel for the model the process holds, under OTHER options than the
+// ones it was loaded with. It names the fields that differ and never their
+// values: load options can carry credentials.
+inline std::string join_names(const std::set<std::string> & names) {
+    std::string out;
+    for (const std::string & name : names) {
+        out += (out.empty() ? "" : ", ") + name;
+    }
+    return out;
+}
+
+inline std::string other_options_message(const std::string & model, const std::string & fields) {
+    return "llama-cpp: this process holds model \"" + model + "\" under other options than these (they differ in: " +
+           fields + "); it did not load again - restart the backend process to load the model with them";
+}
+
+} // namespace llama_grpc
diff --git a/backend/cpp/llama-cpp/park_reply_test.cpp b/backend/cpp/llama-cpp/park_reply_test.cpp
new file mode 100644
index 0000000..8f37b0d
--- /dev/null
+++ b/backend/cpp/llama-cpp/park_reply_test.cpp
@@ -0,0 +1,76 @@
+// Unit test for the words and codes of parking (park_reply.h).
+//
+// Build & run standalone (standard library only):
+//   g++ -std=c++17 park_reply_test.cpp -o t && ./t
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "park_reply.h"
+
+using llama_grpc::ParkCode;
+
+static int failures = 0;
+
+static void check(bool ok, const std::string & name) {
+    if (!ok) {
+        failures++;
+        fprintf(stderr, "FAIL: %s\n", name.c_str());
+    } else {
+        fprintf(stderr, "ok:   %s\n", name.c_str());
+    }
+}
+
+int main() {
+    // The bytes are an interface: a proxy in front of the backend (a wrapper
+    // that states a run at each LOAD) tells a return from a load by them.
+    static const unsigned char already[] = { 'M','o','d','e','l',' ','a','l','r','e','a','d','y',' ','l','o','a','d','e','d' };
+    check(std::strlen(llama_grpc::LOAD_ALREADY_LOADED) == sizeof(already) &&
+          std::memcmp(llama_grpc::LOAD_ALREADY_LOADED, already, sizeof(already)) == 0,
+          "LoadModel for the model already held answers \"Model already loaded\", byte for byte");
+    check(std::string(llama_grpc::FREE_PARKED) == "parked", "Free that parked answers \"parked\"");
+    check(std::string(llama_grpc::ERROR_TYPE_NO_ROOM) == "no_room_on_device", "the refusal's type is llama.cpp's");
+
+    // a request: only the refusal of the moment is told apart
+    check(llama_grpc::code_of_request_error("no_room_on_device") == ParkCode::ResourceExhausted,
+          "a request with no room on the device: ResourceExhausted");
+    for (const char * type : { "server_error", "unavailable_error", "invalid_request_error", "not_supported_error", "" }) {
+        check(llama_grpc::code_of_request_error(type) == ParkCode::Internal,
+              std::string("a request's other errors stay Internal: \"") + type + "\"");
+    }
+    check(llama_grpc::code_of_request_error("no_room_on_device") != ParkCode::Unimplemented,
+          "never Unavailable or Unimplemented for a refusal of the moment");
+
+    // Free
+    check(llama_grpc::code_of_free_error("not_supported_error") == ParkCode::Unimplemented,
+          "Free on a model that cannot park: Unimplemented, as a backend with no Free");
+    check(llama_grpc::code_of_free_error("unavailable_error") == ParkCode::FailedPrecondition,
+          "Free while a request runs: FailedPrecondition, not Unimplemented - it is for now, not for good");
+    check(llama_grpc::code_of_free_error("server_error") == ParkCode::Internal,
+          "Free that could not park (no host memory): Internal");
+    check(llama_grpc::code_of_free_error("") == ParkCode::Internal, "Free with an error of no type: Internal");
+
+    // the refusal's message says its type at its head: RESOURCE_EXHAUSTED alone has other meanings on this wire
+    check(llama_grpc::no_room_message("the weights cannot come back to the device now") ==
+          "no_room_on_device: the weights cannot come back to the device now",
+          "the refusal's message: \"no_room_on_device: <what happened>\"");
+    check(llama_grpc::is_no_room_message(llama_grpc::no_room_message("Compute error.")), "and it is told by that head");
+    check(!llama_grpc::is_no_room_message("backend is busy") && !llama_grpc::is_no_room_message("") &&
+          !llama_grpc::is_no_room_message("it said no_room_on_device: somewhere inside"),
+          "a busy stream, an empty message, the words elsewhere in a message: not the refusal");
+
+    // the same name under other options: the fields are named, in a fixed order, and nothing else of them
+    check(llama_grpc::join_names({ "Options", "ContextSize", "NGPULayers" }) == "ContextSize, NGPULayers, Options",
+          "the fields that differ are named in a fixed order");
+    check(llama_grpc::join_names({}).empty(), "no field differs: nothing is named");
+    const std::string other = llama_grpc::other_options_message("bge-m3", "ContextSize, Options");
+    check(other.find("\"bge-m3\"") != std::string::npos && other.find("ContextSize, Options") != std::string::npos &&
+          other.find("did not load again") != std::string::npos,
+          "a repeat under other options is told which model, which fields, and that nothing was loaded");
+    check(other != llama_grpc::LOAD_ALREADY_LOADED && other.find(llama_grpc::LOAD_ALREADY_LOADED) == std::string::npos,
+          "and it never contains the message that says loaded");
+
+    fprintf(stderr, failures == 0 ? "all passed\n" : "%d FAILED\n", failures);
+    return failures == 0 ? 0 : 1;
+}
diff --git a/backend/cpp/llama-cpp/patches/0023-server-park-when-told.patch b/backend/cpp/llama-cpp/patches/0023-server-park-when-told.patch
new file mode 100644
index 0000000..00348bd
--- /dev/null
+++ b/backend/cpp/llama-cpp/patches/0023-server-park-when-told.patch
@@ -0,0 +1,1334 @@
+server: a model parks when it is told to, and one answer for "the device has no room now"
+
+0015 let a model's weights leave the device and come back (llama_model_park),
+and parked them each time the context was freed - a switch to measure with.
+This makes parking an ORDER, gives the refusals of a full device one name,
+and keeps a refusal apart from a failure all the way down.
+
+Parking when told. With --context-on-demand and weight buffers that can park:
+- SERVER_TASK_TYPE_PARK, run by the server's own thread between two requests.
+  Told to park: the context is freed, whatever keep its last request asked
+  for - who tells is who manages the device's memory - and the weights leave.
+  Told to come back: they return; the next request creates its context as
+  ever. While a request runs the model is not parked ("busy"). Never a half
+  state: llama_model_park / unpark leave the model as it was when they do
+  not succeed.
+- a request to a parked model brings the weights back by itself (0015).
+- A REQUEST NEVER PARKS. 0015 parked again when the request that brought
+  the weights back was then refused its context: a second copy of the
+  weights for every refused request, by a park whose own failure was not
+  read. Once back they stay on the device; where they are is said
+  (llamacpp:weights_parked), and who manages the device parks again. The
+  counts are of weights that left and came back, not of attempts.
+- POST /park, POST /unpark on llama-server; llama_model_park_size(); the
+  server's meta says can_park; /metrics says weights_parked,
+  weights_park_bytes and the two counts.
+- LLAMA_SERVER_PARK_WEIGHTS stays what it was, a measuring switch.
+
+A refusal is not a failure. park and unpark returned a bool, and a caller
+took every false for a device with no room: an unpark whose bytes, read
+back from the device, were NOT the ones parked (GGML_SYCL_PARK_VERIFY), and
+any exception of the device while it committed, were answered "try again
+later" - for ever, and under the verify switch a corruption would have read
+as a refusal. They now say why (enum ggml_backend_park_status):
+- NO_MEMORY: the device could not allocate - the extension's own word for
+  it, an exception with errc::memory_allocation (sycl_ext_oneapi_virtual_mem:
+  "If the constructor is unable to allocate the required memory ... throws
+  an exception with errc::memory_allocation") - or the host could not, for a
+  park. Nothing changed; a later call may succeed.
+- FAILED: anything else. The model stays parked, its weights intact on the
+  host, and the request is answered as a fault (500 server_error), never as
+  a device that is full.
+The pool's refused commit (0014, 0018) is held to the same test: only
+errc::memory_allocation fails the graph and lets the process go on; any
+other exception of the device leaves as every other one leaves this backend.
+
+One answer for no room. ERROR_TYPE_NO_ROOM_ON_DEVICE, HTTP 503, type
+"no_room_on_device", counted in llamacpp:no_room_refusals_total:
+- parked weights the device has no room for (was 503 unavailable_error,
+  under the message of a context);
+- a context that cannot be created (was 503 unavailable_error). It was
+  created with these very parameters at the load, so what fails later is
+  the device's or the host's memory at that moment;
+- a graph the backend could not allocate memory for. llama_process returned
+  -2 for it - and -2 for four other things that no later call mends: the
+  host's output buffer (encode and decode), the memory module failing to
+  begin a batch, its unexpected status, its own compute failure. It now
+  returns LLAMA_PROCESS_NO_MEMORY (-4) for GGML_STATUS_ALLOC_FAILED alone,
+  and only that is a refusal (was 500 server_error "Compute error.", like a
+  fault; the other four stay 500);
+- and the same refusal when the graph is the CANARY of a context being
+  created: it was answered "context canary failed" and counted in
+  context_canary_failures_total, as if the context had computed something
+  wrong. The canary now says COMMON_CANARY_NO_MEMORY: at a request it is a
+  context that cannot be created, counted nowhere as a canary that failed;
+  at the load it fails the load, where it left the model served unchecked
+  for the life of the process ("the context canary cannot be computed for
+  this model").
+Nothing is wrong with the request or the model in any of them. What the
+server CANNOT tell is a device full at that moment from a request that will
+never fit: it does not see the device's other tenants. It counts, and who
+sends the request again bounds its own retries.
+
+For the test of a refused return, which a card cannot be made to give on
+demand: GGML_SYCL_PARK_REFUSE=N refuses the next N commits that bring a
+parked buffer back, at the buffer's last piece, raised as the device raises
+its own (errc::memory_allocation) - so what was committed before it is
+released as after a real one.
+
+Checked without a device. tools/server/tests: 25 passed. On a CPU stand-in
+for a device that parks, refuses, fails and loses bytes (a dev patch, in no
+engine), through /park and /unpark: 56 of 56 - the first vectors bit for
+bit after each of 10 parks told; a kept context freed by the order; a
+refused return 503 with the model still parked; a FAILED return 500, still
+parked, not counted as a refusal; weights that came back for a request
+whose context is then refused STAY, with one park and one copy in all; a
+park that fails leaves the weights on the device; 501 for a model that
+cannot; orders to park beside live requests, each done or refused busy,
+every request's vectors intact. 19 of 19 graph refusals: every one 503
+no_room_on_device, counted, none taken for a canary that failed.
+ggml-sycl.cpp compiles with icpx. NOT run: any of it on a device - and no
+device has yet been SEEN to refuse a commit, so that its exception carries
+errc::memory_allocation is the extension's specification and the runtime's
+source, not an observation: one that carried another code would be
+answered as a failure, loudly, and logged with its code.
+---

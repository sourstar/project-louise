+#if LOCALAI_HAS_PARK
+    // Post the park task (true: the weights leave the device; false: they
+    // come back) and wait for its answer. Only the server's own thread parks
+    // and unparks, between two requests.
+    server_task_result_ptr runPark(bool park) {
+        auto rd = ctx_server.get_response_reader();
+        const int task_id = rd.queue_tasks.get_new_id();
+        {
+            server_task task(SERVER_TASK_TYPE_PARK);
+            task.id   = task_id;
+            task.park = park;
+            rd.queue_results.add_waiting_task_id(task_id);
+            rd.queue_tasks.post(std::move(task));
+        }
+        server_task_result_ptr result = rd.queue_results.recv(task_id);
+        rd.queue_results.remove_waiting_task_id(task_id);
+        return result;
+    }
+
+    // Free PARKS a model that can park: its context is freed, its weights
+    // leave the device and stay in host memory, the process and everything
+    // it validated stay. A LoadModel for the same model, or the next request,
+    // brings them back. A model that cannot park answers Unimplemented, as
+    // this backend always did: the caller stops the process, which frees the
+    // device. Never a half state: weights that cannot leave stay.
+    grpc::Status Free(ServerContext* context, const backend::HealthMessage* /*request*/, backend::Result* result) override {
+        auto auth = checkAuth(context);
+        if (!auth.ok()) return auth;
+
+        if (!loaded_model) {
+            // While the first load runs the answer is "not now", not "never":
+            // Unimplemented tells the caller this backend cannot park at all.
+            std::unique_lock<std::mutex> load_lock(load_model_mutex, std::try_to_lock);
+            if (!load_lock.owns_lock()) {
+                return grpc::Status(grpc::StatusCode::FAILED_PRECONDITION, "busy: the model is loading");
+            }
+            return grpc::Status(grpc::StatusCode::UNIMPLEMENTED, "llama-cpp: no model is loaded, nothing to free");
+        }
+        if (!ctx_server.get_meta().can_park) {
+            return grpc::Status(grpc::StatusCode::UNIMPLEMENTED, "llama-cpp: this model cannot park, stop the process to free the device");
+        }
+
+        server_task_result_ptr parked = runPark(true);
+        if (parked->is_error()) {
+            const json error = parked->to_json();
+            const std::string error_msg = error.value("message", "the weights could not be parked");
+            result->set_message(error_msg);
+            result->set_success(false);
+            return grpc::Status(grpc_code_of(llama_grpc::code_of_free_error(error_type_of(error))), error_msg);
+        }
+
+        result->set_message(llama_grpc::FREE_PARKED);
+        result->set_success(true);
+        result->set_metadata(parked->to_json().dump()); // {"parked":true,"park_size":<bytes>,"ms":<this call>}
+        return Status::OK;
+    }
+
+    // Status of a model that can park: where its weights are. memory.total
+    // stays what a caller reads there for a backend with no Status - the
+    // process's virtual size, as LocalAI's own sample of it, with "rss" in
+    // the breakdown - and the breakdown adds: "parked" (0 or 1), "park_size"
+    // (the bytes that park, which the device must have room for when they
+    // come back), "parked_host" (those bytes while they are in host memory,
+    // else 0), how many times they left and came back, and "no_room", the
+    // requests answered that the device was full. A model that cannot park
+    // answers Unimplemented, as this backend always did, and the caller
+    // samples the process as before.
+    grpc::Status Status(ServerContext* context, const backend::HealthMessage* /*request*/, backend::StatusResponse* response) override {
+        auto auth = checkAuth(context);
+        if (!auth.ok()) return auth;
+
+        if (!loaded_model || !ctx_server.get_meta().can_park) {
+            return grpc::Status(grpc::StatusCode::UNIMPLEMENTED, "llama-cpp: no status for a model that cannot park");
+        }
+
+        auto rd = ctx_server.get_response_reader();
+        const int task_id = rd.queue_tasks.get_new_id();
+        {
+            server_task task(SERVER_TASK_TYPE_METRICS);
+            task.id = task_id;
+            rd.queue_results.add_waiting_task_id(task_id);
+            rd.queue_tasks.post(std::move(task), true); // answered while a request computes
+        }
+        server_task_result_ptr result = rd.queue_results.recv(task_id);
+        rd.queue_results.remove_waiting_task_id(task_id);
+
+        auto * res_metrics = dynamic_cast<server_task_result_metrics *>(result.get());
+        if (result->is_error() || res_metrics == nullptr) {
+            return grpc::Status(grpc::StatusCode::INTERNAL, "Error in receiving the status");
+        }
+
+        const server_metrics & m = res_metrics->metrics;
+        response->set_state(res_metrics->n_processing_slots > 0 ? backend::StatusResponse::BUSY : backend::StatusResponse::READY);
+        auto * memory = response->mutable_memory();
+        uint64_t virtual_bytes = 0, resident_bytes = 0;
+        if (process_memory(virtual_bytes, resident_bytes)) {
+            memory->set_total(virtual_bytes);
+            (*memory->mutable_breakdown())["rss"] = resident_bytes;
+        }
+        (*memory->mutable_breakdown())["parked"]      = m.weights_parked ? 1 : 0;
+        (*memory->mutable_breakdown())["park_size"]   = m.park_size;
+        (*memory->mutable_breakdown())["parked_host"] = m.weights_parked ? m.park_size : 0;
+        (*memory->mutable_breakdown())["parks"]       = m.n_weights_park;
+        (*memory->mutable_breakdown())["unparks"]     = m.n_weights_unpark;
+        (*memory->mutable_breakdown())["no_room"]     = m.n_no_room;
+        return Status::OK;
+    }
+#endif // LOCALAI_HAS_PARK
